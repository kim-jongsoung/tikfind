                        <a href="/overlay/<%= user._id %>/chat-gradient?color=black" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-100 transition text-sm font-semibold">
