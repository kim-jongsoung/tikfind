<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Overlay</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: transparent;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            position: relative;
        }

        /* 마퀴 바 - 오른쪽 30% 영역에 고정 */
        .marquee-bar {
            position: absolute;
            right: 0;
            top: 0;
            width: 30%;
            overflow: hidden;
            white-space: nowrap;
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.55);
            height: 36px;
            border-radius: 6px 0 0 6px;
            gap: 0;
        }

        /* 신청곡 뱃지 - 고정 영역 (마퀴 텍스트가 이 위로 지나가지 않음) */
        .song-badge {
            flex-shrink: 0;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            color: #fff;
            font-size: 0.75em;
            font-weight: 700;
            padding: 2px 8px 2px 10px;
            border-radius: 6px 0 0 6px;
            letter-spacing: 0.03em;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 4px;
            height: 100%;
            z-index: 2;
        }

        /* 마퀴 텍스트 영역 - 뱃지 오른쪽에서만 흐름 */
        .marquee-scroll-area {
            flex: 1;
            overflow: hidden;
            height: 100%;
            display: flex;
            align-items: center;
        }

        .marquee-track {
            display: inline-block;
            white-space: nowrap;
            animation: marquee-scroll 20s linear infinite;
        }

        @keyframes marquee-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .marquee-text {
            display: inline;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
            font-weight: 600;
            letter-spacing: 0.02em;
        }
    </style>
</head>
<body>
    <div class="marquee-bar" id="marqueeBar">
        <span class="song-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            신청곡
        </span>
        <div class="marquee-scroll-area">
            <div class="marquee-track" id="marqueeTrack">
                <span class="marquee-text" id="marqueeText1">신청곡을 기다리고 있습니다...</span>
                <span style="display:inline;margin:0 40px;opacity:0.3;">✦</span>
                <span class="marquee-text" id="marqueeText2">신청곡을 기다리고 있습니다...</span>
                <span style="display:inline;margin:0 40px;opacity:0.3;">✦</span>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const userId = '<%= userId %>';
        const socket = io();

        // URL 파라미터로 스타일 설정
        const params   = new URLSearchParams(location.search);
        const bgColor  = decodeURIComponent(params.get('bg')    || 'rgba(0,0,0,0.55)');
        const txtColor = params.get('color') || '#ffffff';
        const fontSize = params.get('size')  || '16';
        const speed    = parseFloat(params.get('speed') || '1.0');

        const bar   = document.getElementById('marqueeBar');
        const track = document.getElementById('marqueeTrack');

        bar.style.background  = bgColor;
        bar.style.color       = txtColor;
        bar.style.fontSize    = fontSize + 'px';
        bar.style.height      = (parseInt(fontSize) * 2.4) + 'px';

        // 마퀴 속도: 글자 수 기반 + speed 배율
        // translateX(-50%) 방식이므로 전체 길이 기준으로 계산
        function setSpeed(text) {
            const base = Math.max(12, text.length * 0.3);
            const duration = base / speed;
            track.style.animationDuration = duration + 's';
        }

        // 현재곡 / 다음곡 상태
        let currentSong = null;
        let nextQueue   = [];

        function songLabel(song) {
            if (!song) return '';
            let label = '🎵 ' + song.title;
            if (song.artist)    label += ' - ' + song.artist;
            if (song.requester) label += '  (@' + song.requester + ')';
            return label;
        }

        function buildText() {
            let parts = [];
            if (currentSong) {
                parts.push('현재곡: ' + songLabel(currentSong));
            }
            if (nextQueue.length > 0) {
                parts.push('다음곡: ' + songLabel(nextQueue[0]));
            }
            if (nextQueue.length > 1) {
                nextQueue.slice(1, 4).forEach((s, i) => {
                    parts.push('대기' + (i + 2) + ': ' + songLabel(s));
                });
            }

            // 신청 안내 문구는 항상 포함
            parts.push('팔로우 후 채팅창에 #노래제목 #가수명 으로 신청해주세요 🎵');

            const text = parts.join('　　　　');

            // 2벌 복사 → translateX(-50%) 무한 반복
            const sep = '　　　　　　';
            const full = text + sep;
            document.getElementById('marqueeText1').textContent = full;
            document.getElementById('marqueeText2').textContent = full;
            setSpeed(full);
        }

        socket.emit('join-overlay', userId);

        socket.on('current-song', (data) => {
            currentSong = (data && data.title) ? data : null;
            buildText();
        });

        socket.on('song-queue', (queue) => {
            const all = queue || [];
            // 현재 재생 중인 곡은 큐에서 제외 (currentSong과 id 또는 title로 매칭)
            if (currentSong) {
                nextQueue = all.filter(s =>
                    s.id !== currentSong.id &&
                    !(s.title === currentSong.title && s.requester === currentSong.requester)
                );
            } else {
                nextQueue = all;
            }
            buildText();
        });
    </script>
</body>
</html>
