<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>룰렛 오버레이</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@700;900&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background: transparent; overflow: hidden; width: 340px; height: 520px;
               font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif; }

        #wheel-wrap {
            position: absolute;
            left: -622px;
            top: 50%;
            transform: translateY(-50%);
            width: 622px; height: 622px;
            transition: left 0.7s cubic-bezier(0.34,1.56,0.64,1);
        }
        #wheel-wrap.spinning { left: -310px; }

        /* 외곽 링 */
        #ring {
            position: absolute;
            width: 622px; height: 622px;
            border-radius: 50%;
            background: conic-gradient(#ffd700, #ff6b6b, #a855f7, #3b82f6, #22c55e, #ffd700);
            animation: ringGlow 1.8s ease-in-out infinite alternate;
        }
        @keyframes ringGlow {
            from { box-shadow: 0 0 30px #ffd70099, 0 0 60px #ff6b6b44; }
            to   { box-shadow: 0 0 60px #ffd700cc, 0 0 100px #a855f766; }
        }

        #canvas-wrap {
            position: absolute;
            left: 8px; top: 8px;
            width: 606px; height: 606px;
            border-radius: 50%;
            overflow: hidden;
        }

        /* 포인터 - 오른쪽 */
        #pointer {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 0; height: 0;
            border-top: 18px solid transparent;
            border-bottom: 18px solid transparent;
            border-right: 48px solid #ffd700;
            filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
            z-index: 20;
        }

        /* 중앙 뱃지 */
        #center-badge {
            position: absolute;
            left: 50%; top: 50%;
            transform: translate(-50%, -50%);
            width: 76px; height: 76px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
            border: 3px solid #ffd700;
            box-shadow: 0 0 20px rgba(124,58,237,0.8), 0 4px 16px rgba(0,0,0,0.6);
            z-index: 21;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 1px;
        }
        #center-badge .cb-icon { font-size: 18px; line-height: 1; }
        #center-badge .cb-text {
            font-size: 9px; font-weight: 900; color: #ffd700;
            letter-spacing: 0.5px; text-shadow: 0 1px 3px rgba(0,0,0,0.7);
        }

        /* 타이틀 배너 */
        #title-banner {
            position: absolute;
            right: -10px; top: 50%;
            transform: translateY(-50%);
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
            border: 2px solid #ffd700;
            border-radius: 0 12px 12px 0;
            padding: 10px 14px 10px 8px;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            color: #ffd700;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: 2px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
            box-shadow: 4px 0 16px rgba(124,58,237,0.5);
            z-index: 30;
            white-space: nowrap;
        }

        /* 당첨 결과 배너 */
        #result-banner {
            position: absolute;
            right: -10px; top: calc(50% + 160px);
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 2px solid #ffd700;
            border-radius: 0 14px 14px 0;
            padding: 12px 16px 12px 10px;
            opacity: 0;
            transform: translateX(20px);
            transition: opacity 0.5s, transform 0.5s;
            box-shadow: 4px 4px 20px rgba(255,215,0,0.3);
            z-index: 30;
            min-width: 150px;
        }
        #result-banner.show { opacity: 1; transform: translateX(0); }
        #result-label { font-size: 10px; color: #ffd700; font-weight: 700; letter-spacing: 2px; margin-bottom: 3px; }
        #result-text  { font-size: 15px; font-weight: 900; color: #fff; text-shadow: 0 1px 6px rgba(255,215,0,0.4); }

        /* 파티클 */
        .spark { position: absolute; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; animation: sparkFly 1.2s ease-out forwards; }
        @keyframes sparkFly { 0%{opacity:1;transform:translate(0,0) scale(1)} 100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(0)} }
    </style>
</head>
<body>
<div id="wheel-wrap">
    <div id="ring"></div>
    <div id="canvas-wrap">
        <canvas id="roulette" width="606" height="606"></canvas>
    </div>
    <div id="pointer"></div>
    <div id="center-badge">
        <span class="cb-icon">🎯</span>
        <span class="cb-text">TikFind</span>
    </div>
    <div id="title-banner">⚔️ 매치승리 룰렛미션</div>
    <div id="result-banner">
        <div id="result-label">🎉 미션 당첨!</div>
        <div id="result-text"></div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const userId = '<%= userId %>';
const socket = io();
socket.emit('join-overlay', userId);
socket.on('connect', () => socket.emit('join-overlay', userId));

const DEFAULT_ITEMS = [
    { label: '🎤 노래 한 소절',      color: '#e74c3c' },
    { label: '💃 댄스 10초',         color: '#9b59b6' },
    { label: '😂 웃긴 표정 최고',     color: '#2980b9' },
    { label: '🎁 1위에게 선물하기',   color: '#e67e22' },
    { label: '🔥 하트 10초 연속',     color: '#c0392b' },
];

let items       = [...DEFAULT_ITEMS];
let currentAngle = 0;   // 누적 회전 각도 (라디안)
let spinning    = false;

const canvas = document.getElementById('roulette');
const ctx    = canvas.getContext('2d');
const wrap   = document.getElementById('wheel-wrap');

// ── Audio (Web Audio API 이용해 효과음 생성) ────────────────
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playSpinTick() {
    const osc  = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(600, audioCtx.currentTime);
    gain.gain.setValueAtTime(0.18, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.07);
    osc.start(); osc.stop(audioCtx.currentTime + 0.07);
}

function playWinSound() {
    // 상승 팡파르
    const notes = [523, 659, 784, 1047];
    notes.forEach((freq, i) => {
        const osc  = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'sine';
        const t = audioCtx.currentTime + i * 0.13;
        osc.frequency.setValueAtTime(freq, t);
        gain.gain.setValueAtTime(0.35, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
        osc.start(t); osc.stop(t + 0.35);
    });
}

// ── 룰렛 그리기 ────────────────────────────────────────────
function drawWheel(angle) {
    const cx = 303, cy = 303, r = 299;
    const n  = items.length;
    const slice = (2 * Math.PI) / n;
    ctx.clearRect(0, 0, 606, 606);

    items.forEach((item, i) => {
        // drawWheel의 angle은 순수 회전값 — 12시 기준(−π/2) 오프셋 적용
        const start = angle + i * slice - Math.PI / 2;
        const end   = start + slice;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, start, end);
        ctx.closePath();

        const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
        grad.addColorStop(0, lighten(item.color, 45));
        grad.addColorStop(1, item.color);
        ctx.fillStyle = grad;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.22)';
        ctx.lineWidth = 2;
        ctx.stroke();

        // 레이블 텍스트 (2줄 지원)
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(start + slice / 2);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#fff';
        ctx.shadowColor = 'rgba(0,0,0,0.8)';
        ctx.shadowBlur = 8;

        const FONT_SIZE = 34;
        const MAX_WIDTH = r - 80; // 텍스트 최대 너비
        ctx.font = `bold ${FONT_SIZE}px "Noto Sans KR", "Segoe UI", sans-serif`;

        // 긴 텍스트는 단어 단위로 2줄로 분할
        const words = item.label.split(' ');
        let line1 = '', line2 = '';
        if (words.length > 1 && ctx.measureText(item.label).width > MAX_WIDTH) {
            // 절반 위치에서 줄 나누기
            const mid = Math.ceil(words.length / 2);
            line1 = words.slice(0, mid).join(' ');
            line2 = words.slice(mid).join(' ');
        } else {
            line1 = item.label;
        }

        const lineH = FONT_SIZE * 1.15;
        if (line2) {
            ctx.fillText(line1, r - 16, -lineH / 2 + FONT_SIZE * 0.35);
            ctx.fillText(line2, r - 16,  lineH / 2 + FONT_SIZE * 0.35);
        } else {
            ctx.fillText(line1, r - 16, FONT_SIZE * 0.35);
        }
        ctx.restore();
    });

    // 중앙 원 (뱃지 아래 캔버스 레이어)
    ctx.beginPath();
    ctx.arc(cx, cy, 40, 0, 2 * Math.PI);
    ctx.fillStyle = '#1a1a2e';
    ctx.fill();
    ctx.strokeStyle = '#ffd700';
    ctx.lineWidth = 3;
    ctx.stroke();
}

function lighten(hex, amount) {
    const num = parseInt(hex.replace('#',''), 16);
    const r = Math.min(255, (num >> 16) + amount);
    const g = Math.min(255, ((num >> 8) & 0xff) + amount);
    const b = Math.min(255, (num & 0xff) + amount);
    return `rgb(${r},${g},${b})`;
}

drawWheel(0);

// ── 스핀 함수 ─────────────────────────────────────────────
// 포인터는 오른쪽(3시, 즉 0rad) 방향.
// drawWheel에서 첫 슬라이스는 (-π/2) 오프셋을 받아 12시에서 시작.
// 포인터(0rad, 즉 3시) 기준으로 winIndex 슬라이스를 가져오려면:
//   회전 후 angle의 "3시" 위치에 해당하는 슬라이스 인덱스
//   = (angle의 12시 기준으로) +π/2 지점 → 즉 포인터 지점에는 angle=π/2 오프셋을 더해야 함
//   winSlice 중심이 포인터에 오도록: angle = π/2 − (winIndex + 0.5) × slice
function easeOut(t)     { return 1 - Math.pow(1 - t, 5); }
function easeInOut(t)   { return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2; }
function easeLinear(t)  { return t; }

let tickTimer = null;

function setTickInterval(ms) {
    clearInterval(tickTimer);
    tickTimer = setInterval(() => playSpinTick(), ms);
}

function spin(targetItems, winIndex) {
    if (spinning) return;
    spinning = true;
    items = (targetItems && targetItems.length) ? targetItems : [...DEFAULT_ITEMS];

    wrap.classList.add('spinning');
    document.getElementById('result-banner').classList.remove('show');

    const n     = items.length;
    const slice = (2 * Math.PI) / n;

    // ── Phase 1: 프리뷰 (천천히 1.5바퀴 회전, 10초) ─────────────
    const PREVIEW_DURATION = 10000; // 10초
    const PREVIEW_DELTA    = 1.5 * 2 * Math.PI; // 1.5바퀴

    // ── Phase 2: 본 스핀 (빠르게 당첨 위치로, 14.4초) ────────────
    const SPIN_DURATION = 14400;
    const SPIN_EXTRA    = (15 + Math.floor(Math.random() * 4)) * 2 * Math.PI;

    const targetAngle = Math.PI / 2 - (winIndex + 0.5) * slice;

    // 효과음: 프리뷰부터 천천히 시작
    setTickInterval(300);

    // ── Phase 1 애니메이션 ─────────────────────────────────────
    const previewStartAngle = currentAngle;
    const previewStartTime  = performance.now();

    function previewFrame(now) {
        const t = Math.min((now - previewStartTime) / PREVIEW_DURATION, 1);
        const angle = previewStartAngle + PREVIEW_DELTA * easeInOut(t);
        drawWheel(angle);

        // 속도에 비례해서 틱 간격 조절 (중간이 가장 빠름)
        const speed = Math.abs(easeInOut(Math.min(t + 0.01, 1)) - easeInOut(t)) / 0.01;
        const interval = Math.max(120, Math.min(500, Math.round(180 / (speed * 50 + 0.1))));
        clearInterval(tickTimer);
        tickTimer = setInterval(() => playSpinTick(), interval);

        if (t < 1) {
            requestAnimationFrame(previewFrame);
        } else {
            currentAngle = angle;
            startMainSpin();
        }
    }
    requestAnimationFrame(previewFrame);

    // ── Phase 2 애니메이션 ─────────────────────────────────────
    function startMainSpin() {
        // 현재 각도 기준으로 targetAngle 까지 시계방향 delta 계산
        let delta = ((targetAngle - currentAngle) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
        if (delta < 0.1) delta += 2 * Math.PI;
        const totalDelta  = SPIN_EXTRA + delta;
        const spinStart   = currentAngle;
        const spinStartT  = performance.now();
        let tickInterval  = 80;
        setTickInterval(tickInterval);

        function spinFrame(now) {
            const t     = Math.min((now - spinStartT) / SPIN_DURATION, 1);
            const angle = spinStart + totalDelta * easeOut(t);
            drawWheel(angle);

            // 감속에 따라 틱 간격 늘리기
            const newInterval = Math.max(80, Math.floor(80 + 500 * easeOut(t)));
            if (newInterval !== tickInterval) {
                tickInterval = newInterval;
                setTickInterval(tickInterval);
            }

            if (t < 1) {
                requestAnimationFrame(spinFrame);
            } else {
                currentAngle = angle;
                spinning = false;
                clearInterval(tickTimer);
                tickTimer = null;
                showResult(items[winIndex]);
            }
        }
        requestAnimationFrame(spinFrame);
    }
}

function showResult(item) {
    document.getElementById('result-text').textContent = item.label;
    document.getElementById('result-banner').classList.add('show');
    playWinSound();
    spawnSparks();
    // 9초 유지 후 결과 배너 숨기고 룰렛도 슬라이딩 아웃
    setTimeout(() => {
        document.getElementById('result-banner').classList.remove('show');
    }, 9000);
    setTimeout(() => {
        wrap.classList.remove('spinning');
    }, 9600); // 배너 페이드 후 0.6초 뒤 슬라이딩 아웃
}

function spawnSparks() {
    const colors = ['#ffd700','#ff6b6b','#a855f7','#22c55e','#3b82f6'];
    for (let i = 0; i < 28; i++) {
        const s = document.createElement('div');
        s.className = 'spark';
        s.style.background = colors[i % colors.length];
        s.style.left = '311px'; s.style.top = '311px';
        const ang  = Math.random() * 2 * Math.PI;
        const dist = 80 + Math.random() * 180;
        s.style.setProperty('--tx', Math.cos(ang) * dist + 'px');
        s.style.setProperty('--ty', Math.sin(ang) * dist + 'px');
        wrap.appendChild(s);
        setTimeout(() => s.remove(), 1300);
    }
}

// ── 소켓 이벤트 ───────────────────────────────────────────
socket.on('roulette-spin', (data) => {
    // AudioContext는 사용자 인터랙션 없이는 suspended 상태 → resume 시도
    if (audioCtx.state === 'suspended') audioCtx.resume();
    spin(data.items || null, data.winIndex);
});

// 미션 문구 실시간 업데이트
socket.on('roulette-items-update', (data) => {
    if (data.items && data.items.length) {
        items = data.items;
        drawWheel(currentAngle);
    }
});

// ── 테스트 모드 ───────────────────────────────────────────
const urlParams = new URLSearchParams(location.search);
if (urlParams.get('test') === '1') {
    // 테스트 모드에서는 클릭/키로 AudioContext 재개 후 스핀
    document.body.addEventListener('click', () => audioCtx.resume(), { once: true });
    setTimeout(() => {
        wrap.classList.add('spinning');
        setTimeout(() => spin(null, Math.floor(Math.random() * DEFAULT_ITEMS.length)), 800);
    }, 400);
}
</script>
</body>
</html>
