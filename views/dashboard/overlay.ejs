<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오버레이 설정 - TikFind</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .mq-outer { background:#1f2937; border-radius:8px; padding:8px; }
        .mq-bar { width:100%; overflow:hidden; white-space:nowrap; display:flex; align-items:stretch; border-radius:4px; }
        .mq-badge { flex-shrink:0; color:#fff; font-weight:700; padding:0 10px; display:flex; align-items:center; gap:4px; border-right:1px solid rgba(255,255,255,0.2); }
        .mq-scroll { flex:1; overflow:hidden; display:flex; align-items:center; }
        .mq-track { display:inline-block; white-space:nowrap; animation:mq 14s linear infinite; padding:0 8px; }
        @keyframes mq { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

        /* 탭 */
        .tab-btn { transition: all .2s; border-bottom: 3px solid transparent; }
        .tab-btn.active { border-bottom-color: #6366f1; color: #6366f1; font-weight: 700; }
        .tab-btn.active-purple { border-bottom-color: #a855f7; color: #a855f7; font-weight: 700; }
        .tab-btn.active-blue   { border-bottom-color: #3b82f6; color: #3b82f6; font-weight: 700; }
        .tab-btn.active-green  { border-bottom-color: #22c55e; color: #22c55e; font-weight: 700; }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* 사이즈 및지 카드 */
        .size-badge { display:inline-flex; align-items:center; gap:6px; background:#f3f4f6; border:1px solid #e5e7eb; border-radius:8px; padding:6px 12px; font-family:monospace; font-size:13px; font-weight:700; color:#374151; }
        .size-badge .dim { color:#6366f1; }
        .step-num { width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:#fff; flex-shrink:0; }
        /* 모바일 오버레이가 클릭을 차단하지 않도록 */
        #mobile-overlay.hidden { pointer-events: none !important; display: none !important; }
    </style>
</head>
<body class="bg-gray-50">
    <div id="sidebar-container"></div>
    <div id="header-container"></div>
    
    <main class="ml-64 p-8" style="margin-top: 88px;">
        <div class="max-w-4xl mx-auto">

            <!-- 페이지 헤더 -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-800">📺 오버레이 설정</h2>
                <p class="text-gray-500 mt-1 text-sm">TikTok Live Studio / OBS 브라우저 소스에 추가할 위젯을 설정하세요</p>
            </div>

            <!-- 탭 네비게이션 -->
            <div class="bg-white rounded-xl shadow mb-6">
                <div class="flex border-b border-gray-200 px-2">
                    <button onclick="switchTab('gift')" id="tab-gift"
                        class="tab-btn active-purple px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-gift text-purple-500"></i> 선물 알림
                        <span class="px-1.5 py-0.5 bg-purple-100 text-purple-600 text-xs rounded-full font-bold">NEW</span>
                    </button>
                    <button onclick="switchTab('song')" id="tab-song"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-music text-indigo-500"></i> 신청곡 + 공지
                    </button>
                    <button onclick="switchTab('mod')" id="tab-mod"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-shield-alt text-blue-500"></i> 모더 위젯
                    </button>
                    <button onclick="switchTab('speech')" id="tab-speech"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-language text-green-500"></i> 번역 자막
                        <span class="px-1.5 py-0.5 bg-green-100 text-green-600 text-xs rounded-full font-bold">NEW</span>
                    </button>
                </div>

                <!-- ══════════════════════════════════
                     탭 1: 선물 알림 위젯
                ══════════════════════════════════ -->
                <div id="panel-gift" class="tab-panel active p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-6 p-4 bg-purple-50 rounded-xl border border-purple-100">
                        <div class="text-3xl">🎁</div>
                        <div>
                            <p class="font-semibold text-purple-800 text-sm">선물 알림 위젯이란?</p>
                            <p class="text-xs text-purple-600 mt-1 leading-relaxed">
                                100 다이아 이상의 고가 선물을 받았을 때 선물한 시청자의 프로필·닉네임·유도문구가 화면에 화려하게 표시됩니다.<br>
                                <strong>MID (100~999💎)</strong> 보라색 효과 &nbsp;|&nbsp; <strong>MEGA (1,000💎+)</strong> 금색 팡파레 + 화면 번쩍임
                            </p>
                        </div>
                    </div>

                    <!-- URL 카드 -->
                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-link text-purple-500 mr-1"></i> 위젯 URL
                        </label>
                        <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-3 border border-gray-200">
                            <code class="text-xs text-gray-600 flex-1 break-all select-all" id="giftUrl">https://tikfind.kr/overlay/<%= user._id %>/gift</code>
                            <button onclick="copyGiftUrl()" id="copyGiftBtn"
                                class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition text-sm whitespace-nowrap flex items-center gap-1">
                                <i class="fas fa-copy"></i> 복사
                            </button>
                        </div>
                    </div>

                    <!-- 고정 사이즈 안내 -->
                    <div class="mb-5 p-4 bg-purple-50 border border-purple-200 rounded-xl flex items-start gap-3">
                        <i class="fas fa-ruler-combined text-purple-500 mt-0.5"></i>
                        <div>
                            <p class="text-sm font-semibold text-purple-800 mb-1">고정 소스 크기 — <span class="font-mono">800 × 200 px</span></p>
                            <p class="text-xs text-purple-600 leading-relaxed">선물 알림 위젯은 <strong>너비 800px × 높이 200px</strong> 고정 크기입니다. 배너는 닉네임 길이에 맞게 자동으로 조절되며 최대 600px를 넘지 않습니다.<br>TikTok Live Studio에서 소스를 추가한 뒤 원하는 위치에 드래그해 배치하세요.</p>
                        </div>
                    </div>

                    <!-- MID / MEGA 다이아 기준 설정 -->
                    <div class="mb-5 p-4 bg-white border border-gray-200 rounded-xl">
                        <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-gem text-purple-500"></i> 알림 노출 기준 (다이아)
                        </h4>
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-xs font-semibold text-purple-700 mb-1">💜 MID 최소 다이아</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="midMin" min="0" max="9999" value="100" step="10"
                                        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300">
                                    <span class="text-xs text-gray-400 whitespace-nowrap">💎 이상</span>
                                </div>
                                <p class="text-xs text-gray-400 mt-1">이 값 이상~MEGA 미만 선물 → 보라색 카드</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-yellow-700 mb-1">💛 MEGA 최소 다이아</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="megaMin" min="0" max="99999" value="1000" step="100"
                                        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-yellow-300">
                                    <span class="text-xs text-gray-400 whitespace-nowrap">💎 이상</span>
                                </div>
                                <p class="text-xs text-gray-400 mt-1">이 값 이상 선물 → 금색 팡파레 카드</p>
                            </div>
                        </div>
                        <div class="flex justify-end">
                            <button onclick="saveGiftSettings(event)"
                                class="px-5 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition text-sm flex items-center gap-2" id="saveGiftBtn">
                                <i class="fas fa-save"></i> 저장
                            </button>
                        </div>
                    </div>

                    <!-- 미리보기 버튼 -->
                    <div class="flex flex-wrap gap-3 mb-6">
                        <a href="/overlay/<%= user._id %>/gift?test=mega" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-50 border border-yellow-300 text-yellow-700 rounded-lg hover:bg-yellow-100 transition text-sm font-semibold">
                            <i class="fas fa-star"></i> MEGA 효과 미리보기
                        </a>
                        <a href="/overlay/<%= user._id %>/gift?test=mid" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 border border-purple-200 text-purple-700 rounded-lg hover:bg-purple-100 transition text-sm font-semibold">
                            <i class="fas fa-gift"></i> MID 효과 미리보기
                        </a>
                    </div>

                    <!-- TikTok Live Studio 추가 방법 -->
                    <div class="border-t border-gray-100 pt-5">
                        <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-tv text-pink-500"></i> TikTok Live Studio 소스 추가 방법
                        </h4>
                        <ol class="space-y-3">
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-purple-500">1</span>
                                <p class="text-sm text-gray-600 pt-0.5">TikTok Live Studio 실행 → <strong>소스 패널</strong> → <strong>+ 추가</strong> 클릭</p>
                            </li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-purple-500">2</span>
                                <p class="text-sm text-gray-600 pt-0.5"><strong>브라우저(URL)</strong> 소스 선택</p>
                            </li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-purple-500">3</span>
                                <p class="text-sm text-gray-600 pt-0.5">위 URL 붙여넣기</p>
                            </li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-purple-500">4</span>
                                <div class="text-sm text-gray-600 pt-0.5">
                                    <strong>해상도</strong> 입력:
                                    <span class="size-badge ml-2">너비 <span class="dim">800</span> × 높이 <span class="dim">200</span></span>
                                </div>
                            </li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-purple-500">5</span>
                                <p class="text-sm text-gray-600 pt-0.5">소스를 원하는 위치에 드래그해 배치하세요. 평소에는 투명하고 선물이 올 때만 카드가 나타납니다.</p>
                            </li>
                        </ol>
                        <div class="mt-4 p-3 bg-purple-50 border-l-4 border-purple-400 rounded text-xs text-purple-700">
                            <i class="fas fa-lightbulb mr-1"></i>
                            <strong>팁:</strong> 미리보기에서 버튼을 누르면 실제 효과를 확인할 수 있습니다. Chrome 자동재생 정책으로 인해 첫 클릭이 필요합니다.
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════
                     탭 3: 모더 위젯
                ══════════════════════════════════ -->
                <div id="panel-mod" class="tab-panel p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-5 p-4 bg-blue-50 rounded-xl border border-blue-100">
                        <div class="text-3xl">🛡️</div>
                        <div>
                            <p class="font-semibold text-blue-800 text-sm">모더 위젯이란?</p>
                            <p class="text-xs text-blue-600 mt-1 leading-relaxed">
                                등록된 모더레이터가 방송에 입장하면 화면에 카드가 자동으로 나타납니다.<br>
                                TikTok ID와 표시할 닉네임을 등록해두면 입장 시 프로필 이미지와 함께 표시됩니다.
                            </p>
                        </div>
                    </div>

                    <!-- URL + 사이즈 -->
                    <div class="mb-5 p-4 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-3">
                        <i class="fas fa-ruler-combined text-blue-500 mt-0.5"></i>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-blue-800 mb-1">고정 소스 크기 — <span class="font-mono">150 × 800 px</span></p>
                            <p class="text-xs text-blue-600 leading-relaxed mb-2">세로는 모더 수에 맞게 자동 조절. 배경 투명, 카드 배경 블랙 20%.</p>
                            <div class="flex items-center gap-2 bg-white rounded-lg px-3 py-2 border border-blue-200">
                                <code class="text-xs text-gray-600 flex-1 break-all select-all" id="modUrl">https://tikfind.kr/overlay/<%= user._id %>/moderator</code>
                                <button onclick="copyModUrl()" id="copyModBtn"
                                    class="px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-xs whitespace-nowrap flex items-center gap-1">
                                    <i class="fas fa-copy"></i> 복사
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 미리보기 버튼 -->
                    <div class="flex flex-wrap gap-3 mb-5">
                        <a href="/overlay/<%= user._id %>/moderator?test=1" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 text-blue-700 rounded-lg hover:bg-blue-100 transition text-sm font-semibold">
                            <i class="fas fa-eye"></i> 모더 위젯 미리보기
                        </a>
                    </div>

                    <!-- 모더 등록 -->
                    <div class="mb-5 p-4 bg-white border border-gray-200 rounded-xl">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-plus-circle text-blue-500"></i> 모더 등록
                            <span class="ml-auto text-xs text-gray-400" id="modCount">0명 등록됨</span>
                        </h4>
                        <div class="grid grid-cols-2 gap-3 mb-3">
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">TikTok ID <span class="text-red-400">*</span></label>
                                <input type="text" id="modTiktokId" placeholder="@없이 입력 (예: kimjisoo)"
                                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">표시 닉네임 <span class="text-red-400">*</span> <span class="text-gray-300">(최대 20자)</span></label>
                                <input type="text" id="modDisplayName" placeholder="방송에 표시될 이름" maxlength="20"
                                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs font-medium text-gray-500 mb-2">프로필 이모지 선택</label>
                            <div class="flex gap-2 flex-wrap">
                                <input type="hidden" id="modEmoji" value="👑">
                                <% ['👑','🏆','💎','⭐','🌟'].forEach(function(em) { %>
                                <button type="button" onclick="selectModEmoji(this, '<%= em %>')" data-emoji="<%= em %>"
                                    class="mod-emoji-btn w-12 h-12 text-2xl rounded-xl border-2 border-gray-200 hover:border-blue-400 transition flex items-center justify-center bg-gray-50 hover:bg-blue-50"
                                    style="<%= em === '👑' ? 'border-color:#3b82f6;background:#eff6ff;' : '' %>">
                                    <%= em %>
                                </button>
                                <% }); %>
                            </div>
                        </div>
                        <div class="flex justify-end">
                            <button onclick="addModerator()"
                                class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm flex items-center gap-2">
                                <i class="fas fa-plus"></i> 등록
                            </button>
                        </div>
                    </div>

                    <!-- 모더 목록 -->
                    <div class="bg-white border border-gray-200 rounded-xl p-4">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-list text-blue-500"></i> 등록된 모더
                        </h4>
                        <div id="modList" class="space-y-2">
                            <div class="text-center py-4 text-gray-400 text-sm">등록된 모더가 없습니다.</div>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════
                     탭 2: 신청곡 자막
                ══════════════════════════════════ -->
                <div id="panel-song" class="tab-panel p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-4 p-4 bg-indigo-50 rounded-xl border border-indigo-100">
                        <div class="text-3xl">🎵</div>
                        <div>
                            <p class="font-semibold text-indigo-800 text-sm">신청곡 자막 오버레이란?</p>
                            <p class="text-xs text-indigo-600 mt-1 leading-relaxed">
                                현재 재생 중인 곡과 다음 신청곡 정보가 화면 하단에 흐르는 자막으로 표시됩니다.<br>
                                시청자는 채팅에 <strong>#노래제목 #가수명</strong> 형식으로 신청할 수 있습니다.
                            </p>
                        </div>
                    </div>

                    <!-- 고정 사이즈 안내 -->
                    <div class="mb-5 p-4 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-3">
                        <i class="fas fa-ruler-combined text-blue-500 mt-0.5"></i>
                        <div>
                            <p class="text-sm font-semibold text-blue-800 mb-1">고정 소스 크기 — <span class="font-mono">750 × 75 px</span></p>
                            <p class="text-xs text-blue-600 leading-relaxed">신청곡+공지 자막은 <strong>너비 750px × 높이 75px</strong> 고정 크기입니다. TikTok Live Studio에서 소스를 추가한 뒤 원하는 위치에 자유롭게 드래그해 배치하세요.</p>
                        </div>
                    </div>

                    <!-- 스타일 설정 -->
                    <div class="mb-5">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-palette text-indigo-500"></i> 스타일 설정
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-2">배경색 &amp; 투명도</label>
                                <div class="flex items-center gap-3">
                                    <input type="color" id="bgColor" value="#000000"
                                        class="w-10 h-10 rounded cursor-pointer border border-gray-200" oninput="updateAll()">
                                    <div class="flex-1">
                                        <input type="range" id="bgOpacity" min="0" max="100" value="30" class="w-full" oninput="updateAll()">
                                        <div class="flex justify-between text-xs text-gray-400 mt-0.5">
                                            <span>투명</span><span id="opacityLabel">30%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-2">글자색</label>
                                <input type="color" id="txtColor" value="#ffffff"
                                    class="w-10 h-10 rounded cursor-pointer border border-gray-200" oninput="updateAll()">
                            </div>
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-medium text-gray-500 mb-2">글자크기: <span id="sizeLabel">28</span>px</label>
                                <input type="range" id="fontSize" min="12" max="40" value="28" class="w-full"
                                    oninput="document.getElementById('sizeLabel').textContent=this.value; updateAll()">
                                <div class="flex justify-between text-xs text-gray-400 mt-0.5"><span>작게</span><span>크게</span></div>
                            </div>
                        </div>
                        <div class="mt-4 flex justify-end">
                            <button onclick="saveSettings()"
                                class="px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm flex items-center gap-2">
                                <i class="fas fa-save"></i> 설정 저장
                            </button>
                        </div>
                    </div>

                    <!-- URL + 사이즈 안내 -->
                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-link text-indigo-500 mr-1"></i> 위젯 URL (스타일 설정 자동 반영)
                        </label>
                        <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-3 border border-gray-200 mb-2">
                            <code class="text-xs text-gray-600 flex-1 break-all select-all" id="finalUrl">https://tikfind.kr/overlay/<%= user._id %></code>
                            <button onclick="copyUrl('finalUrl','copyFinalBtn')" id="copyFinalBtn"
                                class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm whitespace-nowrap flex items-center gap-1">
                                <i class="fas fa-copy"></i> 복사
                            </button>
                        </div>
                        <!-- URL 변경 공지 -->
                        <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg flex items-start gap-2 mb-3">
                            <i class="fas fa-exclamation-triangle text-amber-500 text-xs mt-0.5"></i>
                            <p class="text-xs text-amber-700 leading-relaxed">
                                <strong>스타일 수정 후에는 URL이 바뀝니다.</strong> 위에서 새 URL을 복사한 뒤, TikTok Live Studio 소스에서 <strong>URL을 교체</strong>해주세요.
                            </p>
                        </div>
                        <div class="flex flex-wrap gap-3">
                            <div class="size-badge">
                                <i class="fas fa-expand-alt text-indigo-400"></i>
                                너비 <span class="dim">750</span> × 높이 <span class="dim">75</span> px
                                <span class="text-gray-400 font-normal text-xs">(고정 크기)</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-3 mb-6">
                        <a href="/overlay/<%= user._id %>" target="_blank" id="previewLink"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-lg hover:bg-indigo-100 transition text-sm font-semibold">
                            <i class="fas fa-external-link-alt"></i> 새 창에서 미리보기
                        </a>
                    </div>

                    <!-- 공지사항 관리 -->
                    <div class="mb-6 border border-indigo-100 rounded-xl overflow-hidden">
                        <div class="bg-indigo-50 px-5 py-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-bullhorn text-indigo-500"></i>
                                <span class="text-sm font-semibold text-indigo-800">공지사항 관리</span>
                                <span class="text-xs text-indigo-500">(최대 10개 · 50자 이내)</span>
                            </div>
                            <span class="text-xs text-indigo-400" id="noticeSavedCount">0개 저장됨</span>
                        </div>
                        <div class="p-4">
                            <!-- 공지 추가 입력 -->
                            <div class="flex gap-2 mb-4">
                                <div class="flex-1 relative">
                                    <input type="text" id="noticeInput" maxlength="50"
                                        placeholder="공지 내용 입력 (최대 50자)"
                                        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 pr-12"
                                        onkeydown="if(event.key==='Enter') addNotice()">
                                    <span class="absolute right-3 top-2.5 text-xs text-gray-400" id="noticeCharCount">0/50</span>
                                </div>
                                <button onclick="addNotice()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition flex items-center gap-1">
                                    <i class="fas fa-plus"></i> 추가
                                </button>
                            </div>
                            <!-- 공지 목록 -->
                            <div id="noticeList" class="space-y-2">
                                <div class="text-center py-4 text-gray-400 text-sm"><i class="fas fa-spinner fa-spin mr-1"></i>불러오는 중...</div>
                            </div>
                        </div>
                    </div>

                    <!-- 추가 방법 -->
                    <div class="border-t border-gray-100 pt-5">
                        <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-tv text-pink-500"></i> TikTok Live Studio 소스 추가 방법
                        </h4>
                        <ol class="space-y-3">
                            <li class="flex gap-3 items-start"><span class="step-num bg-indigo-500">1</span><p class="text-sm text-gray-600 pt-0.5">TikTok Live Studio 실행 → <strong>소스 패널</strong> → <strong>+ 추가</strong></p></li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-indigo-500">2</span><p class="text-sm text-gray-600 pt-0.5"><strong>브라우저(URL)</strong> 소스 선택</p></li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-indigo-500">3</span><p class="text-sm text-gray-600 pt-0.5">위에서 복사한 URL 붙여넣기</p></li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-indigo-500">4</span>
                                <div class="text-sm text-gray-600 pt-0.5">
                                    <strong>해상도(너비 × 높이)</strong> 입력:
                                    <span class="size-badge ml-2"><span class="dim">750</span> × <span class="dim">75</span></span>
                                </div>
                            </li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-indigo-500">5</span><p class="text-sm text-gray-600 pt-0.5">원하는 위치에 <strong>드래그해서 배치</strong> — 소스 크기가 750×75으로 딱 맞게 고정됩니다</p></li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-indigo-500">6</span>
                                <div class="text-sm text-gray-600 pt-0.5">
                                    <strong>⚠️ 스타일 수정 시</strong>: 설정 저장 후 새 URL을 복사하여 Studio 소스의 URL을 교체해 주세요.
                                </div>
                            </li>
                        </ol>
                        <div class="mt-4 p-3 bg-indigo-50 border-l-4 border-indigo-400 rounded text-xs text-indigo-700">
                            <i class="fas fa-lightbulb mr-1"></i>
                            <strong>팁:</strong> 배경 투명도를 0%로 설정하면 완전 투명 자막으로 사용할 수 있습니다.
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════
                     탭 4: 번역 자막 위젯
                ══════════════════════════════════ -->
                <div id="panel-speech" class="tab-panel p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-5 p-4 bg-green-50 rounded-xl border border-green-100">
                        <div class="text-3xl">🌐</div>
                        <div>
                            <p class="font-semibold text-green-800 text-sm">실시간 번역 자막 위젯이란?</p>
                            <p class="text-xs text-green-600 mt-1 leading-relaxed">
                                Chrome에서 마이크 페이지를 열어두면 음성을 인식해 방송 화면에 자동 번역 자막이 표시됩니다.<br>
                                <strong>별도 프로그램 설치 불필요</strong> · 말하는 즉시 선택한 언어로 자막 표시
                            </p>
                        </div>
                    </div>

                    <!-- 주의사항 -->
                    <div class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-xl flex items-start gap-2">
                        <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5 flex-shrink-0"></i>
                        <p class="text-xs text-amber-700 leading-relaxed">
                            <strong>TikTok Live Studio 브라우저 소스는 마이크를 지원하지 않습니다.</strong><br>
                            아래 <strong>① 자막 위젯 URL</strong>은 TikTok Studio에, <strong>② 마이크 URL</strong>은 <strong>별도 Chrome 창</strong>에서 열어주세요.
                        </p>
                    </div>

                    <!-- ① 자막 위젯 URL -->
                    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-xl flex items-start gap-3">
                        <i class="fas fa-tv text-green-500 mt-0.5 flex-shrink-0"></i>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-green-800 mb-1">① 자막 위젯 — TikTok Live Studio에 추가 <span class="font-mono text-xs font-normal ml-1">800 × 100 px</span></p>
                            <div class="flex items-center gap-2 bg-white rounded-lg px-3 py-2 border border-green-200">
                                <code class="text-xs text-gray-600 flex-1 break-all select-all" id="speechUrl">https://tikfind.kr/overlay/<%= user._id %>/speech</code>
                                <button onclick="copySpeechUrl()" id="copySpeechBtn"
                                    class="px-3 py-1.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-xs whitespace-nowrap flex items-center gap-1">
                                    <i class="fas fa-copy"></i> 복사
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ② 마이크 URL -->
                    <div class="mb-5 p-4 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-3">
                        <i class="fas fa-microphone text-blue-500 mt-0.5 flex-shrink-0"></i>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-blue-800 mb-1">② 마이크 페이지 — Chrome에서 별도로 열기</p>
                            <div class="flex items-center gap-2 bg-white rounded-lg px-3 py-2 border border-blue-200">
                                <code class="text-xs text-gray-600 flex-1 break-all select-all" id="speechMicUrl">https://tikfind.kr/overlay/<%= user._id %>/speech-mic</code>
                                <button onclick="copySpeechMicUrl()" id="copySpeechMicBtn"
                                    class="px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-xs whitespace-nowrap flex items-center gap-1">
                                    <i class="fas fa-copy"></i> 복사
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 언어 선택 -->
                    <div class="mb-5 p-4 bg-white border border-gray-200 rounded-xl">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-globe text-green-500"></i> 번역 언어 선택
                            <span class="text-xs text-gray-400 font-normal">최대 2개</span>
                        </h4>
                        <div class="grid grid-cols-3 gap-2 mb-4" id="langCheckboxes">
                            <% [
                                {code:'en', label:'🇺🇸 영어 (English)'},
                                {code:'ja', label:'🇯🇵 일본어 (日本語)'},
                                {code:'zh', label:'🇨🇳 중국어 (中文)'},
                                {code:'es', label:'🇪🇸 스페인어'},
                                {code:'fr', label:'🇫🇷 프랑스어'},
                                {code:'de', label:'🇩🇪 독일어'},
                                {code:'th', label:'🇹🇭 태국어'},
                                {code:'vi', label:'🇻🇳 베트남어'},
                                {code:'id', label:'🇮🇩 인도네시아어'}
                            ].forEach(function(l){ %>
                            <label class="flex items-center gap-2 p-2.5 border border-gray-200 rounded-lg cursor-pointer hover:bg-green-50 hover:border-green-300 transition lang-label" data-code="<%= l.code %>">
                                <input type="checkbox" class="lang-check" value="<%= l.code %>" onchange="onLangChange()">
                                <span class="text-sm text-gray-700"><%= l.label %></span>
                            </label>
                            <% }); %>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs text-gray-400" id="langCountMsg">0개 선택됨</p>
                            <button onclick="saveSpeechSettings()"
                                class="px-5 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm flex items-center gap-2" id="saveSpeechBtn">
                                <i class="fas fa-save"></i> 저장
                            </button>
                        </div>
                    </div>

                    <!-- 미리보기 -->
                    <div class="flex flex-wrap gap-3 mb-5">
                        <a href="/overlay/<%= user._id %>/speech?test=1" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 text-green-700 rounded-lg hover:bg-green-100 transition text-sm font-semibold">
                            <i class="fas fa-eye"></i> 번역 자막 미리보기
                        </a>
                    </div>

                    <!-- 추가 방법 -->
                    <div class="border-t border-gray-100 pt-5">
                        <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-tv text-pink-500"></i> 설정 방법
                        </h4>
                        <ol class="space-y-3">
                            <li class="flex gap-3 items-start"><span class="step-num bg-green-500">1</span><p class="text-sm text-gray-600 pt-0.5">위 <strong>번역 언어</strong>를 선택하고 저장</p></li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-blue-500">2</span><p class="text-sm text-gray-600 pt-0.5"><strong>② 마이크 URL</strong> 복사 후 Chrome에서 새 탭으로 열기 → <strong>마이크 시작</strong> 버튼 클릭 → 방송 중 백그라운드로 유지</p></li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-green-500">3</span><p class="text-sm text-gray-600 pt-0.5"><strong>① 자막 위젯 URL</strong> 복사 후 TikTok Live Studio → <strong>소스 추가</strong> → <strong>브라우저(URL)</strong></p></li>
                            <li class="flex gap-3 items-start">
                                <span class="step-num bg-green-500">4</span>
                                <div class="text-sm text-gray-600 pt-0.5">
                                    소스 <strong>해상도</strong> 입력:
                                    <span class="size-badge ml-2">너비 <span class="dim">800</span> × 높이 <span class="dim">100</span></span>
                                </div>
                            </li>
                            <li class="flex gap-3 items-start"><span class="step-num bg-green-500">5</span><p class="text-sm text-gray-600 pt-0.5">소스를 화면 <strong>하단 중앙</strong>에 배치 → 완료!</p></li>
                        </ol>
                        <div class="mt-4 p-3 bg-green-50 border-l-4 border-green-400 rounded text-xs text-green-700">
                            <i class="fas fa-lightbulb mr-1"></i>
                            <strong>팁:</strong> 말을 멈추면 자막이 6초 후 자동으로 사라집니다. Chrome 마이크 페이지는 방송 내내 열어두세요.
                        </div>
                    </div>
                </div>

        </div>
    </main>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        const BASE_URL = 'https://tikfind.kr/overlay/<%= user._id %>';

        // ── 탭 전환 ──
        function switchTab(name) {
            ['gift','song','mod','speech'].forEach(t => {
                document.getElementById('panel-' + t).classList.toggle('active', t === name);
                const btn = document.getElementById('tab-' + t);
                btn.classList.remove('active', 'active-purple', 'active-blue', 'active-green');
                if (t === name) {
                    if (name === 'gift')   btn.classList.add('active-purple');
                    else if (name === 'mod')    btn.classList.add('active-blue');
                    else if (name === 'speech') btn.classList.add('active-green');
                    else btn.classList.add('active');
                }
            });
            if (name === 'song')   loadNotices();
            if (name === 'gift')   loadGiftSettings();
            if (name === 'mod')    loadModerators();
            if (name === 'speech') loadSpeechSettings();
        }

        // ── 선물 다이아 기준 저장 ──
        async function saveGiftSettings(event) {
            const midMin  = parseInt(document.getElementById('midMin').value)  || 0;
            const megaMin = parseInt(document.getElementById('megaMin').value) || 0;
            const btn = document.getElementById('saveGiftBtn');
            const orig = btn.innerHTML;
            try {
                const res = await fetch('/api/gift-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ midMin, megaMin })
                });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
                    btn.classList.replace('bg-purple-600','bg-green-600');
                    btn.classList.replace('hover:bg-purple-700','hover:bg-green-700');
                    setTimeout(() => {
                        btn.innerHTML = orig;
                        btn.classList.replace('bg-green-600','bg-purple-600');
                        btn.classList.replace('hover:bg-green-700','hover:bg-purple-700');
                    }, 2000);
                } else {
                    alert('저장 실패: ' + (data.message || ''));
                }
            } catch(e) {
                alert('오류가 발생했습니다.');
            }
        }

        async function loadGiftSettings() {
            try {
                const res  = await fetch('/api/gift-settings');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('midMin').value  = data.midMin  ?? 100;
                    document.getElementById('megaMin').value = data.megaMin ?? 1000;
                }
            } catch(e) {}
        }

        // ── 모더 URL 복사 ──
        function copyModUrl() {
            const text = document.getElementById('modUrl').textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyModBtn');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.replace('bg-blue-600','bg-green-600');
                btn.classList.replace('hover:bg-blue-700','hover:bg-green-700');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.replace('bg-green-600','bg-blue-600');
                    btn.classList.replace('hover:bg-green-700','hover:bg-blue-700');
                }, 2000);
            });
        }

        // ── 모더 관리 ──
        async function loadModerators() {
            const res  = await fetch('/api/moderator/list');
            const data = await res.json();
            if (!data.success) return;
            renderModerators(data.moderators);
        }

        function renderModerators(mods) {
            var el = document.getElementById('modList');
            document.getElementById('modCount').textContent = mods.length + '명 등록됨';
            if (!mods.length) {
                el.innerHTML = '<div class="text-center py-4 text-gray-400 text-sm">등록된 모더가 없습니다.</div>';
                return;
            }
            var html = '';
            for (var i = 0; i < mods.length; i++) {
                var m = mods[i];
                var isUrl = (m.profileImg || '').startsWith('http');
                var avatarHtml;
                if (isUrl) {
                    avatarHtml = '<img src="' + escHtmlMod(m.profileImg) + '" class="w-full h-full object-cover">';
                } else if (m.profileImg) {
                    avatarHtml = '<span style="font-size:18px">' + escHtmlMod(m.profileImg) + '</span>';
                } else {
                    avatarHtml = escHtmlMod(m.displayName.charAt(0).toUpperCase());
                }
                html += '<div class="flex items-center gap-2 p-2.5 bg-white border border-gray-200 rounded-lg">';
                html += '<div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center font-bold text-blue-600 flex-shrink-0 overflow-hidden border border-blue-100">' + avatarHtml + '</div>';
                html += '<div class="flex-1 min-w-0">';
                html += '<div class="text-sm font-semibold text-gray-700 truncate">' + escHtmlMod(m.displayName) + '</div>';
                html += '<div class="text-xs text-gray-400 truncate">@' + escHtmlMod(m.tiktokUniqueId) + '</div>';
                html += '</div>';
                html += '<button onclick="deleteModerator(\'' + m._id + '\')" class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-red-50 transition text-red-400 flex-shrink-0"><i class="fas fa-trash"></i></button>';
                html += '</div>';
            }
            el.innerHTML = html;
        }

        function escHtmlMod(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function selectModEmoji(btn, emoji) {
            document.querySelectorAll('.mod-emoji-btn').forEach(b => {
                b.style.borderColor = '';
                b.style.background  = '';
            });
            btn.style.borderColor = '#3b82f6';
            btn.style.background  = '#eff6ff';
            document.getElementById('modEmoji').value = emoji;
        }

        async function addModerator() {
            const tiktokUniqueId = document.getElementById('modTiktokId').value.trim().replace(/^@/, '');
            const displayName    = document.getElementById('modDisplayName').value.trim();
            const profileImg     = document.getElementById('modEmoji').value || '👑';
            if (!tiktokUniqueId || !displayName) { alert('TikTok ID와 닉네임을 입력해주세요.'); return; }
            const res = await fetch('/api/moderator', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tiktokUniqueId, displayName, profileImg })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('modTiktokId').value    = '';
                document.getElementById('modDisplayName').value = '';
                // 이모지 선택 초기화
                document.querySelectorAll('.mod-emoji-btn').forEach((b,i) => {
                    b.style.borderColor = i === 0 ? '#3b82f6' : '';
                    b.style.background  = i === 0 ? '#eff6ff' : '';
                });
                document.getElementById('modEmoji').value = '👑';
                loadModerators();
            } else {
                alert(data.message);
            }
        }

        async function deleteModerator(id) {
            if (!confirm('이 모더를 삭제하시겠습니까?')) return;
            await fetch('/api/moderator/' + id, { method: 'DELETE' });
            loadModerators();
        }

        // ── 선물 URL 복사 ──
        function copyGiftUrl() {
            const text = document.getElementById('giftUrl').textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyGiftBtn');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.replace('bg-purple-600','bg-green-600');
                btn.classList.replace('hover:bg-purple-700','hover:bg-green-700');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.replace('bg-green-600','bg-purple-600');
                    btn.classList.replace('hover:bg-green-700','hover:bg-purple-700');
                }, 2000);
            });
        }

        function hexToRgba(hex, alpha) {
            const r = parseInt(hex.slice(1,3), 16);
            const g = parseInt(hex.slice(3,5), 16);
            const b = parseInt(hex.slice(5,7), 16);
            return `rgba(${r},${g},${b},${alpha})`;
        }

        function copyUrl(elId, btnId) {
            const text = document.getElementById(elId).textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById(btnId);
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>복사됨!';
                btn.classList.replace('bg-indigo-600','bg-green-600');
                btn.classList.replace('hover:bg-indigo-700','hover:bg-green-700');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.replace('bg-green-600','bg-indigo-600');
                    btn.classList.replace('hover:bg-green-700','hover:bg-indigo-700');
                }, 2000);
            });
        }

        const STORAGE_KEY = 'overlaySettings_<%= user._id %>';

        function saveSettings() {
            const s = {
                bgColor:   document.getElementById('bgColor').value,
                bgOpacity: document.getElementById('bgOpacity').value,
                txtColor:  document.getElementById('txtColor').value,
                fontSize:  document.getElementById('fontSize').value
            };
            localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
            const btn = event.currentTarget;
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
            btn.classList.replace('bg-indigo-600','bg-green-600');
            btn.classList.replace('hover:bg-indigo-700','hover:bg-green-700');
            setTimeout(() => {
                btn.innerHTML = orig;
                btn.classList.replace('bg-green-600','bg-indigo-600');
                btn.classList.replace('hover:bg-green-700','hover:bg-indigo-700');
            }, 2000);
        }

        function loadSettings() {
            try {
                const s = JSON.parse(localStorage.getItem(STORAGE_KEY));
                if (!s) return;
                if (s.bgColor)   document.getElementById('bgColor').value   = s.bgColor;
                if (s.bgOpacity) {
                    document.getElementById('bgOpacity').value = s.bgOpacity;
                    document.getElementById('opacityLabel').textContent = s.bgOpacity + '%';
                }
                if (s.txtColor)  document.getElementById('txtColor').value  = s.txtColor;
                if (s.fontSize) {
                    document.getElementById('fontSize').value = s.fontSize;
                    document.getElementById('sizeLabel').textContent = s.fontSize;
                }
            } catch(e) {}
        }

        function updateAll() {
            const hex     = document.getElementById('bgColor').value;
            const opacity = parseInt(document.getElementById('bgOpacity').value);
            const color   = document.getElementById('txtColor').value;
            const size    = parseInt(document.getElementById('fontSize').value);

            document.getElementById('opacityLabel').textContent = opacity + '%';

            const alpha = (opacity / 100).toFixed(2);
            const bg    = hexToRgba(hex, alpha);

            const p = new URLSearchParams();
            p.set('bg',    encodeURIComponent(bg));
            p.set('color', color);
            p.set('size',  size);
            const finalUrl = BASE_URL + '?' + p.toString();

            document.getElementById('finalUrl').textContent = finalUrl;
            document.getElementById('previewLink').href = '/overlay/<%= user._id %>?' + p.toString();
        }

        // 초기 실행
        loadSettings();
        updateAll();

        // ── 공지사항 관리 ──
        document.getElementById('noticeInput').addEventListener('input', function() {
            document.getElementById('noticeCharCount').textContent = this.value.length + '/50';
        });

        async function loadNotices() {
            const res = await fetch('/api/overlay-notice');
            const data = await res.json();
            if (!data.success) return;
            renderNotices(data.notices);
        }

        function renderNotices(notices) {
            const el = document.getElementById('noticeList');
            document.getElementById('noticeSavedCount').textContent = notices.length + '개 저장됨';
            if (!notices.length) {
                el.innerHTML = '<div class="text-center py-4 text-gray-400 text-sm">저장된 공지가 없습니다.<br><span class="text-xs">공지를 추가하면 오버레이에 신청곡 사이에 표시됩니다.</span></div>';
                return;
            }
            el.innerHTML = notices.map(n => `
                <div class="flex items-center gap-2 p-2.5 bg-white border border-gray-200 rounded-lg" id="notice-${n._id}">
                    <span class="text-xs px-2 py-0.5 rounded-full font-semibold flex-shrink-0 ${n.isActive ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-400'}">
                        ${n.isActive ? '📢 ON' : 'OFF'}
                    </span>
                    <span class="flex-1 text-sm text-gray-700 truncate" id="notice-text-${n._id}">${escHtml(n.content)}</span>
                    <div class="flex gap-1 flex-shrink-0">
                        <button onclick="toggleNotice('${n._id}', ${!n.isActive})"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-gray-50 transition ${n.isActive ? 'text-gray-500' : 'text-indigo-600'}">
                            ${n.isActive ? '끄기' : '켜기'}
                        </button>
                        <button onclick="editNotice('${n._id}', ${JSON.stringify(n.content)})"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-gray-50 transition text-gray-500">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button onclick="deleteNotice('${n._id}')"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-red-50 transition text-red-400">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function escHtml(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        async function addNotice() {
            const input = document.getElementById('noticeInput');
            const content = input.value.trim();
            if (!content) return;
            const res = await fetch('/api/overlay-notice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content })
            });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                document.getElementById('noticeCharCount').textContent = '0/50';
                loadNotices();
            } else {
                alert(data.message);
            }
        }

        async function toggleNotice(id, isActive) {
            await fetch(`/api/overlay-notice/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isActive })
            });
            loadNotices();
        }

        async function editNotice(id, currentContent) {
            const newContent = prompt('공지 내용 수정 (최대 50자):', currentContent);
            if (newContent === null) return;
            if (newContent.length > 50) { alert('50자 이내로 입력해주세요.'); return; }
            const res = await fetch(`/api/overlay-notice/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: newContent.trim() })
            });
            const data = await res.json();
            if (data.success) loadNotices();
            else alert(data.message);
        }

        async function deleteNotice(id) {
            if (!confirm('이 공지를 삭제하시겠습니까?')) return;
            await fetch(`/api/overlay-notice/${id}`, { method: 'DELETE' });
            loadNotices();
        }

        // ── 번역 자막 언어 설정 ──
        async function loadSpeechSettings() {
            try {
                const res  = await fetch('/api/speech-settings');
                const data = await res.json();
                if (data.success && data.langs) {
                    document.querySelectorAll('.lang-check').forEach(cb => {
                        cb.checked = data.langs.includes(cb.value);
                    });
                    updateLangCheckboxStyles();
                    document.getElementById('langCountMsg').textContent = data.langs.length + '개 선택됨';
                }
            } catch(e) {}
        }

        function onLangChange() {
            const checked = [...document.querySelectorAll('.lang-check:checked')];
            if (checked.length > 2) {
                // 마지막 체크된 것 해제
                event.target.checked = false;
                return;
            }
            updateLangCheckboxStyles();
            document.getElementById('langCountMsg').textContent = checked.length + '개 선택됨';
        }

        function updateLangCheckboxStyles() {
            document.querySelectorAll('.lang-label').forEach(label => {
                const cb = label.querySelector('.lang-check');
                if (cb.checked) {
                    label.style.borderColor = '#22c55e';
                    label.style.background  = '#f0fdf4';
                } else {
                    label.style.borderColor = '';
                    label.style.background  = '';
                }
            });
        }

        async function saveSpeechSettings() {
            const langs = [...document.querySelectorAll('.lang-check:checked')].map(cb => cb.value);
            if (!langs.length) { alert('언어를 1개 이상 선택해주세요.'); return; }
            const btn  = document.getElementById('saveSpeechBtn');
            const orig = btn.innerHTML;
            try {
                const res  = await fetch('/api/speech-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ langs })
                });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
                    btn.classList.replace('bg-green-600','bg-emerald-600');
                    setTimeout(() => {
                        btn.innerHTML = orig;
                        btn.classList.replace('bg-emerald-600','bg-green-600');
                    }, 2000);
                } else {
                    alert('저장 실패: ' + (data.message || ''));
                }
            } catch(e) { alert('오류가 발생했습니다.'); }
        }

        function copySpeechUrl() {
            const text = document.getElementById('speechUrl').textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copySpeechBtn');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.replace('bg-green-600','bg-emerald-600');
                setTimeout(() => { btn.innerHTML = orig; btn.classList.replace('bg-emerald-600','bg-green-600'); }, 2000);
            });
        }

        function copySpeechMicUrl() {
            const text = document.getElementById('speechMicUrl').textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copySpeechMicBtn');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.replace('bg-blue-600','bg-blue-400');
                setTimeout(() => { btn.innerHTML = orig; btn.classList.replace('bg-blue-400','bg-blue-600'); }, 2000);
            });
        }

        // 초기 탭 로드
        if (document.getElementById('panel-song').classList.contains('active'))   loadNotices();
        if (document.getElementById('panel-gift').classList.contains('active'))   loadGiftSettings();
        if (document.getElementById('panel-mod').classList.contains('active'))    loadModerators();
        if (document.getElementById('panel-speech').classList.contains('active')) loadSpeechSettings();

        // mobile-overlay가 클릭을 차단하지 않도록 강제 숨김
        function fixMobileOverlay() {
            const mo = document.getElementById('mobile-overlay');
            if (mo) {
                mo.classList.add('hidden');
                mo.style.pointerEvents = 'none';
                mo.style.display = 'none';
            }
        }
        fixMobileOverlay();
        // header-container에 동적 삽입 후에도 처리
        const headerObs = new MutationObserver(() => fixMobileOverlay());
        const hc = document.getElementById('header-container');
        if (hc) headerObs.observe(hc, { childList: true, subtree: true });
    </script>
</body>
</html>
