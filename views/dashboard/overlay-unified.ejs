<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오버레이 설정 - TikFind</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div id="sidebar-container"></div>
    <div id="header-container"></div>
    
    <main class="ml-64 p-8" style="margin-top: 88px;">
        <div class="max-w-6xl mx-auto">
            <!-- 페이지 헤더 -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-800">📺 오버레이 설정</h2>
                <p class="text-gray-500 mt-1 text-sm">TikTok Live Studio에서 통합 오버레이를 설정하세요</p>
            </div>

            <!-- 안내 섹션 -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-5 mb-6">
                <h3 class="font-semibold text-blue-800 mb-3 text-base">📋 TikTok Live Studio 설정 방법</h3>
                <div class="space-y-3">
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">1</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1">위젯 표시/숨김 설정</p>
                            <p class="text-sm text-blue-700">아래 체크박스로 표시할 위젯을 선택한 후 <strong>"저장"</strong> 버튼을 클릭하세요.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">2</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1">소스 추가</p>
                            <p class="text-sm text-blue-700">틱톡 라이브 스튜디오 화면 좌측의 <strong>[소스 추가]</strong> 버튼을 클릭합니다.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">3</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1">링크 선택</p>
                            <p class="text-sm text-blue-700">소스 목록 중 <strong>[링크 (Link)]</strong>를 선택합니다.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">4</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1">URL 및 사이즈 입력</p>
                            <p class="text-sm text-blue-700 mb-2">아래 <strong>"통합 오버레이 URL"</strong>을 복사해서 URL 입력창에 붙여넣으세요.</p>
                            <p class="text-sm text-blue-700">사이즈 크기 설정에 <strong>가로 1080 × 세로 1920</strong>을 정확히 입력한 뒤 저장합니다.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">5</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1"><span class="text-red-600">[중요]</span> 소스 이름 변경</p>
                            <p class="text-sm text-blue-700">추가된 소스의 이름을 기존 <strong>'링크'</strong>에서 <strong>'틱파인드'</strong>로 꼭 변경해 줍니다.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xs">6</span>
                        <div>
                            <p class="text-sm text-blue-800 font-semibold mb-1">화면 정렬</p>
                            <p class="text-sm text-blue-700">소스 설정 화면에서 <strong>[중간 정렬]</strong>을 누른 후, 이어서 <strong>[전체 화면]</strong>을 클릭하여 캔버스 크기에 딱 맞게 맞춰줍니다.</p>
                        </div>
                    </div>
                    <div class="mt-4 p-3 bg-blue-100 rounded-lg border border-blue-300">
                        <p class="text-sm text-blue-800 font-semibold">✅ 화면 최적화 완료</p>
                        <p class="text-sm text-blue-700 mt-1">위 설정대로 세팅하시면 틱톡 라이브 스튜디오의 세로(9:16) 표준 해상도에 맞춰 틱파인드의 미들웨어와 인터랙티브 소스들이 밀림이나 깨짐 현상 없이 가장 안정적이고 깔끔하게 구동됩니다.</p>
                    </div>
                </div>
            </div>

            <!-- 위젯 토글 -->
            <div class="bg-white rounded-xl shadow mb-6 p-4">
                <h3 class="font-semibold text-gray-800 mb-3">위젯 표시/숨김</h3>
                <div class="flex flex-wrap gap-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggle-song" checked class="w-5 h-5 text-indigo-600 rounded">
                        <span class="text-sm">🎵 신청곡+공지</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggle-speech" checked class="w-5 h-5 text-indigo-600 rounded">
                        <span class="text-sm">🎤 번역 자막</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggle-gift" checked class="w-5 h-5 text-indigo-600 rounded">
                        <span class="text-sm">🎁 선물 알림</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggle-moderator" checked class="w-5 h-5 text-indigo-600 rounded">
                        <span class="text-sm">🛡️ 모더 위젯</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggle-roulette" checked class="w-5 h-5 text-indigo-600 rounded">
                        <span class="text-sm">🎰 룰렛 미션</span>
                    </label>
                </div>
            </div>

            <!-- 통합 오버레이 URL -->
            <div class="bg-white rounded-xl shadow mb-6 p-4">
                <h3 class="font-semibold text-gray-800 mb-3">통합 오버레이 URL</h3>
                <div class="flex items-center gap-2">
                    <input type="text" id="overlay-url" readonly class="flex-1 px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-sm">
                    <button onclick="copyUrl()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                        <i class="fas fa-copy mr-2"></i>복사
                    </button>
                </div>
            </div>

            <!-- 저장 버튼 -->
            <div class="flex justify-end gap-3">
                <button onclick="savePositions()" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-semibold">
                    <i class="fas fa-save mr-2"></i>저장
                </button>
            </div>
        </div>
    </main>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        // 위젯 초기 상태
        const defaultWidgets = {
            song: { visible: true, label: '🎵 신청곡+공지' },
            speech: { visible: true, label: '🎤 번역 자막' },
            gift: { visible: true, label: '🎁 선물 알림' },
            moderator: { visible: true, label: '🛡️ 모더 위젯' },
            roulette: { visible: true, label: '🎰 룰렛 미션' }
        };

        let widgets = {};

        // 초기화
        document.addEventListener('DOMContentLoaded', async () => {
            // 저장된 위젯 상태 로드
            await loadWidgets();

            // 토글 이벤트
            document.getElementById('toggle-song').addEventListener('change', (e) => toggleWidget('song', e.target.checked));
            document.getElementById('toggle-speech').addEventListener('change', (e) => toggleWidget('speech', e.target.checked));
            document.getElementById('toggle-gift').addEventListener('change', (e) => toggleWidget('gift', e.target.checked));
            document.getElementById('toggle-moderator').addEventListener('change', (e) => toggleWidget('moderator', e.target.checked));
            document.getElementById('toggle-roulette').addEventListener('change', (e) => toggleWidget('roulette', e.target.checked));

            // URL 설정
            const userId = '<%= user._id %>';
            document.getElementById('overlay-url').value = `https://tikfind.kr/overlay/${userId}/unified`;
        });

        async function loadWidgets() {
            try {
                const res = await fetch('/api/overlay/positions');
                const data = await res.json();
                if (data.success && data.positions) {
                    // 표시/숨김 상태만 로드
                    Object.keys(defaultWidgets).forEach(key => {
                        widgets[key] = {
                            visible: data.positions[key] ? data.positions[key].visible : defaultWidgets[key].visible,
                            label: defaultWidgets[key].label
                        };
                    });
                } else {
                    widgets = { ...defaultWidgets };
                }
            } catch (e) {
                widgets = { ...defaultWidgets };
            }

            // 토글 체크박스 동기화
            Object.keys(widgets).forEach(key => {
                const checkbox = document.getElementById(`toggle-${key}`);
                if (checkbox) {
                    checkbox.checked = widgets[key].visible;
                }
            });
        }

        function toggleWidget(key, visible) {
            widgets[key].visible = visible;
        }

        async function savePositions() {
            try {
                const res = await fetch('/api/overlay/positions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ positions: widgets })
                });
                const data = await res.json();
                if (data.success) {
                    alert('저장되었습니다.');
                } else {
                    alert('저장 실패: ' + (data.message || '알 수 없는 오류'));
                }
            } catch (e) {
                alert('서버 오류가 발생했습니다.');
            }
        }

        function copyUrl() {
            const urlInput = document.getElementById('overlay-url');
            urlInput.select();
            document.execCommand('copy');
            alert('URL이 복사되었습니다.');
        }
    </script>
</body>
</html>
