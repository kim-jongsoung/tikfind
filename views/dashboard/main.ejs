    <script>
        // Desktop App 연결 - 토큰 방식 (tikfind://connect)
        async function connectDesktopApp() {
            const btn = document.getElementById('connectAppBtn');
            const status = document.getElementById('connectAppStatus');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 연결 중...';
            status.classList.remove('hidden');
            status.textContent = '앱 연결 토큰 생성 중...';
            try {
                const res = await fetch('/api/desktop/token', { method: 'POST' });
                const data = await res.json();
                if (!data.success) throw new Error('토큰 생성 실패');
                window.location.href = `tikfind://connect?token=${data.token}&server=https://tikfind.kr`;
                status.textContent = '✅ 앱이 열리면 자동으로 연결됩니다. 앱이 없으면 먼저 설치해주세요.';
                status.className = 'text-xs text-center mt-1 text-green-600';
            } catch (e) {
                status.textContent = '❌ 오류가 발생했습니다. 다시 시도해주세요.';
                status.className = 'text-xs text-center mt-1 text-red-500';
            } finally {
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-link"></i> 앱 연결하기 (설치 후 클릭)';
                }, 3000);
            }
        }

        // 구독 정지 함수
        function cancelSubscription() {
            if (confirm('구독을 정지하시겠습니까?\n\n다음 결제 예정일 전날까지 UNIVERSE 플랜을 계속 이용할 수 있으며, 결제일부터 FREE 플랜으로 자동 전환됩니다.')) {
                fetch('/api/subscription/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('구독 정지가 신청되었습니다.\n다음 결제 예정일 전날까지 UNIVERSE 플랜을 이용하실 수 있습니다.');
                        location.reload();
                    } else {
                        alert('오류: ' + (data.message || '구독 정지에 실패했습니다.'));
                    }
                })
                .catch(err => {
                    alert('서버 오류가 발생했습니다.');
                    console.error(err);
                });
            }
        }

        // 사용자 플랜 로드
        fetch('/api/user/plan')
            .then(res => res.json())
            .then(data => {
                const plan = (data.plan || 'free').toLowerCase();
                const status = data.subscriptionStatus || '';
                const isActive = status === 'active' || status === 'trial';

                const fmtDate = (d) => d ? new Date(d).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) : '-';

                document.getElementById('freePlanContent').classList.add('hidden');
                document.getElementById('universePlanContent').classList.add('hidden');
                document.getElementById('unlimitedPlanContent').classList.add('hidden');

                if (plan === 'unlimited' && isActive) {
                    document.getElementById('unlimitedPlanContent').classList.remove('hidden');
                    document.getElementById('subscriptionStartDateUnlimited').textContent = fmtDate(data.subscriptionStartDate);
                    document.getElementById('nextBillingDateUnlimited').textContent = fmtDate(data.nextBillingDate);
                } else if ((plan === 'universe' || plan === 'pro') && isActive) {
                    document.getElementById('universePlanContent').classList.remove('hidden');
                    document.getElementById('subscriptionStartDate').textContent = fmtDate(data.subscriptionStartDate);
                    document.getElementById('nextBillingDate').textContent = fmtDate(data.nextBillingDate);
                } else if (plan === 'universe' || plan === 'pro') {
                    // subscriptionStatus가 없거나 만료된 경우에도 plan 필드가 universe/pro면 표시
                    document.getElementById('universePlanContent').classList.remove('hidden');
                    document.getElementById('subscriptionStartDate').textContent = fmtDate(data.subscriptionStartDate);
                    document.getElementById('nextBillingDate').textContent = fmtDate(data.nextBillingDate);
                } else {
                    document.getElementById('freePlanContent').classList.remove('hidden');
                }
            })
            .catch(() => {
                document.getElementById('freePlanContent').classList.remove('hidden');
            });
    </script>
