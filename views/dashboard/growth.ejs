<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>알고리즘 확장 - TikFind</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .status-badge { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:9999px; font-size:11px; font-weight:700; }
        .status-pending  { background:#fef3c7; color:#92400e; }
        .status-followed { background:#d1fae5; color:#065f46; }
        .status-dm_sent  { background:#dbeafe; color:#1e40af; }
        .status-ignored  { background:#f3f4f6; color:#6b7280; }
        .tab-btn { border-bottom: 3px solid transparent; transition: all .2s; }
        .tab-btn.active { border-bottom-color: #10b981; color: #10b981; font-weight: 700; }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* UNLIMITED 잠금 레이어 */
        #unlimited-lock-layer {
            position: fixed;
            top: 88px; left: 256px; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(3px);
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #unlimited-lock-layer.hidden { display: none !important; }
    </style>
</head>
<body class="bg-gray-50">
    <div id="sidebar-container"></div>
    <div id="header-container"></div>

    <!-- UNLIMITED 전용 잠금 레이어 -->
    <div id="unlimited-lock-layer" class="hidden">
        <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #1e1b4b 100%); border: 1px solid rgba(251,191,36,0.35); border-radius: 24px; padding: 3rem 3.5rem; text-align: center; max-width: 480px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
            <div style="font-size: 3.5rem; margin-bottom: 1rem;">👑</div>
            <div style="display:inline-flex; align-items:center; gap:6px; background: linear-gradient(90deg,#fbbf24,#f59e0b); color:#1a1a1a; font-weight:800; font-size:13px; padding:4px 14px; border-radius:999px; margin-bottom:1.2rem; letter-spacing:0.05em;">UNLIMITED</div>
            <h2 style="color:#fff; font-size:1.5rem; font-weight:800; margin-bottom:0.6rem; line-height:1.3;">UNLIMITED 구독 시 제공됩니다</h2>
            <p style="color:#a5b4fc; font-size:0.9rem; line-height:1.7; margin-bottom:2rem;">알고리즘 확장 기능으로 비팔로워 시청자를 자동 수집하고<br>개인 DM으로 재방문을 유도하세요.<br>계정당 무제한 시청자 DB 및 AI 메시지 생성 포함.</p>
            <a href="/dashboard/billing" style="display:inline-flex; align-items:center; gap:8px; background: linear-gradient(135deg,#fbbf24,#f59e0b); color:#1a1a1a; font-weight:800; font-size:0.95rem; padding:0.85rem 2.2rem; border-radius:12px; text-decoration:none; transition:opacity .2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                <i class="fas fa-crown"></i> UNLIMITED 시작하기
            </a>
        </div>
    </div>

    <main class="ml-64 p-8" style="margin-top: 88px;">
        <div class="max-w-5xl mx-auto">

            <!-- 헤더 -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                    <i class="fas fa-rocket text-green-500"></i> 알고리즘 확장
                </h2>
                <p class="text-gray-500 mt-1 text-sm">방송에 방문한 비팔로워 시청자를 관리하고 팔로우·DM으로 알고리즘을 확장하세요</p>
            </div>

            <!-- 안내 박스 -->
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-start gap-3">
                <i class="fas fa-info-circle text-green-500 mt-0.5"></i>
                <div class="text-sm text-green-800">
                    <strong>작동 방식:</strong> 방송 중 채팅방에 입장한 <strong>비팔로워</strong> 시청자가 자동으로 수집됩니다.
                    이 목록에서 TikTok 프로필을 방문해 팔로우하거나, AI가 생성한 DM을 보내 재방문을 유도할 수 있습니다.
                </div>
            </div>

            <!-- 탭 -->
            <div class="bg-white rounded-xl shadow mb-6">
                <div class="flex border-b border-gray-200 px-2">
                    <button onclick="switchTab('viewers')" id="tab-viewers" class="tab-btn active px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-users text-green-500"></i> 시청자 목록
                        <span class="px-1.5 py-0.5 bg-green-100 text-green-700 text-xs rounded-full" id="totalBadge">0</span>
                    </button>
                    <button onclick="switchTab('templates')" id="tab-templates" class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-comment-dots text-indigo-500"></i> 메시지 템플릿
                    </button>
                </div>

                <!-- ══ 탭1: 시청자 목록 ══ -->
                <div id="panel-viewers" class="tab-panel active p-6">

                    <!-- 상태별 통계 배지 -->
                    <div class="flex flex-wrap gap-2 mb-4" id="statusStatsRow">
                        <button onclick="setStatusFilter('')" id="statAll" class="stat-chip active px-3 py-1.5 rounded-full text-xs font-semibold border transition">전체 <span id="statAllN">0</span></button>
                        <button onclick="setStatusFilter('pending')" id="statPending" class="stat-chip px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-amber-50 border-amber-200 text-amber-700">미처리 <span id="statPendingN">0</span></button>
                        <button onclick="setStatusFilter('followed')" id="statFollowed" class="stat-chip px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-emerald-50 border-emerald-200 text-emerald-700">✅ 팔로우됨 <span id="statFollowedN">0</span></button>
                        <button onclick="setStatusFilter('dm_sent')" id="statDm" class="stat-chip px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-blue-50 border-blue-200 text-blue-700">DM발송 <span id="statDmN">0</span></button>
                        <button onclick="setStatusFilter('ignored')" id="statIgnored" class="stat-chip px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-gray-100 border-gray-200 text-gray-500">무시 <span id="statIgnoredN">0</span></button>
                    </div>

                    <!-- 검색 필터 -->
                    <div class="bg-gray-50 rounded-xl p-4 mb-5 border border-gray-100">
                        <div class="flex flex-wrap gap-3 items-end">
                            <!-- 키워드 -->
                            <div class="flex-1 min-w-40">
                                <label class="block text-xs text-gray-500 mb-1 font-medium">닉네임/아이디 검색</label>
                                <div class="relative">
                                    <i class="fas fa-search absolute left-3 top-2.5 text-gray-400 text-xs"></i>
                                    <input type="text" id="filterKeyword" placeholder="검색어 입력..."
                                        class="w-full border border-gray-200 rounded-lg pl-8 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-400"
                                        onkeydown="if(event.key==='Enter') loadViewers()">
                                </div>
                            </div>
                            <!-- 방문횟수 -->
                            <div>
                                <label class="block text-xs text-gray-500 mb-1 font-medium">방문횟수</label>
                                <select id="filterMinVisit" class="border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white">
                                    <option value="">전체</option>
                                    <option value="2">2회 이상</option>
                                    <option value="3">3회 이상</option>
                                    <option value="5">5회 이상</option>
                                    <option value="10">10회 이상</option>
                                </select>
                            </div>
                            <!-- 날짜 -->
                            <div>
                                <label class="block text-xs text-gray-500 mb-1 font-medium">최근 방문 날짜</label>
                                <div class="flex items-center gap-1">
                                    <input type="date" id="filterFrom" class="border border-gray-200 rounded-lg px-2 py-2 text-sm">
                                    <span class="text-gray-400 text-xs">~</span>
                                    <input type="date" id="filterTo" class="border border-gray-200 rounded-lg px-2 py-2 text-sm">
                                </div>
                            </div>
                            <!-- 정렬 -->
                            <div>
                                <label class="block text-xs text-gray-500 mb-1 font-medium">정렬</label>
                                <select id="filterSort" class="border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white">
                                    <option value="lastSeenAt_desc">최근 방문순</option>
                                    <option value="visitCount_desc">방문 많은순</option>
                                    <option value="lastSeenAt_asc">오래된 방문순</option>
                                    <option value="firstSeenAt_asc">첫 방문순</option>
                                </select>
                            </div>
                            <!-- 버튼 -->
                            <div class="flex gap-2">
                                <button onclick="loadViewers()" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700 transition flex items-center gap-1">
                                    <i class="fas fa-search"></i> 검색
                                </button>
                                <button onclick="resetFilters()" class="px-3 py-2 border border-gray-200 text-gray-500 rounded-lg text-sm hover:bg-gray-100 transition">
                                    <i class="fas fa-undo"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 일괄 액션 바 (선택 시 노출) -->
                    <div id="bulkActionBar" class="hidden mb-4 p-3 bg-indigo-50 border border-indigo-200 rounded-xl flex items-center gap-3 flex-wrap">
                        <span class="text-sm font-semibold text-indigo-700"><span id="selectedCount">0</span>명 선택됨</span>
                        <select id="bulkStatus" class="border border-indigo-200 rounded-lg px-3 py-1.5 text-sm bg-white">
                            <option value="">상태 변경...</option>
                            <option value="followed">팔로우함</option>
                            <option value="dm_sent">DM발송</option>
                            <option value="ignored">무시</option>
                            <option value="pending">미처리로 초기화</option>
                        </select>
                        <button onclick="applyBulkStatus()" class="px-4 py-1.5 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition">적용</button>
                        <button onclick="clearSelection()" class="px-3 py-1.5 border border-indigo-200 text-indigo-600 rounded-lg text-sm hover:bg-indigo-100 transition">선택 해제</button>
                        <button onclick="generateAiMessages()" class="ml-auto px-4 py-1.5 bg-purple-600 text-white rounded-lg text-sm hover:bg-purple-700 transition flex items-center gap-1">
                            <i class="fas fa-magic"></i> AI 메시지 생성
                        </button>
                    </div>
                    <div id="topActionRow" class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="checkAll" onchange="toggleSelectAll(this)" class="w-4 h-4 rounded">
                            <label for="checkAll" class="text-xs text-gray-500 cursor-pointer">전체 선택</label>
                        </div>
                        <button onclick="generateAiMessages()" class="px-4 py-1.5 bg-purple-600 text-white rounded-lg text-sm hover:bg-purple-700 transition flex items-center gap-1">
                            <i class="fas fa-magic"></i> AI 메시지 생성
                        </button>
                    </div>

                    <!-- 시청자 테이블 -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-100 text-left">
                                    <th class="pb-3 w-8"><input type="checkbox" id="checkAll" onchange="toggleSelectAll(this)" class="w-4 h-4 rounded"></th>
                                    <th class="pb-3 text-xs font-semibold text-gray-500">닉네임 / 아이디</th>
                                    <th class="pb-3 text-xs font-semibold text-gray-500 text-center">방문</th>
                                    <th class="pb-3 text-xs font-semibold text-gray-500">최근 방문</th>
                                    <th class="pb-3 text-xs font-semibold text-gray-500">상태</th>
                                    <th class="pb-3 text-xs font-semibold text-gray-500 text-right">액션</th>
                                </tr>
                            </thead>
                            <tbody id="viewerTableBody">
                                <tr><td colspan="6" class="py-10 text-center text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>불러오는 중...</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 페이지네이션 -->
                    <div class="flex items-center justify-between mt-4">
                        <p class="text-xs text-gray-400" id="paginationInfo"></p>
                        <div class="flex gap-2" id="paginationBtns"></div>
                    </div>
                </div>

                <!-- ══ 탭2: 메시지 템플릿 ══ -->
                <div id="panel-templates" class="tab-panel p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700">저장된 메시지 템플릿</h4>
                            <p class="text-xs text-gray-400 mt-0.5">최대 10개까지 저장 가능. 복사 후 TikTok DM에 붙여넣으세요.</p>
                        </div>
                        <button onclick="openTemplateModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition flex items-center gap-1">
                            <i class="fas fa-plus"></i> 새 템플릿
                        </button>
                    </div>
                    <div id="templateList" class="space-y-3">
                        <div class="text-center py-8 text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>불러오는 중...</div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- AI 메시지 모달 -->
    <div id="aiModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-gray-800 flex items-center gap-2"><i class="fas fa-magic text-indigo-500"></i> AI 메시지 생성</h3>
                <button onclick="closeAiModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div id="aiMessageList" class="space-y-3 mb-4">
                <div class="text-center py-6 text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>AI가 메시지를 생성하고 있습니다...</div>
            </div>
            <p class="text-xs text-gray-400">복사 버튼을 눌러 TikTok DM에 붙여넣으세요. 템플릿으로 저장할 수도 있습니다.</p>
        </div>
    </div>

    <!-- 템플릿 편집 모달 -->
    <div id="templateModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-gray-800" id="templateModalTitle">새 템플릿</h3>
                <button onclick="closeTemplateModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <input type="hidden" id="editTemplateId">
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-500 mb-1">제목</label>
                <input type="text" id="templateTitle" maxlength="50" placeholder="예: 재방문 유도 메시지"
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
            </div>
            <div class="mb-4">
                <label class="block text-xs font-medium text-gray-500 mb-1">내용</label>
                <textarea id="templateContent" maxlength="500" rows="5" placeholder="메시지 내용을 입력하세요..."
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-indigo-400"></textarea>
                <p class="text-xs text-gray-400 mt-1 text-right"><span id="templateCharCount">0</span>/500</p>
            </div>
            <div class="flex justify-end gap-2">
                <button onclick="closeTemplateModal()" class="px-4 py-2 border border-gray-200 text-gray-600 rounded-lg text-sm hover:bg-gray-50 transition">취소</button>
                <button onclick="saveTemplate()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition flex items-center gap-1">
                    <i class="fas fa-save"></i> 저장
                </button>
            </div>
        </div>
    </div>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        let currentPage = 1;
        const PAGE_SIZE = 50;
        let selectedIds = new Set();
        let activeStatusFilter = '';

        // ── 탭 전환 ──
        function switchTab(name) {
            ['viewers', 'templates'].forEach(t => {
                document.getElementById('panel-' + t).classList.toggle('active', t === name);
                document.getElementById('tab-' + t).classList.toggle('active', t === name);
            });
            if (name === 'templates') loadTemplates();
        }

        // ── 상태 배지 필터 ──
        function setStatusFilter(val) {
            activeStatusFilter = val;
            // 배지 스타일 업데이트
            ['statAll','statPending','statFollowed','statDm','statIgnored'].forEach(id => {
                document.getElementById(id).classList.remove('ring-2','ring-offset-1','ring-green-400','font-bold');
            });
            const map = { '':'statAll', 'pending':'statPending', 'followed':'statFollowed', 'dm_sent':'statDm', 'ignored':'statIgnored' };
            const target = document.getElementById(map[val]);
            if (target) target.classList.add('ring-2','ring-offset-1','ring-green-400','font-bold');
            loadViewers();
        }

        // ── 필터 초기화 ──
        function resetFilters() {
            document.getElementById('filterKeyword').value = '';
            document.getElementById('filterMinVisit').value = '';
            document.getElementById('filterFrom').value = '';
            document.getElementById('filterTo').value = '';
            document.getElementById('filterSort').value = 'lastSeenAt_desc';
            activeStatusFilter = '';
            setStatusFilter('');
        }

        // ── 시청자 목록 로드 ──
        async function loadViewers(page = 1) {
            currentPage = page;
            clearSelection();

            const keyword  = document.getElementById('filterKeyword').value;
            const minVisit = document.getElementById('filterMinVisit').value;
            const dateFrom = document.getElementById('filterFrom').value;
            const dateTo   = document.getElementById('filterTo').value;
            const sort     = document.getElementById('filterSort').value;

            const params = new URLSearchParams({ page, limit: PAGE_SIZE, sort });
            if (activeStatusFilter) params.set('status', activeStatusFilter);
            if (keyword)  params.set('keyword', keyword);
            if (minVisit) params.set('minVisit', minVisit);
            if (dateFrom) params.set('dateFrom', dateFrom);
            if (dateTo)   params.set('dateTo', dateTo);

            const tbody = document.getElementById('viewerTableBody');
            tbody.innerHTML = '<tr><td colspan="6" class="py-10 text-center text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>불러오는 중...</td></tr>';

            try {
                const res = await fetch('/api/growth/viewers?' + params.toString());
                const data = await res.json();
                if (!data.success) throw new Error(data.message);

                document.getElementById('totalBadge').textContent = data.total;
                updateStatusStats(data.statusStats, data.total);
                renderViewers(data.viewers);
                renderPagination(data.total, page);
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-red-400">오류: ${e.message}</td></tr>`;
            }
        }

        function updateStatusStats(s, total) {
            document.getElementById('statAllN').textContent      = total;
            document.getElementById('statPendingN').textContent  = s.pending  || 0;
            document.getElementById('statFollowedN').textContent = s.followed || 0;
            document.getElementById('statDmN').textContent       = s.dm_sent  || 0;
            document.getElementById('statIgnoredN').textContent  = s.ignored  || 0;
        }

        function renderViewers(viewers) {
            const tbody = document.getElementById('viewerTableBody');
            if (!viewers.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-10 text-center text-gray-400">조건에 맞는 시청자가 없습니다.<br><span class="text-xs">방송을 시작하면 비팔로워 시청자가 자동 수집됩니다.</span></td></tr>';
                return;
            }
            tbody.innerHTML = viewers.map((v, i) => {
                const isFollowed = v.status === 'followed';
                const rowBg = isFollowed ? 'bg-emerald-50' : 'hover:bg-gray-50';
                const visitBadge = v.visitCount >= 5
                    ? `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold bg-red-100 text-red-700">${v.visitCount}</span>`
                    : v.visitCount >= 3
                    ? `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold bg-orange-100 text-orange-700">${v.visitCount}</span>`
                    : `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold bg-gray-100 text-gray-600">${v.visitCount}</span>`;

                return `
                <tr class="border-b border-gray-50 transition ${rowBg}" id="row-${v._id}">
                    <td class="py-3">
                        <input type="checkbox" class="viewer-check w-4 h-4 rounded" value="${v._id}"
                            onchange="onCheckChange(this)" ${selectedIds.has(v._id)?'checked':''}>
                    </td>
                    <td class="py-3">
                        <div class="flex items-center gap-2">
                            ${v.profilePictureUrl
                                ? `<img src="${v.profilePictureUrl}" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'">`
                                : `<div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-500 flex-shrink-0">${(v.nickname||v.uniqueId||'?')[0].toUpperCase()}</div>`}
                            <div>
                                <p class="font-medium text-gray-800 text-sm">${v.nickname || v.uniqueId}${isFollowed ? ' <span class="text-xs text-emerald-600">✅ 팔로워됨</span>' : ''}</p>
                                <p class="text-xs text-gray-400">@${v.uniqueId}</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-center">${visitBadge}</td>
                    <td class="py-3 text-xs text-gray-500 whitespace-nowrap">${formatDate(v.lastSeenAt)}</td>
                    <td class="py-3">
                        <select onchange="updateStatus('${v._id}', this.value)"
                            class="text-xs border border-gray-200 rounded-lg px-2 py-1 bg-white ${isFollowed?'border-emerald-200 text-emerald-700':''}">
                            <option value="pending"  ${v.status==='pending' ?'selected':''}>미처리</option>
                            <option value="followed" ${v.status==='followed'?'selected':''}>✅ 팔로우함</option>
                            <option value="dm_sent"  ${v.status==='dm_sent' ?'selected':''}>💬 DM발송</option>
                            <option value="ignored"  ${v.status==='ignored' ?'selected':''}>무시</option>
                        </select>
                    </td>
                    <td class="py-3 text-right">
                        <div class="flex items-center justify-end gap-1">
                            <a href="https://www.tiktok.com/@${v.uniqueId}" target="_blank"
                                class="px-3 py-1 bg-black text-white rounded-lg text-xs hover:bg-gray-800 transition flex items-center gap-1">
                                <i class="fab fa-tiktok"></i> 프로필
                            </a>
                            <button onclick="deleteViewer('${v._id}')" class="px-2 py-1 text-gray-300 hover:text-red-500 transition text-xs">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
            }).join('');
        }

        function renderPagination(total, page) {
            const totalPages = Math.ceil(total / PAGE_SIZE);
            document.getElementById('paginationInfo').textContent = `총 ${total}명 · ${page}/${totalPages} 페이지`;
            const btns = document.getElementById('paginationBtns');
            if (totalPages <= 1) { btns.innerHTML = ''; return; }
            let html = `<button onclick="loadViewers(${page-1})" ${page<=1?'disabled':''} class="px-3 py-1 border border-gray-200 rounded text-sm disabled:opacity-40 hover:bg-gray-50"><i class="fas fa-chevron-left"></i></button>`;
            const start = Math.max(1, page-2), end = Math.min(totalPages, page+2);
            for (let p = start; p <= end; p++) {
                html += `<button onclick="loadViewers(${p})" class="px-3 py-1 border rounded text-sm ${p===page?'bg-green-600 text-white border-green-600':'border-gray-200 hover:bg-gray-50'}">${p}</button>`;
            }
            html += `<button onclick="loadViewers(${page+1})" ${page>=totalPages?'disabled':''} class="px-3 py-1 border border-gray-200 rounded text-sm disabled:opacity-40 hover:bg-gray-50"><i class="fas fa-chevron-right"></i></button>`;
            btns.innerHTML = html;
        }

        async function updateStatus(id, status) {
            await fetch(`/api/growth/viewers/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
        }

        async function deleteViewer(id) {
            if (!confirm('이 시청자를 목록에서 삭제하시겠습니까?')) return;
            await fetch(`/api/growth/viewers/${id}`, { method: 'DELETE' });
            loadViewers(currentPage);
        }

        // ── 일괄 선택 ──
        function onCheckChange(cb) {
            if (cb.checked) selectedIds.add(cb.value);
            else selectedIds.delete(cb.value);
            updateBulkBar();
        }

        function toggleSelectAll(cb) {
            document.querySelectorAll('.viewer-check').forEach(c => {
                c.checked = cb.checked;
                if (cb.checked) selectedIds.add(c.value);
                else selectedIds.delete(c.value);
            });
            updateBulkBar();
        }

        function clearSelection() {
            selectedIds.clear();
            document.querySelectorAll('.viewer-check').forEach(c => c.checked = false);
            const ca = document.getElementById('checkAll');
            if (ca) ca.checked = false;
            updateBulkBar();
        }

        function updateBulkBar() {
            const bar = document.getElementById('bulkActionBar');
            document.getElementById('selectedCount').textContent = selectedIds.size;
            bar.classList.toggle('hidden', selectedIds.size === 0);
        }

        async function applyBulkStatus() {
            const status = document.getElementById('bulkStatus').value;
            if (!status) return alert('변경할 상태를 선택해주세요.');
            if (!selectedIds.size) return;
            const res = await fetch('/api/growth/viewers/bulk-status', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: [...selectedIds], status })
            });
            const data = await res.json();
            if (data.success) { clearSelection(); loadViewers(currentPage); }
            else alert(data.message);
        }

        // ── AI 메시지 생성 ──
        async function generateAiMessages() {
            document.getElementById('aiModal').classList.remove('hidden');
            document.getElementById('aiMessageList').innerHTML =
                '<div class="text-center py-6 text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>AI가 메시지를 생성하고 있습니다...</div>';
            try {
                const res = await fetch('/api/growth/ai-message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({})
                });
                const data = await res.json();
                if (!data.success) throw new Error(data.message);
                renderAiMessages(data.messages);
            } catch (e) {
                document.getElementById('aiMessageList').innerHTML = `<div class="text-center py-6 text-red-400">오류: ${e.message}</div>`;
            }
        }

        function renderAiMessages(messages) {
            document.getElementById('aiMessageList').innerHTML = messages.map((m, i) => {
                const safe = m.replace(/`/g,'\\`').replace(/\$/g,'\\$');
                return `
                <div class="p-3 bg-gray-50 rounded-xl border border-gray-200">
                    <p class="text-sm text-gray-700 whitespace-pre-wrap mb-2">${m.replace(/</g,'&lt;')}</p>
                    <div class="flex gap-2 justify-end">
                        <button onclick='copyText(this, ${JSON.stringify(m)})'
                            class="px-3 py-1 bg-gray-200 text-gray-700 rounded-lg text-xs hover:bg-gray-300 transition flex items-center gap-1">
                            <i class="fas fa-copy"></i> 복사
                        </button>
                        <button onclick='saveAsTemplate(${JSON.stringify(m)}, ${i+1})'
                            class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-lg text-xs hover:bg-indigo-200 transition flex items-center gap-1">
                            <i class="fas fa-save"></i> 템플릿 저장
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        function closeAiModal() { document.getElementById('aiModal').classList.add('hidden'); }

        async function saveAsTemplate(content, idx) {
            const res = await fetch('/api/growth/templates', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: `AI 생성 메시지 ${idx}`, content })
            });
            const data = await res.json();
            alert(data.success ? '템플릿에 저장됐습니다!' : data.message);
        }

        // ── 템플릿 관리 ──
        async function loadTemplates() {
            document.getElementById('templateList').innerHTML =
                '<div class="text-center py-8 text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>불러오는 중...</div>';
            const res = await fetch('/api/growth/templates');
            const data = await res.json();
            if (!data.success) return;
            renderTemplates(data.templates);
        }

        function renderTemplates(templates) {
            const el = document.getElementById('templateList');
            if (!templates.length) {
                el.innerHTML = `<div class="text-center py-10 text-gray-400">
                    <i class="fas fa-comment-slash text-3xl mb-3"></i><br>저장된 템플릿이 없습니다.<br>
                    <span class="text-xs">AI 메시지 생성 후 저장하거나 직접 추가하세요.</span></div>`;
                return;
            }
            el.innerHTML = templates.map(t => `
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1">
                            <p class="font-semibold text-sm text-gray-800 mb-1">${t.title}</p>
                            <p class="text-sm text-gray-600 whitespace-pre-wrap">${t.content.replace(/</g,'&lt;')}</p>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <button onclick='copyText(this, ${JSON.stringify(t.content)})'
                                class="px-3 py-1.5 bg-white border border-gray-200 text-gray-600 rounded-lg text-xs hover:bg-gray-100 transition flex items-center gap-1">
                                <i class="fas fa-copy"></i> 복사
                            </button>
                            <button onclick='openTemplateModal(${JSON.stringify(t._id)}, ${JSON.stringify(t.title)}, ${JSON.stringify(t.content)})'
                                class="px-3 py-1.5 bg-white border border-gray-200 text-gray-600 rounded-lg text-xs hover:bg-gray-100 transition">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button onclick="deleteTemplate('${t._id}')"
                                class="px-3 py-1.5 bg-white border border-gray-200 text-red-400 rounded-lg text-xs hover:bg-red-50 transition">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function openTemplateModal(id = '', title = '', content = '') {
            document.getElementById('editTemplateId').value = id;
            document.getElementById('templateTitle').value = title;
            document.getElementById('templateContent').value = content;
            document.getElementById('templateCharCount').textContent = content.length;
            document.getElementById('templateModalTitle').textContent = id ? '템플릿 수정' : '새 템플릿';
            document.getElementById('templateModal').classList.remove('hidden');
        }

        function closeTemplateModal() { document.getElementById('templateModal').classList.add('hidden'); }

        async function saveTemplate() {
            const id      = document.getElementById('editTemplateId').value;
            const title   = document.getElementById('templateTitle').value.trim();
            const content = document.getElementById('templateContent').value.trim();
            if (!title || !content) return alert('제목과 내용을 입력해주세요.');
            const res = await fetch(id ? `/api/growth/templates/${id}` : '/api/growth/templates', {
                method: id ? 'PATCH' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, content })
            });
            const data = await res.json();
            if (data.success) { closeTemplateModal(); loadTemplates(); }
            else alert(data.message);
        }

        async function deleteTemplate(id) {
            if (!confirm('이 템플릿을 삭제하시겠습니까?')) return;
            await fetch(`/api/growth/templates/${id}`, { method: 'DELETE' });
            loadTemplates();
        }

        // ── 유틸 ──
        function copyText(btn, text) {
            navigator.clipboard.writeText(text).then(() => {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.add('bg-green-100','text-green-700');
                setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('bg-green-100','text-green-700'); }, 2000);
            });
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            return `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
        }

        // ── 초기화 ──
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('templateContent').addEventListener('input', function() {
                document.getElementById('templateCharCount').textContent = this.value.length;
            });
            setStatusFilter('');
            loadViewers();

            // UNLIMITED 플랜 체크 - 아니면 잠금 레이어 표시
            fetch('/api/user/plan').then(r => r.json()).then(data => {
                if (!data.success || data.plan !== 'unlimited') {
                    document.getElementById('unlimited-lock-layer').classList.remove('hidden');
                }
            }).catch(() => {
                document.getElementById('unlimited-lock-layer').classList.remove('hidden');
            });
        });
    </script>
</body>
</html>
