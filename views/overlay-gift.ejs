<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Gift Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@700;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 100%;
            height: 100%;
            background: transparent;
            overflow: hidden;
            font-family: 'Noto Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
        }

        /* ── 화면 번쩍임 플래시 ── */
        #flash {
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            z-index: 10;
        }
        @keyframes flash-mid {
            0%   { opacity: 0.5; }
            25%  { opacity: 0; }
            40%  { opacity: 0.35; }
            70%  { opacity: 0; }
            100% { opacity: 0; }
        }
        @keyframes flash-mega {
            0%   { opacity: 0.65; }
            10%  { opacity: 0; }
            20%  { opacity: 0.55; }
            32%  { opacity: 0; }
            42%  { opacity: 0.45; }
            54%  { opacity: 0; }
            63%  { opacity: 0.3; }
            78%  { opacity: 0; }
            88%  { opacity: 0.15; }
            100% { opacity: 0; }
        }


        /* ── 파티클 ── */
        #particles { position:fixed; inset:0; pointer-events:none; overflow:hidden; }
        .pt { position:absolute; border-radius:50%; animation:pt-fly var(--d) ease-out forwards; }
        .st { position:absolute; animation:st-fly var(--d) ease-out forwards; }
        @keyframes pt-fly {
            0%   { transform:translate(0,0) scale(1); opacity:1; }
            100% { transform:translate(var(--tx),var(--ty)) scale(0); opacity:0; }
        }
        @keyframes st-fly {
            0%   { transform:translate(0,0) rotate(0deg) scale(1); opacity:1; }
            100% { transform:translate(var(--tx),var(--ty)) rotate(var(--r)) scale(0); opacity:0; }
        }

        /* ── 중앙 카드 ── */
        #gift-card {
            position: fixed;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            opacity: 0;
            pointer-events: none;
            width: 460px;
            max-width: 90vw;
            text-align: center;
        }
        @keyframes pop-mid {
            0%   { transform:translate(-50%,-50%) scale(0.45); opacity:0; }
            65%  { transform:translate(-50%,-50%) scale(1.05); opacity:1; }
            100% { transform:translate(-50%,-50%) scale(1);    opacity:1; }
        }
        @keyframes pop-mega {
            0%   { transform:translate(-50%,-50%) scale(0.3) rotate(-5deg); opacity:0; }
            55%  { transform:translate(-50%,-50%) scale(1.1)  rotate(2deg);  opacity:1; }
            100% { transform:translate(-50%,-50%) scale(1)    rotate(0deg);  opacity:1; }
        }
        @keyframes card-out {
            0%   { opacity:1; transform:translate(-50%,-50%) scale(1); }
            100% { opacity:0; transform:translate(-50%,-50%) scale(0.88); }
        }

        /* 닉네임 - 박스 없이 화면에 크게 */
        #card-nickname {
            font-size: 62px;
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -0.02em;
            word-break: keep-all;
            overflow-wrap: break-word;
            margin-bottom: 20px;
        }
        .mid-nick {
            color: #ffffff;
            text-shadow:
                0 0 30px rgba(168,85,247,1),
                0 0 60px rgba(168,85,247,0.6),
                0 4px 0 rgba(0,0,0,1);
        }
        .mega-nick {
            background: linear-gradient(135deg, #fff9c4 0%, #fde68a 25%, #f9d423 50%, #ff6b35 75%, #ff4e50 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 18px rgba(249,212,35,0.95)) drop-shadow(0 4px 0 rgba(0,0,0,1));
        }

        /* 유도문구 박스 */
        .card-inner {
            display: inline-block;
            border-radius: 50px;
            padding: 12px 28px;
            position: relative;
            overflow: hidden;
        }
        .mid-style {
            background: rgba(14,8,30,0.88);
            border: 1.5px solid rgba(168,85,247,0.65);
            box-shadow: 0 0 24px rgba(168,85,247,0.45), 0 8px 24px rgba(0,0,0,0.6);
        }
        .mega-style {
            background: rgba(10,4,22,0.88);
            border: 2px solid rgba(249,212,35,0.7);
            box-shadow: 0 0 28px rgba(249,212,35,0.45), 0 8px 24px rgba(0,0,0,0.7);
        }

        /* 광택 */
        .card-shine {
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,0.06) 50%, transparent 70%);
            animation: shine 2.8s ease-in-out infinite;
        }
        @keyframes shine { 0%{transform:translateX(-100%)} 100%{transform:translateX(200%)} }

        /* 유도 문구 */
        #card-label {
            font-size: 17px;
            font-weight: 900;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .mid-style  #card-label { color: #e9d5ff; }
        .mega-style #card-label { color: #fde68a; }

        /* 다이아 */
        #card-diamonds {
            margin-top: 10px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            opacity: 0.75;
        }
        .mid-style  #card-diamonds { color: #c4b5fd; }
        .mega-style #card-diamonds { color: #fde68a; }
    </style>
</head>
<body>

<div id="flash"></div>
<div id="particles"></div>
<div id="gift-card">
    <div id="card-nickname"></div>
    <div class="card-inner" id="card-inner">
        <div class="card-shine"></div>
        <div id="card-label"></div>
        <div id="card-diamonds"></div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const userId = '<%= userId %>';
    const socket = io();
    const queue = [];
    let busy = false;

    socket.emit('join-overlay', userId);
    socket.on('overlay-gift', d => { queue.push(d); if (!busy) next(); });

    function next() {
        if (!queue.length) { busy = false; return; }
        busy = true;
        show(queue.shift());
    }

    // ── 닉네임 안전 처리 ──
    function safeName(d) {
        const n = (d.nickname || '').trim() || (d.uniqueId || '').trim() || '익명';
        return n.length > 14 ? n.slice(0, 14) + '…' : n;
    }

    // ── 랜덤 문구 ──
    const midMsgs  = ['이름을 새기다 ✨','존재감 폭발 💥','빛나는 순간 🌟','화면을 물들이다 🎨','마음을 전하다 💌','이 순간의 주인공 🎬','함께해서 빛난다 🌈','당신이 특별하다 🫶','온기를 나누다 🔥','기억에 남을 이름 📍'];
    const megaMsgs = ['전설이 되다 👑','방송을 지배하다 💎','오늘의 주인공 🔥','레전드 등극 🏆','하늘을 찌르다 🚀','영원히 기억될 이름 ⚡','이 방송의 신 🌌','모두가 주목한다 👁️','압도적 존재감 💫','역사에 남을 순간 🎆'];
    function randMsg(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

    // ── 메인 표시 ──
    function show(d) {
        const name   = safeName(d);
        const isMega = (d.tier === 'mega') || ((d.totalDiamonds || 0) >= 1000);
        const dur    = isMega ? 6000 : 4500;

        const card   = document.getElementById('gift-card');
        const inner  = document.getElementById('card-inner');
        const lblEl  = document.getElementById('card-label');
        const nickEl = document.getElementById('card-nickname');
        const diaEl  = document.getElementById('card-diamonds');

        card.style.animation = 'none';
        card.style.opacity   = '0';
        void card.offsetWidth;

        inner.className  = 'card-inner ' + (isMega ? 'mega-style' : 'mid-style');
        nickEl.className   = isMega ? 'mega-nick' : 'mid-nick';
        lblEl.textContent  = randMsg(isMega ? megaMsgs : midMsgs);
        nickEl.textContent = name;
        diaEl.textContent  = (d.totalDiamonds > 0) ? '💎 ' + Number(d.totalDiamonds).toLocaleString() : '';

        // 화면 번쩍임
        flash(isMega);

        // 파티클
        spawnParticles(isMega);


        // 음향
        playSound(isMega);

        // 등장
        card.style.animation = (isMega ? 'pop-mega' : 'pop-mid') + ' 0.55s cubic-bezier(0.34,1.56,0.64,1) forwards';

        // 퇴장
        setTimeout(() => {
            card.style.animation = 'card-out 0.5s ease forwards';
            setTimeout(() => {
                card.style.animation = 'none';
                card.style.opacity   = '0';
                document.getElementById('particles').innerHTML = '';
                next();
            }, 520);
        }, dur);
    }

    // ── 화면 번쩍임 ──
    function flash(isMega) {
        const el = document.getElementById('flash');
        el.style.background = isMega ? '#f9d423' : '#a855f7';
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.animation = (isMega ? 'flash-mega' : 'flash-mid') + ' ' + (isMega ? '1.4s' : '0.9s') + ' ease forwards';
    }

    // ── 파티클 ──
    function spawnParticles(isMega) {
        const cnt = isMega ? 70 : 32;
        const cx  = window.innerWidth / 2;
        const cy  = window.innerHeight / 2;
        const con = document.getElementById('particles');
        const cols = isMega
            ? ['#f9d423','#ff4e50','#a855f7','#3b82f6','#10b981','#fbbf24','#ec4899','#fff']
            : ['#a855f7','#c084fc','#e879f9','#7c3aed','#ddd6fe','#fff'];
        const syms = ['✦','★','◆','✸','❋'];

        for (let i = 0; i < cnt; i++) {
            const ang  = (Math.PI * 2 * i / cnt) + Math.random() * 0.5;
            const dist = 100 + Math.random() * (isMega ? 320 : 200);
            const tx   = Math.cos(ang) * dist;
            const ty   = Math.sin(ang) * dist;
            const d    = (0.6 + Math.random() * 1.2).toFixed(2) + 's';
            const col  = cols[Math.floor(Math.random() * cols.length)];
            const el   = document.createElement('div');

            if (isMega && Math.random() > 0.42) {
                el.className = 'st';
                el.textContent = syms[Math.floor(Math.random() * syms.length)];
                el.style.cssText = `left:${cx+(Math.random()-0.5)*50}px;top:${cy+(Math.random()-0.5)*50}px;color:${col};font-size:${13+Math.random()*16}px;--tx:${tx}px;--ty:${ty}px;--d:${d};--r:${Math.random()*400}deg`;
            } else {
                const sz = 4 + Math.random() * (isMega ? 9 : 6);
                el.className = 'pt';
                el.style.cssText = `width:${sz}px;height:${sz}px;left:${cx+(Math.random()-0.5)*50}px;top:${cy+(Math.random()-0.5)*50}px;background:${col};box-shadow:0 0 ${sz*2}px ${col};--tx:${tx}px;--ty:${ty}px;--d:${d}`;
            }
            con.appendChild(el);
        }
    }

    // ── 음향 ──
    let actx = null;
    function getCtx() {
        if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
        return actx;
    }
    function playSound(isMega) { try { isMega ? fanfare() : chime(); } catch(e) {} }

    function chime() {
        const ctx = getCtx();
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
            const o = ctx.createOscillator(), g = ctx.createGain();
            o.connect(g); g.connect(ctx.destination);
            o.type = 'sine'; o.frequency.value = f;
            const t = ctx.currentTime + i * 0.14;
            g.gain.setValueAtTime(0, t);
            g.gain.linearRampToValueAtTime(0.28, t + 0.02);
            g.gain.exponentialRampToValueAtTime(0.001, t + 1.1);
            o.start(t); o.stop(t + 1.15);
        });
    }

    function fanfare() {
        const ctx = getCtx();
        const now = ctx.currentTime;

        // 1) 저음 붐
        const mkOsc = (type, freq, vol, start, end) => {
            const o = ctx.createOscillator(), g = ctx.createGain();
            o.connect(g); g.connect(ctx.destination);
            o.type = type; o.frequency.value = freq;
            g.gain.setValueAtTime(0, start);
            g.gain.linearRampToValueAtTime(vol, start + 0.025);
            g.gain.exponentialRampToValueAtTime(0.001, end);
            o.start(start); o.stop(end + 0.05);
        };
        mkOsc('sine',   65,  0.55, now,        now + 0.6);
        mkOsc('sine',   98,  0.35, now,        now + 0.4);

        // 2) 1차 멜로디 C-E-G-C6-E6
        [[523.25,0.10],[659.25,0.20],[783.99,0.30],[1046.5,0.40],[1318.51,0.50]]
            .forEach(([f, dt]) => mkOsc('triangle', f, 0.32, now+dt, now+dt+0.8));

        // 3) 2차 상승 G5-C6-E6-G6
        [[783.99,0.75],[1046.5,0.88],[1318.51,1.01],[1567.98,1.14]]
            .forEach(([f, dt]) => mkOsc('triangle', f, 0.28, now+dt, now+dt+0.75));

        // 4) 최고음 마무리 C7 화음
        [[2093,1.5],[1567.98,1.52],[1318.51,1.54]]
            .forEach(([f, dt]) => mkOsc('sine', f, 0.22, now+dt, now+dt+1.0));

        // 5) 반짝 스파클 (0.8초 후)
        setTimeout(() => {
            try {
                const c = getCtx();
                [1046.5,1318.51,1567.98,2093].forEach((f,i) => mkOsc('sine',f,0.18,c.currentTime+i*0.06,c.currentTime+i*0.06+0.6));
            } catch(e) {}
        }, 800);
    }

    // ── AudioContext ──
    document.addEventListener('click', () => { try { getCtx().resume(); } catch(e) {} }, { once: true });
    setTimeout(() => { try { getCtx(); } catch(e) {} }, 500);

    // ── 테스트 모드 ──
    const testParam = new URLSearchParams(location.search).get('test');
    if (testParam === 'mid' || testParam === 'mega') {
        const btn = document.createElement('div');
        btn.innerHTML = testParam === 'mega' ? '💎 MEGA 효과 테스트 (클릭)' : '🎁 중간 선물 효과 테스트 (클릭)';
        btn.style.cssText = 'position:fixed;bottom:28px;left:50%;transform:translateX(-50%);background:rgba(124,58,237,0.9);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:15px;font-weight:700;padding:13px 30px;border-radius:50px;cursor:pointer;z-index:9999;box-shadow:0 4px 24px rgba(124,58,237,0.6);pointer-events:auto;white-space:nowrap;';
        document.body.appendChild(btn);
        function runTest() {
            btn.remove();
            try { getCtx().resume(); } catch(e) {}
            queue.push({ nickname: testParam === 'mega' ? '박서준' : '김지유', uniqueId:'test', totalDiamonds: testParam==='mega'?1500:200, tier:testParam });
            if (!busy) next();
        }
        btn.addEventListener('click', runTest);
        setTimeout(() => { if (btn.parentNode) runTest(); }, 3000);
    }
</script>
</body>
</html>
