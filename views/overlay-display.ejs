<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Overlay</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: transparent;
            overflow: hidden;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        /* 마퀴 바 */
        .marquee-bar {
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            display: flex;
            align-items: stretch;
            border-radius: 9999px;
            gap: 0;
        }

        /* 뱃지 공통 */
        .song-badge {
            flex-shrink: 0;
            color: #fff;
            font-weight: 700;
            padding: 0 10px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 4px;
            border-right: 1px solid rgba(255,255,255,0.25);
        }

        /* 뱃지 3가지 색상 */
        .badge-now    { background: #16a34a; } /* 초록 - 현재곡 */
        .badge-next   { background: #2563eb; } /* 파랑 - 다음곡 */
        .badge-wait   { background: #7c3aed; } /* 보라 - 대기 */
        .badge-info   { background: rgba(0,0,0,0); } /* 투명 - 안내 */

        /* 마퀴 텍스트 영역 */
        .marquee-scroll-area {
            flex: 1;
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .marquee-track {
            display: inline-block;
            white-space: nowrap;
            animation: marquee-scroll 20s linear infinite;
            padding: 0 8px;
        }

        @keyframes marquee-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .marquee-text {
            display: inline;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        /* 신청방법 안내 깜빡이는 텍스트 */
        .blink-text {
            display: inline;
            font-weight: 400;
            text-shadow: 0 0 8px currentColor, 0 1px 2px rgba(0,0,0,0.9);
            animation: blink-color 1.2s ease-in-out infinite;
        }

        @keyframes blink-color {
            0%, 100% { color: #facc15; } /* 노랑 */
            50%      { color: #f97316; } /* 주황 */
        }
    </style>
</head>
<body>
    <div class="marquee-bar" id="marqueeBar">
        <div class="marquee-scroll-area" style="padding-left:14px;">
            <div class="marquee-track" id="marqueeTrack">
                <span class="marquee-text" id="marqueeText1"></span>
                <span style="display:inline;opacity:0.4;"> ✦ </span>
                <span class="marquee-text" id="marqueeText2"></span>
                <span style="display:inline;opacity:0.4;"> ✦ </span>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const userId = '<%= userId %>';
        const socket = io();

        // URL 파라미터
        const params   = new URLSearchParams(location.search);
        const bgColor  = decodeURIComponent(params.get('bg')    || 'rgba(0,0,0,0.55)');
        const txtColor = params.get('color') || '#ffffff';
        const fontSize = params.get('size')  || '16';
        const speed    = parseFloat(params.get('speed') || '1.0');

        const bar   = document.getElementById('marqueeBar');
        const track = document.getElementById('marqueeTrack');

        const fSize = parseInt(fontSize);
        const barH  = Math.round(fSize * 1.8) + 'px';

        bar.style.background  = bgColor;
        bar.style.color       = txtColor;
        bar.style.fontSize    = fSize + 'px';
        bar.style.height      = barH;
        bar.style.lineHeight  = barH;

        function setSpeed(text) {
            const base = Math.max(12, text.length * 0.3);
            track.style.animationDuration = (base / speed) + 's';
        }

        let currentSong = null;
        let nextQueue   = [];

        // 뱃지 색상 + 라벨 업데이트
        const BADGE_NOW  = '#16a34a'; // 초록
        const BADGE_NEXT = '#2563eb'; // 파랑
        const BADGE_WAIT = '#7c3aed'; // 보라

        function updateBadge() {
            // 좌측 뱃지 제거됨 - 아무것도 하지 않음
        }

        function songLabel(song) {
            if (!song) return '';
            let label = song.title;
            if (song.artist)    label += ' - ' + song.artist;
            const who = song.requesterNickname || song.requester;
            if (who) label += '  @' + who;
            return label;
        }

        // HTML 포함 마퀴 텍스트 빌드
        function buildText() {
            updateBadge();

            let parts = [];

            if (currentSong) {
                parts.push(
                    '<span style="display:inline;background:' + BADGE_NOW + ';color:#fff;padding:1px 6px;border-radius:3px;font-weight:700;font-size:0.85em;">▶ 현재곡</span> '
                    + songLabel(currentSong)
                );
            }
            if (nextQueue.length > 0) {
                parts.push(
                    '<span style="display:inline;background:' + BADGE_NEXT + ';color:#fff;padding:1px 6px;border-radius:3px;font-weight:700;font-size:0.85em;">⏭ 다음곡</span> '
                    + songLabel(nextQueue[0])
                );
            }
            nextQueue.slice(1, 3).forEach((s, i) => {
                parts.push(
                    '<span style="display:inline;background:' + BADGE_WAIT + ';color:#fff;padding:1px 6px;border-radius:3px;font-weight:700;font-size:0.85em;">🎶 대기' + (i + 1) + '</span> '
                    + songLabel(s)
                );
            });

            // 신청방법 안내 - 깜빡이는 텍스트
            const guideHtml =
                '<span class="blink-text">팔로우·팀가입 후</span>'
                + ' <span style="color:#fff;font-weight:400;text-shadow:0 0 8px rgba(255,255,255,0.8),0 1px 2px rgba(0,0,0,0.9);">#노래제목 #가수명</span>'
                + ' <span class="blink-text">음악신청 가능!</span>';

            parts.push(guideHtml);

            const sep = ' <span style="opacity:0.4"> ✦ </span> ';
            const full = parts.join(sep) + sep;

            document.getElementById('marqueeText1').innerHTML = full;
            document.getElementById('marqueeText2').innerHTML = full;
            setSpeed(full.replace(/<[^>]+>/g, ''));
        }

        // 초기 안내 표시
        buildText();

        socket.emit('join-overlay', userId);

        socket.on('current-song', (data) => {
            currentSong = (data && data.title) ? data : null;
            buildText();
        });

        socket.on('song-queue', (queue) => {
            const all = queue || [];
            if (currentSong) {
                nextQueue = all.filter(s =>
                    !(s.title === currentSong.title && s.requester === currentSong.requester)
                );
            } else {
                nextQueue = all;
            }
            buildText();
        });
    </script>
</body>
</html>
