                                        onkeydown="if(event.key==='Enter') addNotice()">
                                    <span class="absolute right-3 top-2.5 text-xs text-gray-400" id="noticeCharCount">0/50</span>
                                </div>
                                <button onclick="addNotice()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition flex items-center gap-1">
                                    <i class="fas fa-plus"></i> 추가
                                </button>
                            </div>
                            <!-- 공지 목록 -->
                            <div id="noticeList" class="space-y-2">
                                <div class="text-center py-4 text-gray-400 text-sm"><i class="fas fa-spinner fa-spin mr-1"></i>불러오는 중...</div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ══════════════════════════════════
                     탭 4: 번역 자막 위젯
                ══════════════════════════════════ -->
                <div id="panel-speech" class="tab-panel p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-5 p-4 bg-green-50 rounded-xl border border-green-100">
                        <div class="text-3xl">🌐</div>
                        <div>
                            <p class="font-semibold text-green-800 text-sm">실시간 번역 자막 위젯이란?</p>
                            <p class="text-xs text-green-600 mt-1 leading-relaxed">
                                라이브 방송 중 음성을 인식해 방송 화면에 자동 번역 자막이 표시됩니다.<br>
                                <strong>별도 프로그램 설치 불필요</strong> · 말하는 즉시 선택한 언어로 자막 표시
                            </p>
                        </div>
                    </div>

                    <!-- 언어 선택 -->
                    <div class="mb-5 p-4 bg-white border border-gray-200 rounded-xl">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-globe text-green-500"></i> 번역 언어 선택
                            <span class="text-xs text-gray-400 font-normal">최대 2개</span>
                        </h4>
                        <div class="grid grid-cols-3 gap-2 mb-4" id="langCheckboxes">
                            <% [
                                {code:'en', label:'🇺🇸 영어 (English)'},
                                {code:'ja', label:'🇯🇵 일본어 (日本語)'},
                                {code:'zh', label:'🇨🇳 중국어 (中文)'},
                                {code:'es', label:'🇪🇸 스페인어'},
                                {code:'fr', label:'🇫🇷 프랑스어'},
                                {code:'de', label:'🇩🇪 독일어'},
                                {code:'th', label:'🇹🇭 태국어'},
                                {code:'vi', label:'🇻🇳 베트남어'},
                                {code:'id', label:'🇮🇩 인도네시아어'}
                            ].forEach(function(l){ %>
                            <label class="flex items-center gap-2 p-2.5 border border-gray-200 rounded-lg cursor-pointer hover:bg-green-50 hover:border-green-300 transition lang-label" data-code="<%= l.code %>">
                                <input type="checkbox" class="lang-check" value="<%= l.code %>" onchange="onLangChange()">
                                <span class="text-sm text-gray-700"><%= l.label %></span>
                            </label>
                            <% }); %>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs text-gray-400" id="langCountMsg">0개 선택됨</p>
                            <button onclick="saveSpeechSettings()"
                                class="px-5 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm flex items-center gap-2" id="saveSpeechBtn">
                                <i class="fas fa-save"></i> 저장
                            </button>
                        </div>
                    </div>

                    <!-- 미리보기 -->
                    <div class="flex flex-wrap gap-3 mb-5">
                        <a href="/overlay/<%= user._id %>/speech?test=1" target="_blank"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 text-green-700 rounded-lg hover:bg-green-100 transition text-sm font-semibold">
                            <i class="fas fa-eye"></i> 번역 자막 미리보기
                        </a>
                    </div>

                </div>

                <!-- ══════════════════════════════════
                     탭 5: 룰렛 미션 위젯
                ══════════════════════════════════ -->
                <div id="panel-roulette" class="tab-panel p-6">

                    <!-- 설명 -->
                    <div class="flex items-start gap-4 mb-5 p-4 bg-yellow-50 rounded-xl border border-yellow-200">
                        <div class="text-3xl">🎰</div>
                        <div>
                            <p class="font-semibold text-yellow-800 text-sm">⚔️ 매치승리 룰렛미션이란?</p>
                            <p class="text-xs text-yellow-700 mt-1 leading-relaxed">
                                TikTok 매치에서 이겼을 때 대시보드의 <strong>🎰 룰렛 돌리기!</strong> 버튼을 누르면<br>
                                방송 화면 왼쪽에 반원형 룰렛이 나타나 랜덤으로 미션을 추첨합니다.<br>
                                <strong>시청자들이 미션 결과를 함께 기대하며 방송이 더 재미있어집니다!</strong>
                            </p>
                        </div>
                    </div>

                    <!-- 미션 목록 (10개 고정, 매번 랜덤 5개 사용) -->
