<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Chat Gradient Overlay</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 1080px;
            height: 640px;
            background: transparent;
            overflow: hidden;
        }
        #gradient-container {
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 100%);
        }
    </style>
</head>
<body>
<div id="gradient-container"></div>

<script>
    const params = new URLSearchParams(window.location.search);
    const color = params.get('color') || 'black';

    const colorMap = {
        black: 'rgba(0,0,0,0.4)',
        blue: 'rgba(0,0,50,0.4)',
        purple: 'rgba(50,0,50,0.4)',
        red: 'rgba(50,0,0,0.4)',
        green: 'rgba(0,50,0,0.4)',
        orange: 'rgba(50,25,0,0.4)',
        pink: 'rgba(50,0,25,0.4)',
        cyan: 'rgba(0,50,50,0.4)'
    };

    const container = document.getElementById('gradient-container');
    const targetColor = colorMap[color] || colorMap.black;
    container.style.background = `linear-gradient(to bottom, rgba(0,0,0,0) 0%, ${targetColor} 100%)`;
</script>
</body>
</html>
