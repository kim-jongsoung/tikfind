<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오버레이 설정 - TikFind</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .mq-outer { background:#1f2937; border-radius:8px; padding:8px; }
        .mq-bar { width:100%; overflow:hidden; white-space:nowrap; display:flex; align-items:stretch; border-radius:4px; }
        .mq-badge { flex-shrink:0; color:#fff; font-weight:700; padding:0 10px; display:flex; align-items:center; gap:4px; border-right:1px solid rgba(255,255,255,0.2); }
        .mq-scroll { flex:1; overflow:hidden; display:flex; align-items:center; }
        .mq-track { display:inline-block; white-space:nowrap; animation:mq 14s linear infinite; padding:0 8px; }
        @keyframes mq { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
    </style>
</head>
<body class="bg-gray-50">
    <div id="sidebar-container"></div>
    <div id="header-container"></div>
    
    <main class="ml-64 p-8" style="margin-top: 88px;">
        <div class="max-w-3xl mx-auto">
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-800">🎵 오버레이 설정</h2>
                <p class="text-gray-500 mt-1 text-sm">TikTok Live Studio 브라우저 소스에 추가하세요</p>
            </div>

            <!-- URL 카드 -->
            <div class="bg-white rounded-xl shadow p-6 mb-5">
                <h3 class="font-semibold text-gray-700 mb-3 flex items-center gap-2">
                    <i class="fas fa-link text-indigo-500"></i> 오버레이 URL
                </h3>
                <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-3">
                    <code class="text-sm text-gray-700 flex-1 break-all" id="baseUrl">https://tikfind.kr/overlay/<%= user._id %></code>
                    <button onclick="copyUrl('baseUrl','copyBtn')" id="copyBtn"
                        class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm whitespace-nowrap">
                        <i class="fas fa-copy mr-1"></i>복사
                    </button>
                </div>
            </div>

            <!-- 스타일 설정 카드 -->
            <div class="bg-white rounded-xl shadow p-6 mb-5">
                <h3 class="font-semibold text-gray-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-palette text-purple-500"></i> 스타일 설정
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-2">배경색 &amp; 투명도</label>
                        <div class="flex items-center gap-3">
                            <input type="color" id="bgColor" value="#000000"
                                class="w-10 h-10 rounded cursor-pointer border border-gray-200" oninput="updateAll()">
                            <div class="flex-1">
                                <input type="range" id="bgOpacity" min="0" max="100" value="55"
                                    class="w-full" oninput="updateAll()">
                                <div class="flex justify-between text-xs text-gray-400 mt-0.5">
                                    <span>투명</span><span id="opacityLabel">55%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-2">글자색</label>
                        <input type="color" id="txtColor" value="#ffffff"
                            class="w-10 h-10 rounded cursor-pointer border border-gray-200" oninput="updateAll()">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-2">
                            글자크기: <span id="sizeLabel">16</span>px
                        </label>
                        <input type="range" id="fontSize" min="12" max="36" value="16"
                            class="w-full"
                            oninput="document.getElementById('sizeLabel').textContent=this.value; updateAll()">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-2">
                            흐르는 속도: <span id="speedLabel">1.0</span>x
                        </label>
                        <input type="range" id="mqSpeed" min="0.3" max="3.0" step="0.1" value="1.0"
                            class="w-full"
                            oninput="document.getElementById('speedLabel').textContent=parseFloat(this.value).toFixed(1); updateAll()">
                        <div class="flex justify-between text-xs text-gray-400 mt-0.5">
                            <span>느림</span><span>빠름</span>
                        </div>
                    </div>
                </div>
                <div class="mt-5 flex justify-end">
                    <button onclick="saveSettings()"
                        class="px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm flex items-center gap-2">
                        <i class="fas fa-save"></i> 설정 저장
                    </button>
                </div>
            </div>

            <!-- 미리보기 카드 -->
            <div class="bg-white rounded-xl shadow p-6 mb-5">
                <h3 class="font-semibold text-gray-700 mb-3 flex items-center gap-2">
                    <i class="fas fa-eye text-green-500"></i> 미리보기
                </h3>
                <div class="mq-outer">
                    <div class="mq-bar" id="previewBar" style="background:rgba(0,0,0,0.55);color:#fff;font-size:16px;height:29px;line-height:29px;">
                        <span class="mq-badge" id="previewBadge" style="background:rgba(0,0,0,0.55);font-size:16px;">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
                            신청곡
                        </span>
                        <div class="mq-scroll">
                            <div class="mq-track">
                                <span id="previewText" style="font-family:'Malgun Gothic',sans-serif;font-weight:600;">▶ 현재곡 비처럼 음악처럼 - 김현식 ✦ ⏭ 다음곡 비와 당신 - 안치환 ✦ 💬 #노래제목 #가수명 으로 신청하세요 ✦ </span>
                                <span style="font-family:'Malgun Gothic',sans-serif;font-weight:600;">▶ 현재곡 비처럼 음악처럼 - 김현식 ✦ ⏭ 다음곡 빈와 당신 - 안치환 ✦ 💬 #노래제목 #가수명 으로 신청하세요 ✦ </span>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mt-2">* 실제 방송에서는 현재 재생 중인 곡과 다음 곡이 자동으로 표시됩니다.</p>
            </div>

            <!-- 설정 적용된 URL + TikTok Live Studio 안내 카드 -->
            <div class="bg-white rounded-xl shadow p-6">
                <h3 class="font-semibold text-gray-700 mb-3 flex items-center gap-2">
                    <i class="fas fa-code text-gray-500"></i> 설정 적용된 URL
                </h3>
                <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-3 mb-4">
                    <code class="text-xs text-gray-600 flex-1 break-all" id="finalUrl">https://tikfind.kr/overlay/<%= user._id %></code>
                    <button onclick="copyUrl('finalUrl','copyFinalBtn')" id="copyFinalBtn"
                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm whitespace-nowrap">
                        <i class="fas fa-copy mr-1"></i>복사
                    </button>
                </div>
                <div class="mb-4">
                    <a href="/overlay/<%= user._id %>" target="_blank" id="previewLink"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 text-indigo-700 rounded-lg hover:bg-indigo-100 transition text-sm">
                        <i class="fas fa-external-link-alt"></i> 새 창에서 미리보기
                    </a>
                </div>

                <!-- TikTok Live Studio 설정 안내 -->
                <div class="border-t border-gray-100 pt-4">
                    <h4 class="font-semibold text-gray-700 mb-3 flex items-center gap-2 text-sm">
                        <i class="fas fa-tv text-pink-500"></i> TikTok Live Studio 소스 추가 방법
                    </h4>
                    <ol class="space-y-3">
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 bg-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold">1</span>
                            <div class="text-sm text-gray-600">
                                TikTok Live Studio 실행 후 <strong class="text-gray-800">소스 패널</strong>에서 <strong class="text-gray-800">+ 추가</strong> 클릭
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 bg-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold">2</span>
                            <div class="text-sm text-gray-600">
                                <strong class="text-gray-800">URL</strong> 소스 선택
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 bg-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold">3</span>
                            <div class="text-sm text-gray-600">
                                URL 입력란에 위 <strong class="text-gray-800">설정 적용된 URL</strong> 붙여넣기
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 bg-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold">4</span>
                            <div class="text-sm text-gray-600">
                                <strong class="text-gray-800">사용자 지정 해상도</strong> 설정:
                                <span class="inline-flex items-center gap-1 ml-1 px-2 py-0.5 bg-gray-100 rounded text-xs font-mono font-bold text-gray-700">너비 400 × 높이 100</span>
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 bg-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold">5</span>
                            <div class="text-sm text-gray-600">
                                확인 후 화면에서 <strong class="text-gray-800">크기와 위치</strong>를 드래그로 자유롭게 조절하세요
                            </div>
                        </li>
                    </ol>
                    <div class="mt-4 p-3 bg-pink-50 border-l-4 border-pink-400 rounded text-xs text-pink-700">
                        <i class="fas fa-lightbulb mr-1"></i>
                        <strong>팁:</strong> 해상도를 400×100으로 설정한 뒤, 화면에서 소스를 선택하고 모서리를 드래그해 원하는 크기로 조절하세요. 배경 투명도는 위 스타일 설정에서 조절할 수 있습니다.
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        const BASE_URL = 'https://tikfind.kr/overlay/<%= user._id %>';

        function hexToRgba(hex, alpha) {
            const r = parseInt(hex.slice(1,3), 16);
            const g = parseInt(hex.slice(3,5), 16);
            const b = parseInt(hex.slice(5,7), 16);
            return `rgba(${r},${g},${b},${alpha})`;
        }

        function copyUrl(elId, btnId) {
            const text = document.getElementById(elId).textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById(btnId);
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>복사됨!';
                btn.classList.replace('bg-indigo-600','bg-green-600');
                btn.classList.replace('hover:bg-indigo-700','hover:bg-green-700');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.replace('bg-green-600','bg-indigo-600');
                    btn.classList.replace('hover:bg-green-700','hover:bg-indigo-700');
                }, 2000);
            });
        }

        const STORAGE_KEY = 'overlaySettings_<%= user._id %>';

        function saveSettings() {
            const s = {
                bgColor:   document.getElementById('bgColor').value,
                bgOpacity: document.getElementById('bgOpacity').value,
                txtColor:  document.getElementById('txtColor').value,
                fontSize:  document.getElementById('fontSize').value,
                mqSpeed:   document.getElementById('mqSpeed').value
            };
            localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
            const btn = event.currentTarget;
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
            btn.classList.replace('bg-indigo-600','bg-green-600');
            btn.classList.replace('hover:bg-indigo-700','hover:bg-green-700');
            setTimeout(() => {
                btn.innerHTML = orig;
                btn.classList.replace('bg-green-600','bg-indigo-600');
                btn.classList.replace('hover:bg-green-700','hover:bg-indigo-700');
            }, 2000);
        }

        function loadSettings() {
            try {
                const s = JSON.parse(localStorage.getItem(STORAGE_KEY));
                if (!s) return;
                if (s.bgColor)   document.getElementById('bgColor').value   = s.bgColor;
                if (s.bgOpacity) document.getElementById('bgOpacity').value = s.bgOpacity;
                if (s.txtColor)  document.getElementById('txtColor').value  = s.txtColor;
                if (s.fontSize) {
                    document.getElementById('fontSize').value = s.fontSize;
                    document.getElementById('sizeLabel').textContent = s.fontSize;
                }
                if (s.mqSpeed) {
                    document.getElementById('mqSpeed').value = s.mqSpeed;
                    document.getElementById('speedLabel').textContent = parseFloat(s.mqSpeed).toFixed(1);
                }
            } catch(e) {}
        }

        // 미리보기 마퀴 속도 반영
        function applyPreviewSpeed() {
            const speed = parseFloat(document.getElementById('mqSpeed').value);
            const text  = document.getElementById('previewText').textContent;
            const base  = Math.max(10, text.length * 0.35);
            const dur   = base / speed;
            document.querySelector('.mq-track').style.animationDuration = dur + 's';
        }

        function updateAll() {
            const hex     = document.getElementById('bgColor').value;
            const opacity = parseInt(document.getElementById('bgOpacity').value);
            const color   = document.getElementById('txtColor').value;
            const size    = parseInt(document.getElementById('fontSize').value);
            const speed   = parseFloat(document.getElementById('mqSpeed').value);

            document.getElementById('opacityLabel').textContent = opacity + '%';

            const alpha = (opacity / 100).toFixed(2);
            const bg    = hexToRgba(hex, alpha);

            const bar = document.getElementById('previewBar');
            const barH = Math.round(size * 1.8) + 'px';
            bar.style.background = bg;
            bar.style.color      = color;
            bar.style.fontSize   = size + 'px';
            bar.style.height     = barH;
            bar.style.lineHeight = barH;
            // 뱃지 배경색 동일, 글자 크기 동일
            const badge = document.getElementById('previewBadge');
            badge.style.background = bg;
            badge.style.fontSize   = size + 'px';

            applyPreviewSpeed();

            const p = new URLSearchParams();
            p.set('bg',    encodeURIComponent(bg));
            p.set('color', color);
            p.set('size',  size);
            p.set('speed', speed.toFixed(1));
            const finalUrl = BASE_URL + '?' + p.toString();

            document.getElementById('finalUrl').textContent = finalUrl;
            document.getElementById('previewLink').href = '/overlay/<%= user._id %>?' + p.toString();
        }

        // 초기 실행
        loadSettings();
        updateAll();
    </script>
</body>
</html>
