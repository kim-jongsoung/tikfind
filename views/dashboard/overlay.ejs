                        <div class="mb-4">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" id="aiCompanionEnabled" class="w-5 h-5 text-teal-600 rounded">
                                <span class="text-sm font-semibold text-gray-700">AI 시청자 활성화</span>
                            </label>
                            <p class="text-xs text-red-500 mt-2">⚠️ GPT API 비용이 발생합니다. 필요할 때만 활성화하세요.</p>
                        </div>

                        <!-- AI 이름 -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">AI 이름</label>
                            <input type="text" id="aiCompanionName" value="TikFind AI" 
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm"
                                placeholder="예: 민지, AI친구, 도우미봇">
                            <p class="text-xs text-gray-500 mt-1">시청자들이 이 이름으로 AI에게 질문하거나 안부를 물을 수 있어요</p>
                        </div>

                        <!-- AI 성격 -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">AI 성격</label>
                            <select id="aiCompanionPersonality" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm">
                                <option value="친근한">친근한 (따뜻하고 공감적)</option>
                                <option value="장난스러운">장난스러운 (유쾌하고 밝은)</option>
                                <option value="진지한">진지한 (신중하고 정중한)</option>
                                <option value="4차원">4차원 (독특하고 엉뚱한)</option>
                            </select>
                        </div>

                        <!-- 참여 빈도 -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">참여 빈도</label>
                            <select id="aiCompanionFrequency" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm">
                                <option value="가끔">가끔 (조용하게)</option>
                                <option value="보통" selected>보통 (적당하게)</option>
                                <option value="자주">자주 (활발하게)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 저장 버튼 -->
                    <button onclick="saveAICompanionSettings()" 
                        class="w-full px-6 py-3 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition font-semibold">
                        <i class="fas fa-save mr-2"></i>설정 저장
                    </button>

                    <!-- 참여 예시 -->
                    <div class="mt-6 p-4 bg-gray-50 rounded-xl border border-gray-200">
                        <h4 class="font-semibold text-gray-800 mb-2 text-sm">AI가 참여하는 경우</h4>
                        <ul class="text-xs text-gray-600 space-y-1">
                            <li>• 새로운 시청자 입장 시 환영 인사</li>
                            <li>• 호스트나 시청자의 질문에 답변</li>
                            <li>• 감정 표현에 공감 및 위로</li>
                            <li>• 대화 주제에 자연스럽게 참여</li>
                            <li>• 조용할 때는 참여하지 않음 (뜬금없는 발언 방지)</li>
                        </ul>
                    </div>
                </div>

        </div>
    </main>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ── 탭 전환 ──
        function switchTab(name) {
            ['gift','song','mod','level50','speech','roulette','match','chatGradient','aiCompanion'].forEach(t => {
                document.getElementById('panel-' + t).classList.toggle('active', t === name);
                const btn = document.getElementById('tab-' + t);
                btn.classList.remove('active', 'active-purple', 'active-blue', 'active-cyan', 'active-green', 'active-orange', 'active-pink', 'active-teal');
                if (t === name) {
                    if (name === 'gift')     btn.classList.add('active-purple');
                    else if (name === 'mod')      btn.classList.add('active-blue');
                    else if (name === 'level50')  btn.classList.add('active-cyan');
                    else if (name === 'speech')   btn.classList.add('active-green');
                    else if (name === 'match')    btn.classList.add('active-orange');
                    else if (name === 'chatGradient') btn.classList.add('active-pink');
                    else if (name === 'aiCompanion') btn.classList.add('active-teal');
                    else btn.classList.add('active');
                }
            });
            if (name === 'song')   loadNotices();
            if (name === 'gift')   loadGiftSettings();
            if (name === 'mod')    loadModerators();
            if (name === 'level50') loadLevel50Viewers();
            if (name === 'speech') loadSpeechSettings();
            if (name === 'match')  loadMatchCoachSettings();
            if (name === 'chatGradient') loadChatGradientSettings();
            if (name === 'aiCompanion') loadAICompanionSettings();
        }

        function saveRouletteItems() {
            const inputs = document.querySelectorAll('.roulette-item-input');
            const items = Array.from(inputs).map(inp => ({
                label: inp.value.trim() || inp.defaultValue,
                color: inp.dataset.color
            }));
            const userId = '<%= user._id %>';
            // 소켓으로 오버레이에 직접 전달 (서버를 통해 relay)
            fetch('/api/roulette-items', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId, items })
            }).then(r => r.json()).then(data => {
                const btn = document.getElementById('saveRouletteItemsBtn');
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> 적용됨!';
                    btn.classList.replace('bg-yellow-500','bg-green-500');
                    btn.classList.replace('hover:bg-yellow-600','hover:bg-green-600');
                    setTimeout(() => {
                        btn.innerHTML = '<i class="fas fa-save"></i> 저장 &amp; 적용';
                        btn.classList.replace('bg-green-500','bg-yellow-500');
                        btn.classList.replace('hover:bg-green-600','hover:bg-yellow-600');
                    }, 2000);
                } else {
                    alert('저장 실패');
                }
            }).catch(() => alert('오류가 발생했습니다.'));
        }

        // ── 선물 다이아 기준 저장 ──
        async function saveGiftSettings(event) {
            const midMin  = parseInt(document.getElementById('midMin').value)  || 0;
            const megaMin = parseInt(document.getElementById('megaMin').value) || 0;
            const btn = document.getElementById('saveGiftBtn');
            const orig = btn.innerHTML;
            try {
                const res = await fetch('/api/gift-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ midMin, megaMin })
                });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
                    btn.classList.replace('bg-purple-600','bg-green-600');
                    btn.classList.replace('hover:bg-purple-700','hover:bg-green-700');
                    setTimeout(() => {
                        btn.innerHTML = orig;
                        btn.classList.replace('bg-green-600','bg-purple-600');
                        btn.classList.replace('hover:bg-green-700','hover:bg-purple-700');
                    }, 2000);
                } else {
                    alert('저장 실패: ' + (data.message || ''));
                }
            } catch(e) {
                alert('오류가 발생했습니다.');
            }
        }

        async function loadGiftSettings() {
            try {
                const res  = await fetch('/api/gift-settings');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('midMin').value  = data.midMin  ?? 100;
                    document.getElementById('megaMin').value = data.megaMin ?? 1000;
                }
            } catch(e) {}
        }

        // ── 모더 관리 ──
        async function loadModerators() {
            const res  = await fetch('/api/moderator');
            const data = await res.json();
            if (!data.success) return;
            renderModerators(data.moderators);
            // 비활동 색상 토글 상태 반영
            const enabled = data.inactiveAlert === true;
            const btn   = document.getElementById('inactiveAlertBtn');
            const thumb = document.getElementById('inactiveAlertThumb');
            if (btn && thumb) {
                btn.dataset.enabled = enabled ? 'true' : 'false';
                btn.classList.toggle('bg-blue-500', enabled);
                btn.classList.toggle('bg-gray-200', !enabled);
                thumb.classList.toggle('translate-x-6', enabled);
                thumb.classList.toggle('translate-x-0.5', !enabled);
            }
        }

        async function toggleInactiveAlert() {
            const btn     = document.getElementById('inactiveAlertBtn');
            const thumb   = document.getElementById('inactiveAlertThumb');
            const current = btn.dataset.enabled === 'true';
            const next    = !current;
            btn.dataset.enabled = next ? 'true' : 'false';
            btn.classList.toggle('bg-blue-500', next);
            btn.classList.toggle('bg-gray-200', !next);
            thumb.classList.toggle('translate-x-6', next);
            thumb.classList.toggle('translate-x-0.5', !next);
            await fetch('/api/moderator/inactive-alert', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ inactiveAlert: next })
            });
        }

        function renderModerators(mods) {
            var el = document.getElementById('modList');
            document.getElementById('modCount').textContent = mods.length + '명 등록됨';
            if (!mods.length) {
                el.innerHTML = '<div class="text-center py-4 text-gray-400 text-sm">등록된 모더가 없습니다.</div>';
                return;
            }
            var html = '';
            for (var i = 0; i < mods.length; i++) {
                var m = mods[i];
                var isUrl = (m.profileImg || '').startsWith('http');
                var avatarHtml;
                if (isUrl) {
                    avatarHtml = '<img src="' + escHtmlMod(m.profileImg) + '" class="w-full h-full object-cover">';
                } else if (m.profileImg) {
                    avatarHtml = '<span style="font-size:18px">' + escHtmlMod(m.profileImg) + '</span>';
                } else {
                    avatarHtml = escHtmlMod(m.displayName.charAt(0).toUpperCase());
                }
                html += '<div class="flex items-center gap-2 p-2.5 bg-white border border-gray-200 rounded-lg">';
                html += '<div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center font-bold text-blue-600 flex-shrink-0 overflow-hidden border border-blue-100">' + avatarHtml + '</div>';
                html += '<div class="flex-1 min-w-0">';
                html += '<div class="text-sm font-semibold text-gray-700 truncate">' + escHtmlMod(m.displayName) + '</div>';
                html += '<div class="text-xs text-gray-400 truncate">@' + escHtmlMod(m.tiktokUniqueId) + '</div>';
                html += '</div>';
                html += '<button onclick="deleteModerator(\'' + m._id + '\')" class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-red-50 transition text-red-400 flex-shrink-0"><i class="fas fa-trash"></i></button>';
                html += '</div>';
            }
            el.innerHTML = html;
        }

        function escHtmlMod(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function selectModEmoji(btn, emoji) {
            document.querySelectorAll('.mod-emoji-btn').forEach(b => {
                b.style.borderColor = '';
                b.style.background  = '';
            });
            btn.style.borderColor = '#3b82f6';
            btn.style.background  = '#eff6ff';
            document.getElementById('modEmoji').value = emoji;
        }

        function selectLevel50Emoji(btn, emoji) {
            document.querySelectorAll('.level50-emoji-btn').forEach(b => {
                b.style.borderColor = '';
                b.style.background  = '';
            });
            btn.style.borderColor = '#06b6d4';
            btn.style.background  = '#ecfeff';
            document.getElementById('level50Emoji').value = emoji;
        }

        async function addModerator() {
            const tiktokUniqueId = document.getElementById('modTiktokId').value.trim().replace(/^@/, '');
            const displayName    = document.getElementById('modDisplayName').value.trim();
            const profileImg     = document.getElementById('modEmoji').value || '👑';
            if (!tiktokUniqueId || !displayName) { alert('TikTok ID와 닉네임을 입력해주세요.'); return; }
            const res = await fetch('/api/moderator', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tiktokUniqueId, displayName, profileImg })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('modTiktokId').value    = '';
                document.getElementById('modDisplayName').value = '';
                // 이모지 선택 초기화
                document.querySelectorAll('.mod-emoji-btn').forEach((b,i) => {
                    b.style.borderColor = i === 0 ? '#3b82f6' : '';
                    b.style.background  = i === 0 ? '#eff6ff' : '';
                });
                document.getElementById('modEmoji').value = '👑';
                loadModerators();
            } else {
                alert(data.message);
            }
        }

        async function deleteModerator(id) {
            if (!confirm('이 모더를 삭제하시겠습니까?')) return;
            await fetch('/api/moderator/' + id, { method: 'DELETE' });
            loadModerators();
        }

        // ── 50레벨 시청자 관리 ──
        async function loadLevel50Viewers() {
            const res  = await fetch('/api/level50');
            const data = await res.json();
            if (!data.success) return;
            renderLevel50Viewers(data.level50Viewers);
            // 비활동 색상 토글 상태 반영
            const enabled = data.inactiveAlert === true;
            const btn   = document.getElementById('level50InactiveAlertBtn');
            const thumb = document.getElementById('level50InactiveAlertThumb');
            if (btn && thumb) {
                btn.dataset.enabled = enabled ? 'true' : 'false';
                btn.classList.toggle('bg-cyan-500', enabled);
                btn.classList.toggle('bg-gray-200', !enabled);
                thumb.classList.toggle('translate-x-6', enabled);
                thumb.classList.toggle('translate-x-0.5', !enabled);
            }
        }

        async function toggleLevel50InactiveAlert() {
            const btn     = document.getElementById('level50InactiveAlertBtn');
            const thumb   = document.getElementById('level50InactiveAlertThumb');
            const current = btn.dataset.enabled === 'true';
            const next    = !current;
            btn.dataset.enabled = next ? 'true' : 'false';
            btn.classList.toggle('bg-cyan-500', next);
            btn.classList.toggle('bg-gray-200', !next);
            thumb.classList.toggle('translate-x-6', next);
            thumb.classList.toggle('translate-x-0.5', !next);
            await fetch('/api/level50/inactive-alert', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ inactiveAlert: next })
            });
        }

        async function addLevel50Viewer() {
            const tiktokUniqueId = document.getElementById('level50TiktokId').value.trim().replace(/^@/, '');
            const displayName    = document.getElementById('level50DisplayName').value.trim();
            const profileImg     = document.getElementById('level50Emoji').value || '🏆';
            if (!tiktokUniqueId || !displayName) { alert('TikTok ID와 닉네임을 입력해주세요.'); return; }
            const res = await fetch('/api/level50', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tiktokUniqueId, displayName, profileImg })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('level50TiktokId').value = '';
                document.getElementById('level50DisplayName').value = '';
                loadLevel50Viewers();
            } else {
                alert(data.message || '등록 실패');
            }
        }

        async function deleteLevel50Viewer(id) {
            if (!confirm('이 50레벨 시청자를 삭제하시겠습니까?')) return;
            await fetch('/api/level50/' + id, { method: 'DELETE' });
            loadLevel50Viewers();
        }

        function renderLevel50Viewers(viewers) {
            var el = document.getElementById('level50List');
            if (!viewers.length) {
                el.innerHTML = '<div class="text-center py-4 text-gray-400 text-sm">등록된 50레벨 시청자가 없습니다.</div>';
                return;
            }
            var html = '';
            for (var i = 0; i < viewers.length; i++) {
                var v = viewers[i];
                var isUrl = (v.profileImg || '').startsWith('http');
                var avatarHtml;
                if (isUrl) {
                    avatarHtml = '<img src="' + escHtmlMod(v.profileImg) + '" class="w-full h-full object-cover">';
                } else if (v.profileImg) {
                    avatarHtml = '<span style="font-size:18px">' + escHtmlMod(v.profileImg) + '</span>';
                } else {
                    avatarHtml = escHtmlMod(v.displayName.charAt(0).toUpperCase());
                }
                html += '<div class="flex items-center gap-2 p-2.5 bg-white border border-gray-200 rounded-lg">';
                html += '<div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center font-bold text-cyan-600 flex-shrink-0 overflow-hidden border border-cyan-100">' + avatarHtml + '</div>';
                html += '<div class="flex-1 min-w-0">';
                html += '<div class="text-sm font-semibold text-gray-700 truncate">' + escHtmlMod(v.displayName) + '</div>';
                html += '<div class="text-xs text-gray-400 truncate">@' + escHtmlMod(v.tiktokUniqueId) + '</div>';
                html += '</div>';
                html += '<button onclick="deleteLevel50Viewer(\'' + v._id + '\')" class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-red-50 transition text-red-400 flex-shrink-0"><i class="fas fa-trash"></i></button>';
                html += '</div>';
            }
            el.innerHTML = html;
        }

        // ── 공지사항 관리 ──
        document.getElementById('noticeInput').addEventListener('input', function() {
            document.getElementById('noticeCharCount').textContent = this.value.length + '/50';
        });

        async function loadNotices() {
            const res = await fetch('/api/overlay-notice');
            const data = await res.json();
            if (!data.success) return;
            renderNotices(data.notices);
        }

        function renderNotices(notices) {
            const el = document.getElementById('noticeList');
            document.getElementById('noticeSavedCount').textContent = notices.length + '개 저장됨';
            if (!notices.length) {
                el.innerHTML = '<div class="text-center py-4 text-gray-400 text-sm">저장된 공지가 없습니다.<br><span class="text-xs">공지를 추가하면 오버레이에 신청곡 사이에 표시됩니다.</span></div>';
                return;
            }
            el.innerHTML = notices.map(n => `
                <div class="flex items-center gap-2 p-2.5 bg-white border border-gray-200 rounded-lg" id="notice-${n._id}">
                    <span class="text-xs px-2 py-0.5 rounded-full font-semibold flex-shrink-0 ${n.isActive ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-400'}">
                        ${n.isActive ? '📢 ON' : 'OFF'}
                    </span>
                    <span class="flex-1 text-sm text-gray-700 truncate" id="notice-text-${n._id}">${escHtml(n.content)}</span>
                    <div class="flex gap-1 flex-shrink-0">
                        <button onclick="toggleNotice('${n._id}', ${!n.isActive})"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-gray-50 transition ${n.isActive ? 'text-gray-500' : 'text-indigo-600'}">
                            ${n.isActive ? '끄기' : '켜기'}
                        </button>
                        <button onclick="editNotice('${n._id}', ${JSON.stringify(n.content)})"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-gray-50 transition text-gray-500">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button onclick="deleteNotice('${n._id}')"
                            class="px-2 py-1 text-xs border border-gray-200 rounded hover:bg-red-50 transition text-red-400">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function escHtml(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        async function addNotice() {
            const input = document.getElementById('noticeInput');
            const content = input.value.trim();
            if (!content) return;
            const res = await fetch('/api/overlay-notice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content })
            });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                document.getElementById('noticeCharCount').textContent = '0/50';
                loadNotices();
            } else {
                alert(data.message);
            }
        }

        async function toggleNotice(id, isActive) {
            await fetch(`/api/overlay-notice/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isActive })
            });
            loadNotices();
        }

        async function editNotice(id, currentContent) {
            const newContent = prompt('공지 내용 수정 (최대 50자):', currentContent);
            if (newContent === null) return;
            if (newContent.length > 50) { alert('50자 이내로 입력해주세요.'); return; }
            const res = await fetch(`/api/overlay-notice/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: newContent.trim() })
            });
            const data = await res.json();
            if (data.success) loadNotices();
            else alert(data.message);
        }

        async function deleteNotice(id) {
            if (!confirm('이 공지를 삭제하시겠습니까?')) return;
            await fetch(`/api/overlay-notice/${id}`, { method: 'DELETE' });
            loadNotices();
        }

        // ── 번역 자막 언어 설정 ──
        async function loadSpeechSettings() {
            try {
                const res  = await fetch('/api/speech-settings');
                const data = await res.json();
                if (data.success && data.langs) {
                    document.querySelectorAll('.lang-check').forEach(cb => {
                        cb.checked = data.langs.includes(cb.value);
                    });
                    updateLangCheckboxStyles();
                    document.getElementById('langCountMsg').textContent = data.langs.length + '개 선택됨';
                }
            } catch(e) {}
        }

        function onLangChange() {
            const checked = [...document.querySelectorAll('.lang-check:checked')];
            if (checked.length > 2) {
                // 마지막 체크된 것 해제
                event.target.checked = false;
                return;
            }
            updateLangCheckboxStyles();
            document.getElementById('langCountMsg').textContent = checked.length + '개 선택됨';
        }

        function updateLangCheckboxStyles() {
            document.querySelectorAll('.lang-label').forEach(label => {
                const cb = label.querySelector('.lang-check');
                if (cb.checked) {
                    label.style.borderColor = '#22c55e';
                    label.style.background  = '#f0fdf4';
                } else {
                    label.style.borderColor = '';
                    label.style.background  = '';
                }
            });
        }

        async function saveSpeechSettings() {
            const langs = [...document.querySelectorAll('.lang-check:checked')].map(cb => cb.value);
            if (!langs.length) { alert('언어를 1개 이상 선택해주세요.'); return; }
            const btn  = document.getElementById('saveSpeechBtn');
            const orig = btn.innerHTML;
            try {
                const res  = await fetch('/api/speech-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ langs })
                });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> 저장됨!';
                    btn.classList.replace('bg-green-600','bg-emerald-600');
                    setTimeout(() => {
                        btn.innerHTML = orig;
                        btn.classList.replace('bg-emerald-600','bg-green-600');
                    }, 2000);
                } else {
                    alert('저장 실패: ' + (data.message || ''));
                }
            } catch(e) { alert('오류가 발생했습니다.'); }
        }

        function copySpeechUrl() {
            const text = document.getElementById('speechUrl').textContent.trim();
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copySpeechBtn');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> 복사됨!';
                btn.classList.replace('bg-green-600','bg-emerald-600');
                setTimeout(() => { btn.innerHTML = orig; btn.classList.replace('bg-emerald-600','bg-green-600'); }, 2000);
            });
        }


        // ── 채팅 배경 위젯 설정 ──
        async function loadChatGradientSettings() {
            try {
                const res = await fetch('/api/overlay/positions');
                const data = await res.json();
                if (data.success && data.positions && data.positions.chatGradient) {
                    const color = data.positions.chatGradient.color || 'black';
                    document.getElementById('chat-gradient-color').value = color;
                }
                const userId = '<%= user._id %>';
                document.getElementById('chat-gradient-url').value = `https://tikfind.kr/overlay/${userId}/chat-gradient`;
            } catch (e) {}
        }

        async function saveChatGradientColor() {
            try {
                const color = document.getElementById('chat-gradient-color').value;
                const loadRes = await fetch('/api/overlay/positions');
                const loadData = await loadRes.json();
                const existingPositions = loadData.success ? loadData.positions : {};
                const updatedPositions = {
                    ...existingPositions,
                    chatGradient: { ...existingPositions.chatGradient, color }
                };
                const res = await fetch('/api/overlay/positions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ positions: updatedPositions })
                });
                const data = await res.json();
                if (data.success) {
                    alert('색상이 저장되었습니다.');
                    // 소켓으로 색상 변경 전송
                    const socket = io({ auth: { type: 'web', userId: '<%= user._id %>' } });
                    socket.emit('chat-gradient-color-update', { color });
                } else {
                    alert('저장 실패: ' + (data.message || '알 수 없는 오류'));
                }
            } catch (e) {
                alert('서버 오류가 발생했습니다.');
            }
        }

        function copyChatGradientUrl() {
            const urlInput = document.getElementById('chat-gradient-url');
            urlInput.select();
            document.execCommand('copy');
            alert('채팅 배경 위젯 URL이 복사되었습니다.');
        }


        // ── AI 시청자 설정 ──
        async function loadAICompanionSettings() {
            try {
                const res = await fetch('/api/ai-companion-settings');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('aiCompanionEnabled').checked = data.aiCompanionEnabled !== false;
                    document.getElementById('aiCompanionName').value = data.aiCompanionName || 'TikFind AI';
                    document.getElementById('aiCompanionPersonality').value = data.aiCompanionPersonality || '친근한';
                    document.getElementById('aiCompanionFrequency').value = data.aiCompanionFrequency || '보통';
                }
            } catch (e) {
                console.error('AI 시청자 설정 로드 오류:', e);
            }
        }

        async function saveAICompanionSettings() {
            try {
                const settings = {
                    aiCompanionEnabled: document.getElementById('aiCompanionEnabled').checked,
                    aiCompanionName: document.getElementById('aiCompanionName').value,
                    aiCompanionPersonality: document.getElementById('aiCompanionPersonality').value,
                    aiCompanionFrequency: document.getElementById('aiCompanionFrequency').value
                };

                const res = await fetch('/api/ai-companion-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(settings)
                });

                const data = await res.json();
                if (data.success) {
                    alert('AI 시청자 설정이 저장되었습니다.');
                } else {
                    alert('저장 실패: ' + (data.message || '알 수 없는 오류'));
                }
            } catch (e) {
                alert('서버 오류가 발생했습니다.');
            }
        }


        // ── 매치 코치 설정 ──
        async function loadMatchCoachSettings() {
            try {
                const res  = await fetch('/api/match-coach-settings');
                const data = await res.json();
                if (data.success) {
                    const enabled = data.enabled !== false; // 기본값 true
                    updateMatchCoachUI(enabled);
                }
            } catch(e) {
                updateMatchCoachUI(true); // 기본값
            }
        }

        function updateMatchCoachUI(enabled) {
            const btn   = document.getElementById('matchCoachBtn');
            const thumb = document.getElementById('matchCoachThumb');
            if (btn && thumb) {
                btn.dataset.enabled = enabled ? 'true' : 'false';
                btn.classList.toggle('bg-orange-500', enabled);
                btn.classList.toggle('bg-gray-200', !enabled);
                thumb.classList.toggle('translate-x-6', enabled);
                thumb.classList.toggle('translate-x-0.5', !enabled);
            }
        }

        async function toggleMatchCoach() {
            const btn     = document.getElementById('matchCoachBtn');
            const current = btn.dataset.enabled === 'true';
            const next    = !current;
            updateMatchCoachUI(next);
            await fetch('/api/match-coach-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled: next })
            });
        }

        // 초기 탭 로드
        if (document.getElementById('panel-song').classList.contains('active'))   loadNotices();
        if (document.getElementById('panel-gift').classList.contains('active'))   loadGiftSettings();
        if (document.getElementById('panel-mod').classList.contains('active'))    loadModerators();
        if (document.getElementById('panel-speech').classList.contains('active')) loadSpeechSettings();
        if (document.getElementById('panel-match').classList.contains('active'))  loadMatchCoachSettings();

        // mobile-overlay가 클릭을 차단하지 않도록 강제 숨김
        function fixMobileOverlay() {
            const mo = document.getElementById('mobile-overlay');
            if (mo) {
                mo.classList.add('hidden');
                mo.style.pointerEvents = 'none';
                mo.style.display = 'none';
            }
        }
        fixMobileOverlay();
        // header-container에 동적 삽입 후에도 처리
        const headerObs = new MutationObserver(() => fixMobileOverlay());
        const hc = document.getElementById('header-container');
        if (hc) headerObs.observe(hc, { childList: true, subtree: true });
    </script>
</body>
</html>
