<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Overlay</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: transparent;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
        }

        /* 마퀴 바 */
        .marquee-bar {
            width: 40%;
            overflow: hidden;
            white-space: nowrap;
            display: flex;
            align-items: center;
            padding: 0 10px;
            /* 기본값 - JS에서 덮어씀 */
            background: rgba(0, 0, 0, 0.55);
            height: 36px;
            border-radius: 6px;
        }

        .marquee-icon {
            flex-shrink: 0;
            margin-right: 8px;
            font-size: inherit;
        }

        .marquee-track {
            display: inline-block;
            white-space: nowrap;
            animation: marquee-scroll 18s linear infinite;
        }

        @keyframes marquee-scroll {
            0%   { transform: translateX(100vw); }
            100% { transform: translateX(-100%); }
        }

        .marquee-text {
            display: inline;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .sep {
            display: inline;
            margin: 0 18px;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="marquee-bar" id="marqueeBar">
        <span class="marquee-icon">♪</span>
        <div class="marquee-track" id="marqueeTrack">
            <span class="marquee-text" id="marqueeText">신청곡을 기다리고 있습니다...</span>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const userId = '<%= userId %>';
        const socket = io();

        // URL 파라미터로 스타일 설정
        const params   = new URLSearchParams(location.search);
        const bgColor  = decodeURIComponent(params.get('bg')    || 'rgba(0,0,0,0.55)');
        const txtColor = params.get('color') || '#ffffff';
        const fontSize = params.get('size')  || '16';
        const speed    = parseFloat(params.get('speed') || '1.0'); // 1.0 = 기본, 0.5 = 느림, 2.0 = 빠름

        const bar   = document.getElementById('marqueeBar');
        const track = document.getElementById('marqueeTrack');

        bar.style.background  = bgColor;
        bar.style.color       = txtColor;
        bar.style.fontSize    = fontSize + 'px';
        bar.style.height      = (parseInt(fontSize) * 2.4) + 'px';

        // 마퀴 속도: 글자 수 기반 + speed 배율 적용
        function setSpeed(text) {
            const base = Math.max(10, text.length * 0.35);
            const duration = base / speed;  // speed 높을수록 빠름
            track.style.animationDuration = duration + 's';
        }

        // 현재곡 / 다음곡 상태
        let currentSong = null;
        let nextQueue   = [];

        function songLabel(song) {
            if (!song) return '';
            let label = song.title;
            if (song.artist)    label += ' - ' + song.artist;
            if (song.requester) label += ' (신청: @' + song.requester + ')';
            return label;
        }

        function buildText() {
            let parts = [];
            if (currentSong) {
                parts.push('♪ 현재곡: ' + songLabel(currentSong));
            }
            if (nextQueue.length > 0) {
                parts.push('♪ 다음곡: ' + songLabel(nextQueue[0]));
            }
            if (nextQueue.length > 1) {
                const rest = nextQueue.slice(1, 4).map(s => s.title + (s.requester ? ' (@' + s.requester + ')' : '')).join('  /  ');
                parts.push('♪ 대기: ' + rest);
            }
            // 텍스트가 없으면 대기 메시지, 있으면 앞뒤 여백 추가해 자연스럽게 반복
            const text = parts.length > 0
                ? parts.join('　　　　　')
                : '신청곡을 기다리고 있습니다...';
            document.getElementById('marqueeText').textContent = text;
            setSpeed(text);
        }

        socket.emit('join-overlay', userId);

        socket.on('current-song', (data) => {
            currentSong = (data && data.title) ? data : null;
            buildText();
        });

        socket.on('song-queue', (queue) => {
            const all = queue || [];
            // 현재 재생 중인 곡은 큐에서 제외 (currentSong과 id 또는 title로 매칭)
            if (currentSong) {
                nextQueue = all.filter(s =>
                    s.id !== currentSong.id &&
                    !(s.title === currentSong.title && s.requester === currentSong.requester)
                );
            } else {
                nextQueue = all;
            }
            buildText();
        });
    </script>
</body>
</html>
