<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Level 50 Viewer Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@600;700;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 120px;
            min-height: 100px;
            background: transparent;
            overflow: visible;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
        }
        body.preview-mode {
            width: 100vw !important;
            min-height: 100vh !important;
            background: #0f172a !important;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding-top: 40px;
        }
        body.preview-mode #level50-list {
            width: 120px;
        }

        #level50-list {
            width: 120px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 4px 0;
        }

        /* 각 50레벨 카드 */
        .level50-card {
            width: 114px;
            margin: 0 auto;
            border-radius: 14px;
            border: 1.5px solid rgba(255,255,255,0.30);
            background: rgba(0, 0, 0, 0.20);
            overflow: hidden;
            animation: card-in 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards;
        }
        .level50-card.leaving {
            animation: card-out 0.35s ease forwards;
        }
        @keyframes card-in {
            from { opacity:0; transform: scale(0.82) translateY(-8px); }
            to   { opacity:1; transform: scale(1)    translateY(0); }
        }
        @keyframes card-out {
            from { opacity:1; transform: scale(1); }
            to   { opacity:0; transform: scale(0.82) translateY(-6px); }
        }

        /* 상단 뱃지 */
        .level50-badge {
            width: 100%;
            background: rgba(0, 0, 0, 0.85);
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            color: #ffd700;
            letter-spacing: 0.05em;
            padding: 3px 0;
            border-radius: 0;
            transition: background 0.6s ease;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.8), 0 0 20px rgba(255, 215, 0, 0.6);
            border: 1px solid rgba(255, 215, 0, 0.5);
        }
        .level50-badge.inactive {
            background: var(--inactive-bg, rgba(0, 0, 0, 0.85));
        }
        /* 재입장 시 배지 반짝임 */
        .level50-badge.flash {
            animation: badge-flash 5s ease forwards;
        }
        @keyframes badge-flash {
            0%   { background: rgba(250,204,21,0.95); transform: scaleY(1.0); }
            10%  { background: rgba(250,204,21,0.95); transform: scaleY(1.25); }
            20%  { background: rgba(6,182,212,0.95); transform: scaleY(1.0); }
            40%  { background: rgba(250,204,21,0.95); transform: scaleY(1.15); }
            60%  { background: rgba(6,182,212,0.95); }
            80%  { background: rgba(250,204,21,0.85); }
            100% { background: rgba(6,182,212,0.75); transform: scaleY(1.0); }
        }


        /* 프로필 영역 */
        .level50-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 8px 6px 9px;
            gap: 5px;
        }

        .level50-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            line-height: 1;
            flex-shrink: 0;
        }
        .level50-avatar img {
            width: 36px; height: 36px; object-fit: cover; display: block; border-radius: 50%;
        }

        .level50-name {
            font-size: 25px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            text-shadow: 0 1px 6px rgba(0,0,0,0.9);
            word-break: break-all;
            line-height: 1.3;
            max-width: 110px;
        }

    </style>
</head>
<body>
<div id="level50-list"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const userId = '<%= userId %>';
    const socket = io();

    // 현재 입장한 50레벨 시청자 목록 { uniqueId: { displayName, profileImg, cardEl } }
    const activeLevel50 = new Map();

    // 서버에서 50레벨 시청자 목록 로드
    let level50Config = []; // [{ tiktokUniqueId, displayName, profileImg }]

    // 비활동 색상 변경 여부 (기본 off = 색상 변경 안함)
    let inactiveAlert = false;

    function applyInactiveAlert(enabled) {
        inactiveAlert = enabled;
        // enabled=true 이면 빨간색, false 이면 청록색(변화없음)
        document.documentElement.style.setProperty(
            '--inactive-bg',
            enabled ? 'rgba(220,38,38,0.85)' : 'rgba(6,182,212,0.75)'
        );
    }

    async function loadLevel50() {
        try {
            const res  = await fetch('/api/level50?userId=' + userId);
            const data = await res.json();
            if (data.success) {
                level50Config = data.level50Viewers;
                applyInactiveAlert(data.inactiveAlert === true);
            }
        } catch(e) {}
    }

    loadLevel50();
    socket.emit('join-overlay', userId);
    socket.on('connect', () => { socket.emit('join-overlay', userId); });

    // 소켓: 50레벨 시청자 설정 변경 실시간 반영
    socket.on('level50-update', () => loadLevel50());

    // 소켓: 비활동 색상 설정 실시간 반영
    socket.on('level50-inactive-alert', (data) => {
        applyInactiveAlert(data.inactiveAlert === true);
    });

    // 비활성 타임아웃 (3분 = 180000ms), 퇴장 타임아웃 (5분 = 300000ms)
    const INACTIVE_MS = 3 * 60 * 1000;
    const REMOVE_MS   = 5 * 60 * 1000;

    // 활동 타이머 맵 { uid: { inactiveId, removeId } }
    const activityTimers = new Map();

    function resetActivityTimer(uid) {
        // 기존 타이머 클리어
        const existing = activityTimers.get(uid);
        if (existing) {
            clearTimeout(existing.inactiveId);
            clearTimeout(existing.removeId);
        }
        // 배지 활성(청록색)
        const entry = activeLevel50.get(uid);
        if (entry) {
            const badge = entry.cardEl.querySelector('.level50-badge');
            if (badge) badge.classList.remove('inactive');
        }
        // 3분 후 비활성(빨간색)
        const inactiveId = setTimeout(() => {
            const e = activeLevel50.get(uid);
            if (e) {
                const b = e.cardEl.querySelector('.level50-badge');
                if (b) b.classList.add('inactive');
            }
        }, INACTIVE_MS);
        // 5분 후 카드 자동 제거 (방에서 나간 것으로 간주)
        const removeId = setTimeout(() => {
            removeLevel50Card(uid);
        }, REMOVE_MS);
        activityTimers.set(uid, { inactiveId, removeId });
    }

    // 소켓: 50레벨 시청자 입장 이벤트
    socket.on('overlay-level50-join', (data) => {
        const uid = (data.uniqueId || '').trim().toLowerCase();
        if (!uid) return;
        if (activeLevel50.has(uid)) {
            // 재입장: 카드를 맨 위로 이동 + 배지 flash
            const entry = activeLevel50.get(uid);
            const list  = document.getElementById('level50-list');
            list.prepend(entry.cardEl);
            const badge = entry.cardEl.querySelector('.level50-badge');
            if (badge) {
                badge.classList.remove('flash', 'inactive');
                void badge.offsetWidth; // reflow
                badge.classList.add('flash');
            }
            resetActivityTimer(uid);
            return;
        }
        addLevel50Card(uid, {
            displayName: data.displayName,
            profileImg:  data.profileImg || ''
        });
        resetActivityTimer(uid);
    });

    // 소켓: 50레벨 시청자 활동 이벤트 (채팅/선물/좋아요)
    socket.on('overlay-level50-activity', (data) => {
        const uid = (data.uniqueId || '').trim().toLowerCase();
        if (!uid) return;
        if (!activeLevel50.has(uid)) {
            // 카드 없으면 자동 추가 (방송 중 입장한 50레벨 시청자 대응)
            addLevel50Card(uid, {
                displayName: data.displayName,
                profileImg:  data.profileImg || ''
            });
        }
        resetActivityTimer(uid);
    });

    // 소켓: 라이브 종료 시 전체 클리어
    socket.on('live-ended', () => {
        activeLevel50.forEach((v, k) => removeLevel50Card(k));
    });

    function addLevel50Card(uid, viewer) {
        const list = document.getElementById('level50-list');

        const card = document.createElement('div');
        card.className = 'level50-card';
        card.id = 'level50-' + uid;

        const name    = viewer.displayName || uid;
        const rawImg  = viewer.profileImg || '';
        // URL이면 img 태그, 아니면(이모지 등) 텍스트로 표시
        const isUrl   = rawImg.startsWith('http');
        const initial = name.charAt(0).toUpperCase();
        const avatarContent = isUrl
            ? `<img src="${escHtml(rawImg)}" onerror="this.parentNode.textContent='${escHtml(initial)}'">`
            : (rawImg ? escHtml(rawImg) : escHtml(initial));

        card.innerHTML = `
            <div class="level50-badge">50 Level</div>
            <div class="level50-body">
                <div class="level50-avatar" id="av-${uid}">${avatarContent}</div>
                <div class="level50-name">${escHtml(name)}</div>
            </div>
        `;

        list.appendChild(card);
        activeLevel50.set(uid, { viewer, cardEl: card });
    }

    function removeLevel50Card(uid) {
        const entry = activeLevel50.get(uid);
        if (!entry) return;
        const card = entry.cardEl;
        card.classList.add('leaving');
        card.addEventListener('animationend', () => {
            card.remove();
            activeLevel50.delete(uid);
        }, { once: true });
    }

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── 테스트 모드 ──
    const testParam = new URLSearchParams(location.search).get('test');
    if (testParam === '1' || testParam === 'true') {
        document.body.classList.add('preview-mode');

        // 상단 레이블
        const label = document.createElement('div');
        label.textContent = '🏆 50레벨 위젯 미리보기 모드';
        label.style.cssText = 'position:fixed;top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.6);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:12px;font-weight:700;padding:5px 16px;border-radius:50px;z-index:9999;pointer-events:none;white-space:nowrap;';
        document.body.appendChild(label);

        // 더미 50레벨 시청자 3명 표시
        const dummies = [
            { uniqueId:'level50_test1', displayName:'김민지', profileImg:'🏆' },
            { uniqueId:'level50_test2', displayName:'이서연', profileImg:'🏆' },
            { uniqueId:'level50_test3', displayName:'박하은',  profileImg:'🏆' },
        ];
        dummies.forEach((d, i) => {
            setTimeout(() => addLevel50Card(d.uniqueId, d), i * 400);
        });

        // 재생 버튼
        const btn = document.createElement('div');
        btn.innerHTML = '🔄 다시 보기';
        btn.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(6,182,212,0.95);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:14px;font-weight:700;padding:12px 32px;border-radius:50px;cursor:pointer;z-index:9999;box-shadow:0 4px 24px rgba(0,0,0,0.4);white-space:nowrap;user-select:none;';
        document.body.appendChild(btn);
        btn.addEventListener('click', () => {
            // 기존 카드 제거 후 재표시
            activeLevel50.forEach((v, k) => removeLevel50Card(k));
            setTimeout(() => {
                dummies.forEach((d, i) => {
                    setTimeout(() => addLevel50Card(d.uniqueId, d), i * 400);
                });
            }, 400);
        });
    }
</script>
</body>
</html>
