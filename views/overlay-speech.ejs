<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Speech Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@700;900&family=Noto+Sans+JP:wght@700&family=Noto+Sans+SC:wght@700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 972px;
            height: 150px;
            background: transparent;
            overflow: hidden;
            font-family: 'Noto Sans KR', 'Noto Sans JP', 'Noto Sans SC', sans-serif;
        }
        body.preview-mode {
            width: 100vw !important;
            height: 100vh !important;
            background: #0f172a !important;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 전체 래퍼 */
        #speech-wrap {
            width: 972px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        /* 각 언어 행 */
        .lang-row {
            height: 70px;
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.30);
            padding: 0 16px;
            gap: 10px;
            overflow: hidden;
            border-radius: 21px;   /* 70px × 0.30 */
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .lang-row.visible { opacity: 1; }
        .lang-row.priority {
            background: rgba(220, 38, 38, 0.88) !important;
            border: 2px solid rgba(255, 80, 80, 0.9);
            box-shadow: 0 0 18px rgba(220,38,38,0.5);
        }
        .lang-row.priority .lang-text { font-size: 135% !important; font-weight: 900 !important; color: #fff !important; }
        .lang-row.priority .host-badge { background: rgba(255,255,255,0.25) !important; }

        /* 호스트 뱃지 */
        .host-badge {
            flex-shrink: 0;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: 0.06em;
            padding: 4px 12px;
            border-radius: 8px;
            white-space: nowrap;
            background: rgba(99,102,241,0.85);
            color: #fff;
        }

        /* 번역 텍스트 스크롤 래퍼 */
        .lang-text-wrap {
            flex: 1;
            overflow: hidden;
            min-width: 0;
            height: 100%;
            display: flex;
            align-items: center;
        }
        /* 번역 텍스트 */
        .lang-text {
            display: inline-block;
            white-space: nowrap;
            font-size: 32px;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 4px rgba(0,0,0,0.8);
        }
        /* 마퀴: JS가 transition 제어 */
        .lang-text.interim {
            color: rgba(255,255,255,0.55);
            font-style: italic;
        }
        @keyframes marquee-reset { from { transform: translateX(0); } to { transform: translateX(0); } }

    </style>
</head>
<body>

<div id="speech-wrap">
    <!-- 언어 행은 JS에서 동적 생성 -->
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const userId = '<%= userId %>';
    const socket = io();
    socket.emit('join-overlay', userId);
    socket.on('connect', () => { socket.emit('join-overlay', userId); });

    // ── 설정 ──
    let activeLangs = ['en'];
    const langNames  = { en:'EN', ja:'JA', zh:'ZH', es:'ES', fr:'FR', de:'DE', th:'TH', vi:'VI', id:'ID' };
    const langEmojis = { en:'🇺🇸', ja:'🇯🇵', zh:'🇨🇳', es:'🇪🇸', fr:'🇫🇷', de:'🇩🇪', th:'🇹🇭', vi:'🇻🇳', id:'🇮🇩' };
    let hideTimer = null;

    // ── DOM 빌드 ──
    function buildRows(langs) {
        const wrap = document.getElementById('speech-wrap');
        wrap.innerHTML = '';
        langs.slice(0, 2).forEach(lang => {
            const row = document.createElement('div');
            row.className = 'lang-row';
            row.id = 'row-' + lang;

            const badge = document.createElement('span');
            badge.className = 'host-badge';
            badge.textContent = 'TikFind';

            const textWrap = document.createElement('div');
            textWrap.className = 'lang-text-wrap';
            textWrap.id = 'wrap-' + lang;

            const text = document.createElement('span');
            text.className = 'lang-text';
            text.id = 'text-' + lang;

            textWrap.appendChild(text);
            row.appendChild(badge);
            row.appendChild(textWrap);
            wrap.appendChild(row);
        });
    }

    // ── 설정 로드 ──
    async function loadSettings() {
        try {
            const res  = await fetch('/api/speech-settings?userId=' + userId);
            const data = await res.json();
            if (data.success && data.langs && data.langs.length) {
                activeLangs = data.langs.slice(0, 2);
            }
        } catch(e) {}
        buildRows(activeLangs);
    }

    function hideAll() {
        activeLangs.forEach(lang => {
            const row = document.getElementById('row-' + lang);
            if (row) row.classList.remove('visible');
        });
    }

    function showInterim(text) {
        // 한국어 원문 표시 안 함
    }

    // 마퀴 타이머 맵 { lang: timeoutId }
    const marqueeTimers = new Map();

    function startMarquee(lang, textEl, wrapEl) {
        // 이전 트랜지션 완전 제거
        textEl.style.transition = 'none';
        textEl.style.transform  = 'translateX(0)';
        void textEl.offsetWidth;

        const textW = textEl.scrollWidth;
        const wrapW = wrapEl.clientWidth;
        if (textW <= wrapW) return; // 짧으면 모두 보임

        const dist = textW - wrapW + 20;
        const dur  = dist / 80; // 80px/s 속도

        // 0.5초 대기 후 주행
        const t1 = setTimeout(() => {
            textEl.style.transition = `transform ${dur.toFixed(2)}s linear`;
            textEl.style.transform  = `translateX(-${dist}px)`;
            // 끝에 도달 후 1초 유지 → 원위치 돌아오기
            const t2 = setTimeout(() => {
                textEl.style.transition = 'transform 0.6s ease';
                textEl.style.transform  = 'translateX(0)';
            }, dur * 1000 + 1000);
            marqueeTimers.set(lang + '_2', t2);
        }, 500);
        marqueeTimers.set(lang + '_1', t1);
    }

    function showTranslations(results, priority) {
        results.forEach(({ lang, text }) => {
            const el   = document.getElementById('text-' + lang);
            const wrap = document.getElementById('wrap-' + lang);
            const row  = document.getElementById('row-'  + lang);
            if (!el || !wrap) return;

            // 이전 마퀴 타이머 클리어
            ['_1','_2'].forEach(s => {
                if (marqueeTimers.has(lang+s)) clearTimeout(marqueeTimers.get(lang+s));
            });
            el.style.transition = 'none';
            el.style.transform  = 'translateX(0)';

            const emoji = langEmojis[lang] || '';
            el.textContent = text ? (emoji + ' ' + text) : '';
            el.className   = 'lang-text';
            if (row) {
                row.classList.toggle('visible', !!text);
                row.classList.toggle('priority', !!priority && !!text);
            }

            if (text) {
                // 레이아웃 후 마퀴 여부 판단
                void el.offsetWidth;
                startMarquee(lang, el, wrap);
            }
        });
        clearTimeout(hideTimer);
        // 우선번역이면 8초, 일반이면 6초
        hideTimer = setTimeout(hideAll, priority ? 8000 : 6000);
    }

    // ── 소켓 이벤트 수신 (speech-mic 페이지에서 전송) ──
    socket.on('speech-settings-update', (data) => {
        if (data.langs) { activeLangs = data.langs.slice(0, 2); buildRows(activeLangs); }
    });
    socket.on('speech-interim', (data) => {
        if (!document.body.classList.contains('preview-mode')) showInterim(data.text);
    });
    socket.on('speech-translated', (data) => {
        if (!document.body.classList.contains('preview-mode')) showTranslations(data.translations, data.priority);
    });

    // 초기화
    loadSettings();

    // ── 테스트 모드 ──
    const testParam = new URLSearchParams(location.search).get('test');
    if (testParam === '1') {
        document.body.classList.add('preview-mode');

        const label = document.createElement('div');
        label.textContent = '🎤 번역 자막 미리보기 모드';
        label.style.cssText = 'position:fixed;top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.6);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:12px;font-weight:700;padding:5px 16px;border-radius:50px;z-index:9999;pointer-events:none;white-space:nowrap;';
        document.body.appendChild(label);

        const btn = document.createElement('div');
        btn.textContent = '▶ 번역 테스트 실행';
        btn.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(99,102,241,0.95);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:14px;font-weight:700;padding:12px 32px;border-radius:50px;cursor:pointer;z-index:9999;box-shadow:0 4px 24px rgba(0,0,0,0.4);user-select:none;white-space:nowrap;';
        document.body.appendChild(btn);

        const samples = ['안녕하세요! 오늘도 방송 와주셔서 감사합니다', '지금 신청곡 받고 있어요', '여러분 좋아요 눌러주세요'];
        let sIdx = 0;

        btn.addEventListener('click', async () => {
            await loadSettings();
            const text = samples[sIdx++ % samples.length];
            try {
                const res = await fetch('/api/speech/translate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, langs: activeLangs, userId })
                });
                const data = await res.json();
                if (data.success) showTranslations(data.translations);
            } catch(e) {}
        });
    }
</script>
</body>
</html>
