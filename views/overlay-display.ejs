<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Overlay - Song</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            background: transparent;
            overflow: hidden;
            width: 700px;
            height: 80px;
            margin: 0;
            padding: 0;
        }

        .overlay-bar {
            width: 700px;
            height: 80px;
            overflow: hidden;
            display: flex;
            align-items: center;
            position: relative;
            border-radius: 9999px;
        }

        /* 슬라이드 아이템 - 기본은 오른쪽 30px 안쪽 대기 */
        .slide-item {
            position: absolute;
            width: 640px;  /* 700 - 30*2 */
            height: 80px;
            left: 30px;
            display: flex;
            align-items: center;
            padding: 0 16px;
            white-space: nowrap;
            overflow: hidden;
            transform: translateX(670px);
            opacity: 0;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
        }

        /* 슬라이드 인 */
        .slide-item.slide-in {
            animation: slideIn 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
        }

        /* 슬라이드 아웃 */
        .slide-item.slide-out {
            animation: slideOut 0.35s cubic-bezier(0.55, 0, 0.1, 1) forwards;
        }

        /* 항목 1개일 때 - 고정 표시 */
        .slide-item.static-show {
            transform: translateX(0);
            opacity: 1;
        }

        @keyframes slideIn {
            from { transform: translateX(670px); opacity: 0; }
            to   { transform: translateX(0);     opacity: 1; }
        }

        @keyframes slideOut {
            from { transform: translateX(0);       opacity: 1; }
            to   { transform: translateX(-670px);  opacity: 0; }
        }

        .item-badge {
            flex-shrink: 0;
            color: #fff;
            font-weight: 700;
            font-size: 0.78em;
            padding: 3px 10px;
            border-radius: 5px;
            margin-right: 10px;
            letter-spacing: 0.02em;
        }

        .item-text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 500;
            letter-spacing: 0.01em;
        }

        .notice-icon {
            flex-shrink: 0;
            margin-right: 10px;
            font-size: 1.1em;
        }

        /* 공지 마퀴 - 슬라이드인 후 2초 뒤 시작 */
        .notice-marquee-wrap {
            flex: 1;
            overflow: hidden;
            position: relative;
        }

        .notice-marquee-track {
            display: inline-block;
            white-space: nowrap;
            /* JS로 동적으로 animation 설정 */
        }
    </style>
</head>
<body>
    <div class="overlay-bar" id="overlayBar">
        <div class="slide-item" id="slideItem"></div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const userId = '<%= userId %>';
        const socket = io();

        const params   = new URLSearchParams(location.search);
        const bgColor  = decodeURIComponent(params.get('bg')    || 'rgba(0,0,0,0.30)');
        const txtColor = params.get('color') || '#ffffff';
        const fontSize = parseInt(params.get('size') || '25');

        const bar  = document.getElementById('overlayBar');
        const item = document.getElementById('slideItem');

        bar.style.background  = bgColor;
        item.style.fontSize   = fontSize + 'px';
        item.style.color      = txtColor;

        const BADGE = {
            now:    { bg: '#16a34a', text: '▶ 현재곡' },
            next:   { bg: '#2563eb', text: '⏭ 다음곡' },
            wait1:  { bg: '#7c3aed', text: '🎶 대기1' },
            wait2:  { bg: '#7c3aed', text: '🎶 대기2' },
            notice: { bg: '#dc2626', text: '📢 공지' }
        };

        let currentSong = null;
        let nextQueue   = [];
        let notices     = [];
        let queue       = [];  // 표시할 전체 큐
        let queueIdx    = 0;
        let timer       = null;
        let isAnimating = false;

        // 공지 로드
        async function loadNotices() {
            try {
                const res = await fetch('/api/overlay-notice/' + userId);
                const data = await res.json();
                if (data.success) notices = data.notices.map(n => ({ type: 'notice', text: n.content }));
            } catch(e) {}
        }

        function buildQueue() {
            const q = [];
            if (currentSong) {
                let t = currentSong.title;
                if (currentSong.artist) t += ' / ' + currentSong.artist;
                const who = currentSong.requesterNickname || currentSong.requester;
                if (who) t += ' / ' + who;
                q.push({ type: 'now', text: t });
            }
            if (nextQueue[0]) {
                let t = nextQueue[0].title;
                if (nextQueue[0].artist) t += ' / ' + nextQueue[0].artist;
                const who = nextQueue[0].requesterNickname || nextQueue[0].requester;
                if (who) t += ' / ' + who;
                q.push({ type: 'next', text: t });
            }
            nextQueue.slice(1, 3).forEach((s, i) => {
                let t = s.title;
                if (s.artist) t += ' / ' + s.artist;
                const who = s.requesterNickname || s.requester;
                if (who) t += ' / ' + who;
                q.push({ type: i === 0 ? 'wait1' : 'wait2', text: t });
            });
            notices.forEach(n => q.push(n));
            queue = q;
        }

        function renderItem(entry) {
            if (!entry) return;
            if (entry.type === 'notice') {
                item.innerHTML =
                    '<span class="notice-icon">📢</span>'
                    + '<div class="notice-marquee-wrap">'
                    + '<span class="notice-marquee-track">' + escHtml(entry.text) + '</span>'
                    + '</div>';
            } else {
                const b = BADGE[entry.type] || BADGE.now;
                // 신청곡도 마퀴 래퍼 구조로 통일
                item.innerHTML =
                    '<span class="item-badge" style="background:' + b.bg + '">' + b.text + '</span>'
                    + '<div class="notice-marquee-wrap">'
                    + '<span class="notice-marquee-track">' + escHtml(entry.text) + '</span>'
                    + '</div>';
            }
        }

        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        function showStatic(entry) {
            renderItem(entry);
            item.className = 'slide-item static-show';
        }

        function startCycle() {
            if (timer) clearTimeout(timer);
            buildQueue();
            if (queue.length === 0) {
                item.className = 'slide-item';
                return;
            }
            if (queue.length === 1) {
                showStatic(queue[0]);
                return;
            }
            queueIdx = queueIdx % queue.length;
            showNext();
        }

        function showNext() {
            if (queue.length === 0) return;
            if (queue.length === 1) { showStatic(queue[0]); return; }

            const entry = queue[queueIdx];
            renderItem(entry);

            // 슬라이드 인 (오른쪽 30px 안쪽에서 시작)
            item.className = 'slide-item';
            void item.offsetWidth;
            item.className = 'slide-item slide-in';

            // 모든 항목: 슬라이드인(0.35s) 후 2초 대기 → 길면 마퀴, 짧으면 5초 고정
            timer = setTimeout(() => startNoticeMarquee(entry), 350 + 2000);
        }

        function startNoticeMarquee(entry) {
            // 현재 텍스트 너비 측정
            const wrap = item.querySelector('.notice-marquee-wrap');
            const track = item.querySelector('.notice-marquee-track');
            if (!wrap || !track) { doSlideOut(); return; }

            const wrapW  = wrap.offsetWidth;   // 보이는 영역 너비
            const trackW = track.scrollWidth;  // 전체 텍스트 너비

            if (trackW <= wrapW) {
                // 짧으면 그냥 5초 후 슬라이드아웃
                timer = setTimeout(doSlideOut, 3000);
                return;
            }

            // 길면 마퀴로 끝까지 이동 (속도: 60px/s)
            const distance = trackW - wrapW + 20; // 여유 20px
            const duration = distance / 60;       // 초
            track.style.transition = `transform ${duration.toFixed(2)}s linear`;
            track.style.transform  = `translateX(-${distance}px)`;

            // 마퀴 완료 후 1초 유지 → 슬라이드아웃
            timer = setTimeout(doSlideOut, duration * 1000 + 1000);
        }

        function doSlideOut() {
            item.className = 'slide-item slide-out';
            // 마퀴 track 초기화
            const track = item.querySelector('.notice-marquee-track');
            if (track) { track.style.transition = ''; track.style.transform = ''; }
            timer = setTimeout(() => {
                queueIdx = (queueIdx + 1) % queue.length;
                showNext();
            }, 360);
        }

        // 소켓 이벤트
        socket.emit('join-overlay', userId);

        socket.on('current-song', (data) => {
            currentSong = (data && data.title) ? data : null;
            startCycle();
        });

        socket.on('song-queue', (q) => {
            const all = q || [];
            if (currentSong) {
                nextQueue = all.filter(s =>
                    !(s.title === currentSong.title && s.requester === currentSong.requester)
                );
            } else {
                nextQueue = all;
            }
            startCycle();
        });

        socket.on('overlay-notice-update', () => {
            loadNotices().then(() => {
                // 타이머/애니메이션 완전 리셋 후 재시작
                if (timer) { clearTimeout(timer); timer = null; }
                isAnimating = false;
                queueIdx = 0;
                item.className = 'slide-item';
                const track = item.querySelector('.notice-marquee-track');
                if (track) { track.style.transition = ''; track.style.transform = ''; }
                startCycle();
            });
        });

        // 초기 로드
        loadNotices().then(() => startCycle());

        // 30초 주기 폴링 (소켓 미수신 대비)
        setInterval(() => {
            loadNotices().then(() => {
                if (timer) { clearTimeout(timer); timer = null; }
                isAnimating = false;
                queueIdx = 0;
                item.className = 'slide-item';
                const track = item.querySelector('.notice-marquee-track');
                if (track) { track.style.transition = ''; track.style.transform = ''; }
                startCycle();
            });
        }, 30000);
    </script>
</body>
</html>
