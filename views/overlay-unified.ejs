<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>TikFind Unified Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 1080px;
            height: 1920px;
            background: transparent;
            overflow: hidden;
            font-family: 'Noto Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
        }
        #overlay-container {
            width: 1080px;
            height: 1920px;
            position: relative;
            overflow: visible;
        }
        .widget-container {
            position: absolute;
            border: none;
            background: transparent;
        }

        /* ── 모더 공지 배너 ── */
        @keyframes mod-slide-in  { from { transform: translateX(-860px); } to { transform: translateX(0); } }
        @keyframes mod-slide-out { from { transform: translateX(0); }      to { transform: translateX(-860px); } }
        @keyframes mod-marquee   { from { transform: translateX(0); } to { transform: translateX(-50%); } }

        #mod-notice-wrap {
            position: absolute;
            top: 15px;
            left: 0;
            width: 800px;
            height: 84px;
            border-radius: 25px;
            background: rgba(37, 99, 235, 0.45);
            overflow: hidden;
            display: flex;
            align-items: center;
            pointer-events: none;
            transform: translateX(-860px);
            animation: none;
            z-index: 100;
        }
        #mod-notice-wrap.slide-in {
            animation: mod-slide-in 0.55s cubic-bezier(0.22,1,0.36,1) forwards;
        }
        #mod-notice-wrap.slide-out {
            animation: mod-slide-out 0.45s ease-in forwards;
        }
        .mod-notice-badge {
            flex-shrink: 0;
            background: #2563eb;
            color: #fff;
            font-size: 18px;
            font-weight: 900;
            letter-spacing: 0.08em;
            padding: 0 26px 0 30px;
            height: 100%;
            display: flex;
            align-items: center;
            white-space: nowrap;
            border-radius: 25px 0 0 25px;
            min-width: 108px;
            justify-content: center;
        }
        .mod-notice-scroll {
            flex: 1;
            overflow: hidden;
            height: 100%;
            display: flex;
            align-items: center;
            padding: 0 18px;
        }
        .mod-notice-track {
            display: inline-block;
            white-space: nowrap;
            color: #ffffff;
            font-size: 37px;
            font-weight: 900;
            line-height: 1;
        }

        /* ── 파티클 ── */
        #particles { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
        .pt { position:absolute; border-radius:50%; animation:pt-fly var(--d) ease-out forwards; }
        .st { position:absolute; animation:st-fly var(--d) ease-out forwards; }
        @keyframes pt-fly {
            0%   { transform:translate(0,0) scale(1); opacity:1; }
            100% { transform:translate(var(--tx),var(--ty)) scale(0); opacity:0; }
        }
        @keyframes st-fly {
            0%   { transform:translate(0,0) rotate(0deg) scale(1); opacity:1; }
            100% { transform:translate(var(--tx),var(--ty)) rotate(var(--r)) scale(0); opacity:0; }
        }

        /* ── 선물 카드 ── */
        #gift-card {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            pointer-events: none;
            max-width: 600px;
            min-width: 280px;
            width: max-content;
            z-index: 50;
        }
        @keyframes pop-mid {
            0%   { transform:translate(-50%,-50%) scale(0.5);  opacity:0; }
            65%  { transform:translate(-50%,-50%) scale(1.06); opacity:1; }
            100% { transform:translate(-50%,-50%) scale(1);    opacity:1; }
        }
        @keyframes pop-mega {
            0%   { transform:translate(-50%,-50%) scale(0.35) rotate(-4deg); opacity:0; }
            55%  { transform:translate(-50%,-50%) scale(1.08) rotate(1.5deg); opacity:1; }
            100% { transform:translate(-50%,-50%) scale(1)    rotate(0deg);   opacity:1; }
        }
        @keyframes card-out {
            0%   { opacity:1; transform:translate(-50%,-50%) scale(1) translateY(0); }
            100% { opacity:0; transform:translate(-50%,-50%) scale(0.9) translateY(-12px); }
        }
        .card-inner {
            display: inline-flex;
            flex-direction: row;
            align-items: center;
            gap: 0;
            border-radius: 9999px;
            padding: 0;
            position: relative;
            overflow: hidden;
            white-space: nowrap;
        }
        .mid-style {
            background: rgba(14,8,30,0.90);
            border: 1.5px solid rgba(168,85,247,0.7);
            box-shadow: 0 0 32px rgba(168,85,247,0.5), 0 8px 28px rgba(0,0,0,0.65);
        }
        .mega-style {
            background: rgba(10,4,22,0.92);
            border: 2px solid rgba(249,212,35,0.8);
            box-shadow: 0 0 40px rgba(249,212,35,0.55), 0 8px 28px rgba(0,0,0,0.75);
        }
        #card-avatar {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            flex-shrink: 0;
            background: #1a0a2e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 900;
            color: #fff;
            overflow: hidden;
            position: relative;
            margin: 8px 0 8px 8px;
        }
        #card-avatar img {
            width: 100%; height: 100%; object-fit: cover; display: block;
        }
        .mid-style  #card-avatar { box-shadow: 0 0 0 3px rgba(168,85,247,0.85), 0 0 20px rgba(168,85,247,0.55); }
        .mega-style #card-avatar { box-shadow: 0 0 0 3px rgba(249,212,35,0.95), 0 0 24px rgba(249,212,35,0.65); }
        #card-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 10px 28px 10px 14px;
            gap: 5px;
            min-width: 0;
        }
        #card-nickname {
            font-weight: 900;
            line-height: 1.05;
            letter-spacing: -0.02em;
            word-break: keep-all;
            white-space: nowrap;
            font-size: 40px;
        }
        #card-nickname.len-mid  { font-size: 30px; }
        #card-nickname.len-long { font-size: 22px; letter-spacing: -0.03em; }
        .mid-nick {
            color: #ffffff;
            text-shadow: 0 0 24px rgba(168,85,247,1), 0 0 48px rgba(168,85,247,0.55), 0 3px 0 rgba(0,0,0,1);
        }
        .mega-nick {
            background: linear-gradient(135deg, #fff9c4 0%, #fde68a 25%, #f9d423 50%, #ff6b35 75%, #ff4e50 100%);
            -webkit-background-clip: text; background-clip: text; color: transparent;
            filter: drop-shadow(0 0 16px rgba(249,212,35,0.95)) drop-shadow(0 3px 0 rgba(0,0,0,1));
        }
        #card-label {
            font-size: 18px;
            font-weight: 900;
            letter-spacing: 0.03em;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 420px;
            overflow: hidden;
        }
        #card-label-text {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            min-width: 0;
        }
        .mid-style  #card-label { color: #e9d5ff; }
        .mega-style #card-label { color: #fde68a; }
        #card-score {
            font-size: 15px;
            font-weight: 900;
            padding: 2px 9px;
            border-radius: 20px;
            white-space: nowrap;
        }
        .mid-style  #card-score { background:rgba(168,85,247,0.25); color:#d8b4fe; border:1px solid rgba(168,85,247,0.4); }
        .mega-style #card-score { background:rgba(249,212,35,0.2);  color:#fde68a; border:1px solid rgba(249,212,35,0.5); }
        .card-shine {
            position: absolute; inset: 0;
            background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,0.06) 50%, transparent 70%);
            animation: shine 2.8s ease-in-out infinite;
            pointer-events: none;
        }
        @keyframes shine { 0%{transform:translateX(-100%)} 100%{transform:translateX(200%)} }

        /* ── 룰렛 위젯 ── */
        #roulette-wrap {
            position: absolute;
            left: 300px;
            top: 650px;
            width: 622px; height: 622px;
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
            z-index: 60;
        }
        #roulette-wrap.spinning { opacity: 1; }
        #roulette-ring {
            position: absolute;
            width: 622px; height: 622px;
            border-radius: 50%;
            background: conic-gradient(#ffd700, #ff6b6b, #a855f7, #3b82f6, #22c55e, #ffd700);
            animation: ringGlow 1.8s ease-in-out infinite alternate;
        }
        @keyframes ringGlow {
            from { box-shadow: 0 0 30px #ffd70099, 0 0 60px #ff6b6b44; }
            to   { box-shadow: 0 0 60px #ffd700cc, 0 0 100px #a855f766; }
        }
        #roulette-canvas-wrap {
            position: absolute;
            left: 8px; top: 8px;
            width: 606px; height: 606px;
            border-radius: 50%;
            overflow: hidden;
        }
        #roulette-pointer {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 0; height: 0;
            border-top: 18px solid transparent;
            border-bottom: 18px solid transparent;
            border-right: 48px solid #ffd700;
            filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
            z-index: 20;
        }
        #roulette-center-badge {
            position: absolute;
            left: 50%; top: 50%;
            transform: translate(-50%, -50%);
            width: 76px; height: 76px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
            border: 3px solid #ffd700;
            box-shadow: 0 0 20px rgba(124,58,237,0.8), 0 4px 16px rgba(0,0,0,0.6);
            z-index: 21;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 1px;
        }
        #roulette-center-badge .cb-icon { font-size: 18px; line-height: 1; }
        #roulette-center-badge .cb-text {
            font-size: 9px; font-weight: 900; color: #ffd700;
            letter-spacing: 0.5px; text-shadow: 0 1px 3px rgba(0,0,0,0.7);
        }
        #roulette-flash-overlay {
            position: absolute;
            left: 8px; top: 8px;
            width: 606px; height: 606px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 19;
            opacity: 0;
        }
        @keyframes rouletteWinFlash {
            0%   { opacity: 0; }
            15%  { opacity: 0.82; }
            30%  { opacity: 0.1; }
            45%  { opacity: 0.75; }
            60%  { opacity: 0.1; }
            75%  { opacity: 0.65; }
            88%  { opacity: 0.1; }
            100% { opacity: 0; }
        }
        .roulette-spark { position: absolute; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; animation: rouletteSparkFly 1.2s ease-out forwards; }
        @keyframes rouletteSparkFly { 0%{opacity:1;transform:translate(0,0) scale(1)} 100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(0)} }
    </style>
</head>
<body>
    <div id="overlay-container">
        <!-- 위젯들은 JS로 동적 로드 -->
    </div>

    <!-- 선물 위젯 요소 (통합) -->
    <div id="particles"></div>
    <div id="mod-notice-wrap">
        <div class="mod-notice-badge" id="mod-notice-badge">TikFind</div>
        <div class="mod-notice-scroll">
            <div class="mod-notice-track" id="mod-notice-track"></div>
        </div>
    </div>
    <div id="gift-card">
        <div class="card-inner" id="card-inner">
            <div class="card-shine"></div>
            <div id="card-avatar"></div>
            <div id="card-text">
                <div id="card-nickname"></div>
                <div id="card-label"><span id="card-label-text"></span><span id="card-score"></span></div>
            </div>
        </div>
    </div>

    <!-- 룰렛 위젯 요소 (통합) -->
    <div id="roulette-wrap">
        <div id="roulette-ring"></div>
        <div id="roulette-canvas-wrap">
            <canvas id="roulette-canvas" width="606" height="606"></canvas>
        </div>
        <div id="roulette-pointer"></div>
        <div id="roulette-flash-overlay"></div>
        <div id="roulette-center-badge">
            <span class="cb-icon">🎯</span>
            <span class="cb-text">TIKFIND</span>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const userId = '<%= userId %>';
        const socket = io();

        let positions = {};
        let MID_MIN  = 100;
        let MEGA_MIN = 1000;

        // 선물 큐
        const giftQueue = [];
        let giftBusy = false;

        // 모더 공지 타이머
        let noticeHideTimer = null;
        const NOTICE_SHOW_MS = 12000;

        // 테스트 모드 체크
        const testMode = new URLSearchParams(location.search).get('test') === '1';

        // 초기화
        async function init() {
            console.log('🎬 통합오버레이 초기화 시작');
            
            // 강제로 크기 설정 (틱톡 스튜디오 재시작 시 크기 유지)
            document.documentElement.style.width = '1080px';
            document.documentElement.style.height = '1920px';
            document.body.style.width = '1080px';
            document.body.style.height = '1920px';

            // 선물 기준 로드
            try {
                const res = await fetch('/api/gift-settings');
                const d = await res.json();
                if (d.success) {
                    MID_MIN  = d.midMin  ?? 100;
                    MEGA_MIN = d.megaMin ?? 1000;
                    console.log('✅ 선물 기준 로드:', { MID_MIN, MEGA_MIN });
                }
            } catch(e) {
                console.error('❌ 선물 기준 로드 실패:', e);
            }

            await loadPositions();
            renderWidgets();

            // 오디오 컨텍스트 초기화
            try { getCtx(); } catch(e) {}
            setTimeout(() => { try { getCtx(); } catch(e) {} }, 500);
            
            // 테스트 모드
            if (testMode) {
                console.log('🧪 테스트 모드 활성화');
                runTestMode();
            }
        }

        async function loadPositions() {
            try {
                const res = await fetch(`/api/overlay-positions-public/${userId}`);
                const data = await res.json();
                if (data.success && data.positions) {
                    positions = data.positions;
                    console.log('✅ 위젯 위치 로드:', positions);
                } else {
                    console.log('⚠️ 위젯 위치 없음, 기본값 사용');
                }
            } catch (e) {
                console.error('❌ 위치 로드 실패:', e);
            }
        }

        function renderWidgets() {
            const container = document.getElementById('overlay-container');
            container.innerHTML = '';

            // 위젯 설정 가져오기
            const overlaySettings = <%- JSON.stringify(overlaySettings || {}) %>;
            const speechLangs = <%- JSON.stringify(speechLangs || ['en']) %>;

            // 신청곡+공지 위젯
            if (positions.song && positions.song.visible) {
                const song = positions.song;
                const iframe = document.createElement('iframe');
                iframe.className = 'widget-container';
                iframe.style.left = `${song.x}px`;
                iframe.style.top = `${song.y}px`;
                iframe.style.width = `${song.width}px`;
                iframe.style.height = `${song.height}px`;
                const fontSize = overlaySettings?.fontSize || 35;
                const bgColor = overlaySettings?.bgColor || 'rgba(0,0,0,0.8)';
                const textColor = overlaySettings?.textColor || '#ffffff';
                iframe.src = `/overlay/${userId}?fontSize=${fontSize}&bgColor=${encodeURIComponent(bgColor)}&textColor=${encodeURIComponent(textColor)}`;
                container.appendChild(iframe);
            }

            // 번역 자막 위젯
            if (positions.speech && positions.speech.visible) {
                const speech = positions.speech;
                const iframe = document.createElement('iframe');
                iframe.className = 'widget-container';
                iframe.style.left = `${speech.x}px`;
                iframe.style.top = `${speech.y}px`;
                iframe.style.width = `${speech.width}px`;
                iframe.style.height = `${speech.height}px`;
                const langs = speechLangs.join(',');
                iframe.src = `/overlay/${userId}/speech?langs=${langs}`;
                container.appendChild(iframe);
            }

            // 선물 위젯 위치 설정 (iframe 대신 직접 렌더링)
            // 모더 공지 배너와 선물 카드는 항상 표시 (매치코칭, ##공지, ??GPT 등)
            const modNoticeWrap = document.getElementById('mod-notice-wrap');
            const giftCard = document.getElementById('gift-card');

            // 선물 위젯은 visible 체크 없이 항상 표시 (매치코칭, 모더공지 포함)
            if (positions.gift) {
                const gift = positions.gift;
                // 모더 공지 배너 위치
                modNoticeWrap.style.left = `${gift.x}px`;
                modNoticeWrap.style.top = `${gift.y}px`;
                // 선물 카드 위치 (위젯 중앙)
                giftCard.style.left = `${gift.x + gift.width / 2}px`;
                giftCard.style.top = `${gift.y + gift.height / 2}px`;
                console.log('✅ 선물 위젯 위치 설정:', gift);
            } else {
                // 위치 정보 없으면 기본 위치 사용
                modNoticeWrap.style.left = '0px';
                modNoticeWrap.style.top = '15px';
                giftCard.style.left = '540px';
                giftCard.style.top = '960px';
                console.log('⚠️ 선물 위젯 기본 위치 사용');
            }

            // 모더 위젯
            if (positions.moderator && positions.moderator.visible) {
                const moderator = positions.moderator;
                const iframe = document.createElement('iframe');
                iframe.className = 'widget-container';
                iframe.style.left = `${moderator.x}px`;
                iframe.style.top = `${moderator.y}px`;
                iframe.style.width = `${moderator.width}px`;
                iframe.style.height = `${moderator.height}px`;
                iframe.src = `/overlay/${userId}/moderator`;
                container.appendChild(iframe);
            }

            // 50레벨 시청자 위젯 (왼쪽 위치)
            if (positions.level50 && positions.level50.visible) {
                const level50 = positions.level50;
                const iframe = document.createElement('iframe');
                iframe.className = 'widget-container';
                iframe.style.left = `${level50.x ?? 0}px`;
                iframe.style.top = `${level50.y ?? 650}px`;
                iframe.style.width = `${level50.width ?? 120}px`;
                iframe.style.height = `${level50.height ?? 100}px`;
                iframe.src = `/overlay/${userId}/level50`;
                container.appendChild(iframe);
                console.log('✅ 50레벨 위젯 iframe 추가:', iframe.src);
            }

            // 룰렛 미션 위젯 위치 설정 (직접 통합됨)
            if (positions.roulette && positions.roulette.visible) {
                const roulette = positions.roulette;
                const rouletteEl = document.getElementById('roulette-wrap');
                if (rouletteEl) {
                    rouletteEl.style.left = `${roulette.x ?? 0}px`;
                    rouletteEl.style.top = `${roulette.y ?? 650}px`;
                    console.log('✅ 룰렛 위치 설정:', roulette);
                }
            }
        }

        function setupSocketListeners() {
            console.log('🔌 Socket.io 리스너 등록 시작');
            console.log('✅ Socket.io 연결 상태:', socket.connected);
            
            // 소켓 연결 시 오버레이 룸 참가
            function joinOverlay() {
                socket.emit('join-overlay', userId);
                console.log('🎬 오버레이 룸 참가:', `overlay-${userId}`);
            }
            
            socket.on('connect', () => {
                console.log('✅ Socket.io 연결됨');
                joinOverlay();
            });
            
            socket.on('disconnect', () => {
                console.log('❌ Socket.io 연결 끊김');
            });
            
            socket.on('reconnect', () => {
                console.log('� Socket.io 재연결됨');
                joinOverlay();
            });
            
            if (socket.connected) joinOverlay();

            // 선물 알림
            socket.on('overlay-gift', (data) => {
                console.log('🎁 선물 수신:', data);

                const pts = data.totalDiamonds || data.diamondCount || 0;
                if (pts < MID_MIN) {
                    console.log('⚠️ 선물 기준 미달:', pts, '<', MID_MIN);
                    return;
                }
                giftQueue.push(data);
                if (!giftBusy) nextGift();
            });

            // 선물 설정 업데이트
            socket.on('gift-settings-update', (data) => {
                if (data.midMin  != null) MID_MIN  = data.midMin;
                if (data.megaMin != null) MEGA_MIN = data.megaMin;
                console.log('⚙️ 선물 기준 업데이트:', { MID_MIN, MEGA_MIN });
            });

            // 모더 공지 (##문구, ??GPT질문 포함)
            socket.on('overlay-mod-notice', (data) => {
                console.log('📢 모더 공지 수신:', data);
                showModNotice(data);
            });

            // AI 매치 코치
            socket.on('match-coach', (data) => {
                console.log('🤖 매치 코치 수신:', data);
                const situationIcon = data.situation === 'start' ? '⚔️' :
                                      data.situation === 'early' ? '🔥' :
                                      data.situation === 'mid'   ? '📊' : '🚀';
                showModNotice({ text: situationIcon + ' ' + data.message });
            });
            
            console.log('✅ Socket.io 리스너 등록 완료');

            // 기존 이벤트들
            socket.on('new-song', (data) => {
                // 신청곡 업데이트
            });

            socket.on('gift-notification', (data) => {
                // 선물 알림
            });

            socket.on('moderator-update', (data) => {
                // 모더 업데이트
            });

            socket.on('speech-translation', (data) => {
                // 번역 자막
            });

            socket.on('roulette-spin', (data) => {
                console.log('🎰 룰렛 스핀 수신:', data);
                if (rouletteAudioCtx && rouletteAudioCtx.state === 'suspended') rouletteAudioCtx.resume();
                spinRoulette(data.items || null, data.winIndex);
            });

            socket.on('roulette-items-update', (data) => {
                if (data.items && data.items.length) {
                    rouletteItems = data.items;
                    drawRoulette(rouletteCurrentAngle);
                }
            });
        }

        // ── 모더 공지 배너 ──
        function showModNotice(d) {
            const wrap  = document.getElementById('mod-notice-wrap');
            const track = document.getElementById('mod-notice-track');
            const badge = document.getElementById('mod-notice-badge');
            if (!d.text) return;

            badge.textContent = 'TikFind';

            track.style.animation = 'none';
            void track.offsetWidth;
            track.textContent = d.text;
            void track.offsetWidth;
            const textW = track.scrollWidth;
            const scrollW = wrap.querySelector('.mod-notice-scroll').clientWidth || 620;

            if (textW > scrollW) {
                track.textContent = d.text + '　　　　' + d.text;
                const spd = Math.max(4, Math.round(textW / 80));
                track.style.animation = 'mod-marquee ' + spd + 's linear infinite';
            }

            clearTimeout(noticeHideTimer);
            wrap.classList.remove('slide-out');
            void wrap.offsetWidth;
            wrap.classList.add('slide-in');

            noticeHideTimer = setTimeout(() => {
                wrap.classList.remove('slide-in');
                wrap.classList.add('slide-out');
                setTimeout(() => {
                    wrap.classList.remove('slide-out');
                    track.style.animation = 'none';
                    track.textContent = '';
                }, 480);
            }, NOTICE_SHOW_MS);
        }

        // ── 선물 알림 ──
        function nextGift() {
            if (!giftQueue.length) { giftBusy = false; return; }
            giftBusy = true;
            showGift(giftQueue.shift());
        }

        function safeName(d) {
            const n = (d.nickname || '').trim() || (d.uniqueId || '').trim() || '익명';
            return n.length > 18 ? n.slice(0, 18) + '…' : n;
        }

        function applyNameSize(el, name) {
            el.classList.remove('len-mid', 'len-long');
            if      (name.length > 10) el.classList.add('len-long');
            else if (name.length > 6)  el.classList.add('len-mid');
        }

        const midMsgs  = ['이름을 새기다 ✨','존재감 폭발 💥','빛나는 순간 🌟','화면을 물들이다 🎨','마음을 전하다 💌','이 순간의 주인공 🎬','함께해서 빛난다 🌈','당신이 특별하다 🫶','온기를 나누다 🔥','기억에 남을 이름 📍'];
        const megaMsgs = ['전설이 되다 👑','방송을 지배하다 💎','오늘의 주인공 🔥','레전드 등극 🏆','하늘을 찌르다 🚀','영원히 기억될 이름 ⚡','이 방송의 신 🌌','모두가 주목한다 👁️','압도적 존재감 💫','역사에 남을 순간 🎆','이 방송을 빛내다 ✨','최고 응원 감사해요 🙏','당신 없인 방송 없다 💖','경의를 표합니다 🫅','온 방송이 당신 덕분 🌠'];
        function randMsg(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

        function showGift(d) {
            const pts    = d.totalDiamonds || d.diamondCount || 0;
            const isMega = pts >= MEGA_MIN;
            const dur    = isMega ? 8000 : 6500;
            const name   = safeName(d);

            const card     = document.getElementById('gift-card');
            const inner    = document.getElementById('card-inner');
            const nickEl   = document.getElementById('card-nickname');
            const avatarEl = document.getElementById('card-avatar');
            const scoreEl  = document.getElementById('card-score');

            card.style.animation = 'none';
            card.style.opacity   = '0';
            void card.offsetWidth;

            inner.className  = 'card-inner ' + (isMega ? 'mega-style' : 'mid-style');
            nickEl.className = isMega ? 'mega-nick' : 'mid-nick';
            applyNameSize(nickEl, name);
            nickEl.textContent = name;

            document.getElementById('card-label-text').textContent = randMsg(isMega ? megaMsgs : midMsgs);
            scoreEl.textContent   = pts > 0 ? '💎 ' + Number(pts).toLocaleString() : '';
            scoreEl.style.display = pts > 0 ? '' : 'none';

            avatarEl.innerHTML = '';
            if (d.profilePictureUrl) {
                const img = document.createElement('img');
                img.src = d.profilePictureUrl;
                img.onerror = () => { avatarEl.innerHTML = ''; avatarEl.textContent = name.charAt(0).toUpperCase(); };
                avatarEl.appendChild(img);
            } else {
                avatarEl.textContent = name.charAt(0).toUpperCase();
            }

            spawnParticles(isMega);
            playSound(isMega);

            card.style.animation = (isMega ? 'pop-mega' : 'pop-mid') + ' 0.55s cubic-bezier(0.34,1.56,0.64,1) forwards';

            setTimeout(() => {
                card.style.animation = 'card-out 0.5s ease forwards';
                setTimeout(() => {
                    card.style.animation = 'none';
                    card.style.opacity   = '0';
                    document.getElementById('particles').innerHTML = '';
                    nextGift();
                }, 520);
            }, dur);
        }

        // ── 파티클 ──
        function spawnParticles(isMega) {
            const cnt = isMega ? 60 : 28;
            const cx  = 540; // 화면 중앙 x
            const cy  = 960; // 화면 중앙 y
            const con = document.getElementById('particles');
            const cols = isMega
                ? ['#f9d423','#ff4e50','#a855f7','#3b82f6','#10b981','#fbbf24','#ec4899','#fff']
                : ['#a855f7','#c084fc','#e879f9','#7c3aed','#ddd6fe','#fff'];
            const syms = ['✦','★','◆','✸','❋'];

            for (let i = 0; i < cnt; i++) {
                const ang  = (Math.PI * 2 * i / cnt) + Math.random() * 0.5;
                const dist = 60 + Math.random() * (isMega ? 160 : 100);
                const tx   = Math.cos(ang) * dist;
                const ty   = Math.sin(ang) * dist;
                const dur  = (0.6 + Math.random() * 1.1).toFixed(2) + 's';
                const col  = cols[Math.floor(Math.random() * cols.length)];
                const el   = document.createElement('div');

                if (isMega && Math.random() > 0.45) {
                    el.className = 'st';
                    el.textContent = syms[Math.floor(Math.random() * syms.length)];
                    el.style.cssText = `left:${cx+(Math.random()-0.5)*40}px;top:${cy+(Math.random()-0.5)*40}px;color:${col};font-size:${11+Math.random()*14}px;--tx:${tx}px;--ty:${ty}px;--d:${dur};--r:${Math.random()*360}deg`;
                } else {
                    const sz = 4 + Math.random() * (isMega ? 8 : 5);
                    el.className = 'pt';
                    el.style.cssText = `width:${sz}px;height:${sz}px;left:${cx+(Math.random()-0.5)*40}px;top:${cy+(Math.random()-0.5)*40}px;background:${col};box-shadow:0 0 ${sz*2}px ${col};--tx:${tx}px;--ty:${ty}px;--d:${dur}`;
                }
                con.appendChild(el);
            }
        }

        // ── 음향 ──
        let actx = null;
        function getCtx() {
            if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
            return actx;
        }
        function playSound(isMega) { try { isMega ? fanfare() : chime(); } catch(e) {} }

        function chime() {
            const ctx = getCtx();
            [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
                const o = ctx.createOscillator(), g = ctx.createGain();
                o.connect(g); g.connect(ctx.destination);
                o.type = 'sine'; o.frequency.value = f;
                const t = ctx.currentTime + i * 0.13;
                g.gain.setValueAtTime(0, t);
                g.gain.linearRampToValueAtTime(0.30, t + 0.02);
                g.gain.exponentialRampToValueAtTime(0.001, t + 1.2);
                o.start(t); o.stop(t + 1.25);
            });
        }

        function fanfare() {
            const ctx = getCtx();
            const now = ctx.currentTime;

            const mkOsc = (type, freq, vol, start, end) => {
                const o = ctx.createOscillator(), g = ctx.createGain();
                o.connect(g); g.connect(ctx.destination);
                o.type = type; o.frequency.value = freq;
                g.gain.setValueAtTime(0, start);
                g.gain.linearRampToValueAtTime(vol, start + 0.02);
                g.gain.exponentialRampToValueAtTime(0.001, end);
                o.start(start); o.stop(end + 0.05);
            };

            mkOsc('sine',   55,  0.75, now,       now + 0.5);
            mkOsc('sine',   82,  0.55, now,       now + 0.45);
            mkOsc('square', 55,  0.15, now,       now + 0.3);

            [[130.81,0.05],[164.81,0.05],[196,0.05],[261.63,0.08]]
                .forEach(([f,dt]) => mkOsc('sawtooth', f, 0.18, now+dt, now+dt+0.9));

            [[523.25,0.12],[659.25,0.22],[783.99,0.32],[1046.5,0.44],[1318.51,0.55],[1567.98,0.65]]
                .forEach(([f,dt]) => mkOsc('triangle', f, 0.30, now+dt, now+dt+0.85));

            [[2093,0.90],[2637,1.02],[3135.96,1.14]]
                .forEach(([f,dt]) => mkOsc('sine', f, 0.22, now+dt, now+dt+0.75));

            [[1046.5,1.4],[1318.51,1.42],[1567.98,1.44],[2093,1.46]]
                .forEach(([f,dt]) => mkOsc('sine', f, 0.28, now+dt, now+dt+1.2));

            setTimeout(() => {
                try {
                    const c = getCtx();
                    const t = c.currentTime;
                    [2093,2637,3135.96,4186].forEach((f,i) => mkOsc('sine',f,0.20,t+i*0.055,t+i*0.055+0.7));
                } catch(e) {}
            }, 2000);
        }

        document.addEventListener('click', () => { try { getCtx().resume(); } catch(e) {} }, { once: true });

        // ── 룰렛 위젯 ──
        const ROULETTE_MISSION_POOL = [
            { label: '🎤 강제 삼행시',         color: '#e74c3c' },
            { label: '🎭 복불복 성대모사',      color: '#9b59b6' },
            { label: '🤣 웃긴 필터 방송',       color: '#2980b9' },
            { label: '🎵 한 소절 라이브',       color: '#27ae60' },
            { label: '👆 손가락 댄스',          color: '#e67e22' },
            { label: '👁️ 강철 눈싸움',          color: '#c0392b' },
            { label: '💕 치명적 애교 3종',      color: '#e91e8c' },
            { label: '🔮 신비로운 타로',        color: '#8e44ad' },
            { label: '🎙️ 초밀착 ASMR',          color: '#16a085' },
            { label: '🎵 오늘의 엔딩곡 선곡',   color: '#d35400' },
        ];

        function pickRandomRoulette(pool, count) {
            return [...pool].sort(() => Math.random() - 0.5).slice(0, count);
        }

        let rouletteItems = pickRandomRoulette(ROULETTE_MISSION_POOL, 5);
        let rouletteCurrentAngle = 0;
        let rouletteSpinning = false;
        let rouletteTickTimer = null;

        const rouletteCanvas = document.getElementById('roulette-canvas');
        const rouletteCtx = rouletteCanvas ? rouletteCanvas.getContext('2d') : null;
        const rouletteWrap = document.getElementById('roulette-wrap');

        let rouletteAudioCtx = null;
        try { rouletteAudioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}

        function playRouletteSpinTick() {
            if (!rouletteAudioCtx) return;
            const osc = rouletteAudioCtx.createOscillator();
            const gain = rouletteAudioCtx.createGain();
            osc.connect(gain); gain.connect(rouletteAudioCtx.destination);
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(600, rouletteAudioCtx.currentTime);
            gain.gain.setValueAtTime(0.18, rouletteAudioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, rouletteAudioCtx.currentTime + 0.07);
            osc.start(); osc.stop(rouletteAudioCtx.currentTime + 0.07);
        }

        function playRouletteWinSound() {
            if (!rouletteAudioCtx) return;
            const notes = [523, 659, 784, 1047];
            notes.forEach((freq, i) => {
                const osc = rouletteAudioCtx.createOscillator();
                const gain = rouletteAudioCtx.createGain();
                osc.connect(gain); gain.connect(rouletteAudioCtx.destination);
                osc.type = 'sine';
                const t = rouletteAudioCtx.currentTime + i * 0.13;
                osc.frequency.setValueAtTime(freq, t);
                gain.gain.setValueAtTime(0.35, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
                osc.start(t); osc.stop(t + 0.35);
            });
        }

        function lightenColor(hex, amount) {
            const num = parseInt(hex.replace('#',''), 16);
            const r = Math.min(255, (num >> 16) + amount);
            const g = Math.min(255, ((num >> 8) & 0xff) + amount);
            const b = Math.min(255, (num & 0xff) + amount);
            return `rgb(${r},${g},${b})`;
        }

        function drawRoulette(angle) {
            if (!rouletteCtx) return;
            const cx = 303, cy = 303, r = 299;
            const n = rouletteItems.length;
            const slice = (2 * Math.PI) / n;
            rouletteCtx.clearRect(0, 0, 606, 606);

            rouletteItems.forEach((item, i) => {
                const start = angle + i * slice - Math.PI / 2;
                const end = start + slice;

                rouletteCtx.beginPath();
                rouletteCtx.moveTo(cx, cy);
                rouletteCtx.arc(cx, cy, r, start, end);
                rouletteCtx.closePath();

                const grad = rouletteCtx.createRadialGradient(cx, cy, 0, cx, cy, r);
                grad.addColorStop(0, lightenColor(item.color, 45));
                grad.addColorStop(1, item.color);
                rouletteCtx.fillStyle = grad;
                rouletteCtx.fill();
                rouletteCtx.strokeStyle = 'rgba(255,255,255,0.22)';
                rouletteCtx.lineWidth = 2;
                rouletteCtx.stroke();

                rouletteCtx.save();
                rouletteCtx.translate(cx, cy);
                rouletteCtx.rotate(start + slice / 2);
                rouletteCtx.textAlign = 'right';
                rouletteCtx.fillStyle = '#fff';
                rouletteCtx.shadowColor = 'rgba(0,0,0,0.8)';
                rouletteCtx.shadowBlur = 8;
                rouletteCtx.font = 'bold 34px "Noto Sans KR", sans-serif';
                rouletteCtx.fillText(item.label, r - 16, 12);
                rouletteCtx.restore();
            });

            rouletteCtx.beginPath();
            rouletteCtx.arc(cx, cy, 40, 0, 2 * Math.PI);
            rouletteCtx.fillStyle = '#1a1a2e';
            rouletteCtx.fill();
            rouletteCtx.strokeStyle = '#ffd700';
            rouletteCtx.lineWidth = 3;
            rouletteCtx.stroke();
        }

        function setRouletteTickInterval(ms) {
            clearInterval(rouletteTickTimer);
            rouletteTickTimer = setInterval(() => playRouletteSpinTick(), ms);
        }

        function rouletteEaseOut(t) { return 1 - Math.pow(1 - t, 5); }
        function rouletteEaseInOut(t) { return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2; }

        function spinRoulette(targetItems, winIndex) {
            if (rouletteSpinning || !rouletteWrap) return;
            rouletteSpinning = true;
            rouletteItems = (targetItems && targetItems.length) ? targetItems : pickRandomRoulette(ROULETTE_MISSION_POOL, 5);

            rouletteWrap.classList.add('spinning');

            const n = rouletteItems.length;
            const slice = (2 * Math.PI) / n;

            const PREVIEW_DURATION = 10000;
            const PREVIEW_DELTA = 1.5 * 2 * Math.PI;
            const SPIN_DURATION = 14400;
            const SPIN_EXTRA = (15 + Math.floor(Math.random() * 4)) * 2 * Math.PI;

            const edgeOffset = slice * (0.08 + Math.random() * 0.07);
            const side = Math.random() < 0.5 ? 1 : -1;
            const targetAngle = Math.PI / 2 - (winIndex + 0.5) * slice + side * (slice / 2 - edgeOffset);

            setRouletteTickInterval(300);

            const previewStartAngle = rouletteCurrentAngle;
            const previewStartTime = performance.now();

            function previewFrame(now) {
                const t = Math.min((now - previewStartTime) / PREVIEW_DURATION, 1);
                const angle = previewStartAngle + PREVIEW_DELTA * rouletteEaseInOut(t);
                drawRoulette(angle);

                const speed = Math.abs(rouletteEaseInOut(Math.min(t + 0.01, 1)) - rouletteEaseInOut(t)) / 0.01;
                const interval = Math.max(120, Math.min(500, Math.round(180 / (speed * 50 + 0.1))));
                clearInterval(rouletteTickTimer);
                rouletteTickTimer = setInterval(() => playRouletteSpinTick(), interval);

                if (t < 1) {
                    requestAnimationFrame(previewFrame);
                } else {
                    rouletteCurrentAngle = angle;
                    startMainRouletteSpin();
                }
            }
            requestAnimationFrame(previewFrame);

            function startMainRouletteSpin() {
                let delta = ((targetAngle - rouletteCurrentAngle) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
                if (delta < 0.1) delta += 2 * Math.PI;
                const totalDelta = SPIN_EXTRA + delta;
                const spinStart = rouletteCurrentAngle;
                const spinStartT = performance.now();
                let tickInterval = 80;
                setRouletteTickInterval(tickInterval);

                function spinFrame(now) {
                    const t = Math.min((now - spinStartT) / SPIN_DURATION, 1);
                    const angle = spinStart + totalDelta * rouletteEaseOut(t);
                    drawRoulette(angle);

                    const newInterval = Math.max(80, Math.floor(80 + 500 * rouletteEaseOut(t)));
                    if (newInterval !== tickInterval) {
                        tickInterval = newInterval;
                        setRouletteTickInterval(tickInterval);
                    }

                    if (t < 1) {
                        requestAnimationFrame(spinFrame);
                    } else {
                        rouletteCurrentAngle = angle;
                        rouletteSpinning = false;
                        clearInterval(rouletteTickTimer);
                        rouletteTickTimer = null;
                        showRouletteResult(rouletteItems[winIndex]);
                    }
                }
                requestAnimationFrame(spinFrame);
            }
        }

        function showRouletteResult(item) {
            playRouletteWinSound();
            spawnRouletteSparks();
            flashRouletteWinSlice(item);
            setTimeout(() => {
                if (rouletteWrap) rouletteWrap.classList.remove('spinning');
            }, 9000);
        }

        function flashRouletteWinSlice(item) {
            const overlay = document.getElementById('roulette-flash-overlay');
            if (!overlay) return;
            overlay.style.background = `radial-gradient(circle at center, ${item.color}dd 0%, ${item.color}55 45%, transparent 70%)`;
            overlay.style.animation = 'none';
            void overlay.offsetWidth;
            overlay.style.animation = 'rouletteWinFlash 2.4s ease-out forwards';
        }

        function spawnRouletteSparks() {
            if (!rouletteWrap) return;
            const colors = ['#ffd700','#ff6b6b','#a855f7','#22c55e','#3b82f6'];
            for (let i = 0; i < 28; i++) {
                const s = document.createElement('div');
                s.className = 'roulette-spark';
                s.style.background = colors[i % colors.length];
                s.style.left = '311px'; s.style.top = '311px';
                const ang = Math.random() * 2 * Math.PI;
                const dist = 80 + Math.random() * 180;
                s.style.setProperty('--tx', Math.cos(ang) * dist + 'px');
                s.style.setProperty('--ty', Math.sin(ang) * dist + 'px');
                rouletteWrap.appendChild(s);
                setTimeout(() => s.remove(), 1300);
            }
        }

        // 룰렛 초기화
        if (rouletteCanvas) drawRoulette(0);

        // 테스트 모드 함수
        function runTestMode() {
            const testLabel = document.createElement('div');
            testLabel.textContent = '🧪 테스트 모드 활성화';
            testLabel.style.cssText = 'position:fixed;top:10px;right:10px;background:rgba(255,0,0,0.8);color:#fff;padding:8px 16px;border-radius:8px;font-size:14px;font-weight:700;z-index:9999;';
            document.body.appendChild(testLabel);
            
            // 3초 후 선물 테스트
            setTimeout(() => {
                console.log('🧪 테스트: 선물 알림');
                giftQueue.push({
                    nickname: '테스트유저',
                    uniqueId: 'testuser',
                    profilePictureUrl: '',
                    totalDiamonds: 500
                });
                if (!giftBusy) nextGift();
            }, 3000);
            
            // 6초 후 매치 코치 테스트
            setTimeout(() => {
                console.log('🧪 테스트: 매치 코치');
                showModNotice({ text: '🔥 테스트: 지금이 역전의 기회입니다!' });
            }, 6000);
            
            // 9초 후 모더 공지 테스트
            setTimeout(() => {
                console.log('🧪 테스트: 모더 공지');
                showModNotice({ text: '📢 테스트: 공지사항입니다' });
            }, 9000);
        }

        // Socket.io 리스너 즉시 등록 (init 전에!)
        setupSocketListeners();
        
        // 나머지 초기화
        init();
    </script>
