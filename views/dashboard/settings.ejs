<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>설정 - TikFind</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .tab-btn { transition: all .2s; border-bottom: 3px solid transparent; }
        .tab-btn.active { border-bottom-color: #6366f1; color: #6366f1; font-weight: 700; }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
    </style>
</head>
<body class="bg-gray-50">
    <div id="sidebar-container"></div>
    <div id="header-container"></div>

    <main class="ml-64 p-8" style="margin-top: 88px;">
        <div class="max-w-4xl mx-auto">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-gray-800">설정</h2>
                <p class="text-gray-600 mt-2">계정 및 서비스 설정을 관리하세요</p>
            </div>

            <!-- 탭 네비게이션 -->
            <div class="bg-white rounded-xl shadow mb-6">
                <div class="flex border-b border-gray-200 px-2">
                    <button onclick="switchTab('profile')" id="tab-profile"
                        class="tab-btn active px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-user text-indigo-500"></i> 프로필 & 언어
                    </button>
                    <button onclick="switchTab('tiktok')" id="tab-tiktok"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fab fa-tiktok text-pink-500"></i> TikTok 설정
                    </button>
                    <button onclick="switchTab('youtube')" id="tab-youtube"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fab fa-youtube text-red-500"></i> YouTube 설정
                    </button>
                    <button onclick="switchTab('tts')" id="tab-tts"
                        class="tab-btn px-5 py-4 text-sm text-gray-500 flex items-center gap-2">
                        <i class="fas fa-microphone-alt text-green-500"></i> TTS 설정
                    </button>
                </div>
            </div>

            <!-- 탭 패널들 -->
            <div>
                <!-- 탭 1: 프로필 & 언어 -->
                <div id="panel-profile" class="tab-panel active space-y-6">
                    <!-- 프로필 정보 -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-user mr-2 text-indigo-600"></i>
                        프로필 정보
                    </h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">이메일</label>
                            <input type="email" id="user-email" value="<%= user.email %>" disabled class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">닉네임</label>
                            <input type="text" id="user-nickname" value="<%= user.nickname || '' %>" placeholder="닉네임 입력" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">스트리머 페르소나</label>
                            <textarea id="user-persona" placeholder="예: 친근하고 활발한 게임 스트리머" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"><%= user.streamerPersona || '' %></textarea>
                            <p class="text-xs text-gray-500 mt-1">AI가 당신의 성격을 반영한 답변을 생성합니다</p>
                        </div>
                    </div>
                </div>

                <!-- 언어 설정 -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-language mr-2 text-purple-600"></i>
                        언어 설정
                    </h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">모국어 (AI 발음 코치용)</label>
                            <select id="native-language" disabled class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 cursor-not-allowed">
                                <option value="ko" <%= user.preferredLanguage === 'ko' ? 'selected' : '' %>>🇰🇷 한국어 (Korean)</option>
                                <option value="en" <%= user.preferredLanguage === 'en' ? 'selected' : '' %>>🇺🇸 영어 (English)</option>
                                <option value="ja" <%= user.preferredLanguage === 'ja' ? 'selected' : '' %>>🇯🇵 일본어 (Japanese)</option>
                                <option value="es" <%= user.preferredLanguage === 'es' ? 'selected' : '' %>>🇪🇸 스페인어 (Spanish)</option>
                                <option value="zh" <%= user.preferredLanguage === 'zh' ? 'selected' : '' %>>🇨🇳 중국어 (Chinese)</option>
                                <option value="vi" <%= user.preferredLanguage === 'vi' ? 'selected' : '' %>>🇻🇳 베트남어 (Vietnamese)</option>
                                <option value="th" <%= user.preferredLanguage === 'th' ? 'selected' : '' %>>🇹🇭 태국어 (Thai)</option>
                            </select>
                            <p class="text-xs text-gray-500 mt-2">AI가 이 언어로 발음을 안내합니다</p>
                        </div>
                    </div>
                </div>

                <!-- 저장 버튼 -->
                <div class="flex justify-end">
                    <button onclick="saveProfileSettings()" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
                        <i class="fas fa-save mr-2"></i>저장하기
                    </button>
                </div>
                </div>

                <!-- 탭 2: TikTok 설정 -->
                <div id="panel-tiktok" class="tab-panel space-y-6">
                    <!-- TikTok ID -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                        <i class="fab fa-tiktok mr-2 text-pink-600"></i>
                        TikTok ID
                    </h3>
                    
                    <% if (user.tiktokId) { %>
                    <div id="tiktok-id-display">
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-200">
                            <div class="flex items-center space-x-3">
                                <i class="fab fa-tiktok text-2xl text-pink-600"></i>
                                <div>
                                    <p class="font-semibold text-gray-800">@<%= user.tiktokId %></p>
                                    <p class="text-sm text-gray-500">연결됨</p>
                                </div>
                            </div>
                            <button onclick="showTikTokEdit()" class="text-indigo-600 hover:text-indigo-700 text-sm">
                                <i class="fas fa-edit mr-1"></i>변경
                            </button>
                        </div>
                    </div>
                    
                    <div id="tiktok-edit-form" class="hidden">
                        <div class="flex gap-2">
                            <input type="text" id="tiktok-id-input" value="<%= user.tiktokId %>" placeholder="TikTok ID 입력 (예: aoqrhtm)" class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                            <button onclick="saveTikTokId()" class="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
                                <i class="fas fa-save mr-1"></i>저장
                            </button>
                            <button onclick="cancelTikTokEdit()" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                                취소
                            </button>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">@ 기호 없이 TikTok ID만 입력하세요</p>
                    </div>
                    <% } else { %>
                    <div>
                        <div class="flex gap-2">
                            <input type="text" id="tiktok-id-input" placeholder="TikTok ID 입력 (예: aoqrhtm)" class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                            <button onclick="saveTikTokId()" class="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
                                <i class="fas fa-save mr-1"></i>저장
                            </button>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">@ 기호 없이 TikTok ID만 입력하세요</p>
                    </div>
                    <% } %>
                </div>

                <!-- TikTok 숫자 User ID -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-1 flex items-center">
                        <i class="fas fa-hashtag mr-2 text-pink-500"></i>
                        TikTok 숫자 User ID
                        <span class="ml-2 text-xs bg-pink-100 text-pink-700 px-2 py-0.5 rounded-full">AI 매치코치 팀 판별용</span>
                    </h3>
                    <p class="text-sm text-gray-500 mb-4">AI 매치코치가 내 팀을 정확히 인식하려면 숫자 User ID가 필요합니다. 아래 단계를 따라서 숫자 ID를 찾아 입력하세요.</p>

                    <% if (user.tiktokUserId) { %>
                    <div class="flex items-center gap-2 p-3 bg-green-50 border border-green-200 rounded-lg mb-3">
                        <i class="fas fa-check-circle text-green-500"></i>
                        <span class="text-sm text-green-700 font-medium">숫자 User ID 저장됨: <code class="bg-green-100 px-1 rounded"><%= user.tiktokUserId %></code></span>
                    </div>
                    <% } else { %>
                    <div class="flex items-center gap-2 p-3 bg-yellow-50 border border-yellow-200 rounded-lg mb-3">
                        <i class="fas fa-exclamation-triangle text-yellow-500"></i>
                        <span class="text-sm text-yellow-700">숫자 User ID가 없습니다. 아래 단계를 따라서 찾아 입력하세요.</span>
                    </div>
                    <% } %>

                    <div class="mb-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                        <p class="text-sm font-semibold text-blue-800 mb-3">📋 숫자 ID 찾는 방법 (3단계)</p>
                        <ol class="text-sm text-blue-700 space-y-3 list-decimal list-inside">
                            <li>
                                <strong>TikTok 프로필 페이지 열기</strong><br>
                                <button onclick="openTiktokProfile()" class="mt-1 px-3 py-1 bg-pink-600 text-white rounded text-xs hover:bg-pink-700 transition">
                                    <i class="fas fa-external-link-alt mr-1"></i>페이지 열기
                                </button>
                            </li>
                            <li>
                                <strong>개발자 도구 열기</strong><br>
                                <span class="text-xs text-blue-600">열린 페이지에서 키보드 <kbd class="bg-blue-100 px-1 rounded">F12</kbd> 키 누르기</span>
                            </li>
                            <li>
                                <strong>Console 탭에서 명령어 실행</strong><br>
                                <span class="text-xs text-blue-600">상단에서 <strong>Console</strong> 탭 클릭 → 아래 빈 공간에 아래 코드 복사 후 붙여넣기 → <kbd class="bg-blue-100 px-1 rounded">Enter</kbd></span>
                                <div class="mt-2 p-2 bg-white border border-blue-300 rounded text-xs font-mono break-all">
                                    JSON.parse(document.getElementById('__UNIVERSAL_DATA_FOR_REHYDRATION__')?.textContent||'{}')?.['__DEFAULT_SCOPE__']?.['webapp.user-detail']?.userInfo?.user?.id
                                </div>
                            </li>
                        </ol>
                        <p class="text-xs text-blue-600 mt-3">💡 나오는 숫자(예: 6711215801733907457)를 복사해서 아래 입력창에 붙여넣기</p>
                    </div>

                    <div class="flex gap-2">
                        <input type="text" id="tiktok-user-id-input" value="<%= user.tiktokUserId || '' %>" placeholder="숫자 ID (예: 6711215801733907457)" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 font-mono text-sm">
                        <button onclick="saveTikTokUserId()" class="px-5 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition font-medium text-sm">
                            <i class="fas fa-save mr-1"></i>저장
                        </button>
                    </div>
                    <p id="tiktok-user-id-msg" class="text-xs mt-2 hidden"></p>
                </div>

                <!-- TikTok Session ID -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-1 flex items-center">
                        <i class="fas fa-key mr-2 text-orange-500"></i>
                        TikTok Session ID
                        <span class="ml-2 text-xs bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">연결 안 될 때 필수</span>
                    </h3>
                    <p class="text-sm text-gray-500 mb-4">TikTok이 로그인 인증을 요구할 때 Session ID를 입력하면 연결 오류가 해결됩니다.</p>

                    <div class="mb-4 p-4 bg-orange-50 border border-orange-200 rounded-lg">
                        <p class="text-sm font-semibold text-orange-800 mb-3">📋 Session ID 찾는 방법 (3단계)</p>
                        <ol class="text-sm text-orange-700 space-y-3 list-decimal list-inside">
                            <li>
                                <strong>TikTok 로그인 페이지 열기</strong><br>
                                <button onclick="window.open('https://www.tiktok.com', '_blank', 'width=1200,height=800')" class="mt-1 px-3 py-1 bg-orange-600 text-white rounded text-xs hover:bg-orange-700 transition">
                                    <i class="fas fa-external-link-alt mr-1"></i>페이지 열기
                                </button>
                            </li>
                            <li>
                                <strong>개발자 도구 열기</strong><br>
                                <span class="text-xs text-orange-600">열린 페이지에서 <kbd class="bg-orange-100 px-1 rounded">F12</kbd> → 상단 <strong>Application</strong> 탭 클릭</span>
                            </li>
                            <li>
                                <strong>Session ID 찾기</strong><br>
                                <span class="text-xs text-orange-600">왼쪽 메뉴에서 <strong>Cookies</strong> → <strong>https://www.tiktok.com</strong> 클릭 → <strong>sessionid</strong> 항목 클릭 → 표시된 값 복사</span>
                            </li>
                        </ol>
                    </div>

                    <div class="flex gap-2">
                        <input type="password" id="tiktok-session-id" value="<%= user.tiktokSessionId || '' %>"
                            placeholder="sessionid 값 붙여넣기..."
                            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-400 font-mono text-sm"
                            autocomplete="off" spellcheck="false">
                        <button onclick="toggleSessionIdVisibility()" class="px-3 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition" title="보기/숨기기">
                            <i class="fas fa-eye" id="session-id-eye"></i>
                        </button>
                        <button onclick="saveSessionId()" class="px-5 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition font-medium">
                            <i class="fas fa-save mr-1"></i>저장
                        </button>
                    </div>
                    <p id="session-id-msg" class="text-xs mt-2 hidden"></p>
                </div>
                </div>

                <!-- 탭 3: YouTube 설정 -->
                <div id="panel-youtube" class="tab-panel space-y-6">
                    <!-- YouTube API 키 설정 -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-1 flex items-center">
                        <i class="fab fa-youtube mr-2 text-red-600"></i>
                        YouTube API 키 설정
                        <span class="ml-2 text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full">신청곡 필수</span>
                    </h3>
                    <p class="text-sm text-gray-500 mb-4">신청곡 기능을 안정적으로 사용하려면 본인 API 키를 등록하세요. 아래 안내를 따라 5분이면 완료됩니다!</p>

                    <!-- 현재 상태 -->
                    <% if (user.youtubeApiKey) { %>
                    <div class="flex items-center gap-2 p-3 bg-green-50 border border-green-200 rounded-lg mb-4">
                        <i class="fas fa-check-circle text-green-500"></i>
                        <span class="text-sm text-green-700 font-medium">API 키가 등록되어 있습니다. 신청곡을 제한 없이 사용할 수 있습니다!</span>
                    </div>
                    <% } else { %>
                    <div class="flex items-center gap-2 p-3 bg-yellow-50 border border-yellow-200 rounded-lg mb-4">
                        <i class="fas fa-exclamation-triangle text-yellow-500"></i>
                        <span class="text-sm text-yellow-700">API 키 미등록 상태입니다. 서버 공용 키를 사용 중이며 하루 한도 초과 시 신청곡이 중단될 수 있습니다.</span>
                    </div>
                    <% } %>

                    <!-- API 키 입력 -->
                    <div class="flex gap-2 mb-5">
                        <input type="password" id="youtube-api-key" value="<%= user.youtubeApiKey || '' %>" placeholder="AIzaSy로 시작하는 키를 붙여넣으세요..." class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 font-mono text-sm" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off">
                        <button onclick="toggleYoutubeKeyVisibility()" class="px-3 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition" title="키 보기/숨기기">
                            <i class="fas fa-eye" id="youtube-key-eye"></i>
                        </button>
                        <button onclick="saveYoutubeApiKey()" class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">
                            <i class="fas fa-save mr-1"></i>저장
                        </button>
                    </div>

                    <!-- 단계별 발급 안내 -->
                    <div class="border border-gray-200 rounded-lg overflow-hidden">
                        <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
                            <p class="text-sm font-semibold text-gray-700"><i class="fas fa-list-ol mr-2 text-red-500"></i>API 키 발급 방법 (5분이면 완료!)</p>
                        </div>
                        <div class="p-4 space-y-4">

                            <!-- Step 1 -->
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold">1</div>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">Google Cloud Console 접속</p>
                                    <p class="text-xs text-gray-500 mt-0.5">아래 링크를 클릭해 Google 계정으로 로그인하세요. (Gmail 계정이면 바로 사용 가능)</p>
                                    <a href="https://console.cloud.google.com" target="_blank" class="inline-flex items-center gap-1 mt-1.5 px-3 py-1.5 bg-blue-600 text-white text-xs rounded-lg hover:bg-blue-700 transition">
                                        <i class="fas fa-external-link-alt"></i> Google Cloud Console 열기
                                    </a>
                                </div>
                            </div>

                            <!-- Step 2 -->
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold">2</div>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">새 프로젝트 만들기</p>
                                    <p class="text-xs text-gray-500 mt-0.5">상단 프로젝트 선택 드롭다운 클릭 → <strong>"새 프로젝트"</strong> 클릭 → 프로젝트 이름 아무거나 입력 (예: <code class="bg-gray-100 px-1 rounded">tikfind</code>) → <strong>"만들기"</strong> 클릭</p>
                                </div>
                            </div>

                            <!-- Step 3 -->
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold">3</div>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">YouTube Data API v3 활성화</p>
                                    <p class="text-xs text-gray-500 mt-0.5">왼쪽 메뉴 → <strong>"API 및 서비스"</strong> → <strong>"라이브러리"</strong> → 검색창에 <code class="bg-gray-100 px-1 rounded">YouTube Data API v3</code> 입력 → 클릭 → <strong>"사용 설정"</strong> 버튼 클릭</p>
                                    <a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" class="inline-flex items-center gap-1 mt-1.5 px-3 py-1.5 bg-red-100 text-red-700 text-xs rounded-lg hover:bg-red-200 transition">
                                        <i class="fab fa-youtube"></i> YouTube API 활성화 바로가기
                                    </a>
                                </div>
                            </div>

                            <!-- Step 4 -->
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold">4</div>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">API 키 생성</p>
                                    <p class="text-xs text-gray-500 mt-0.5">왼쪽 메뉴 → <strong>"API 및 서비스"</strong> → <strong>"사용자 인증 정보"</strong> → 상단 <strong>"+ 사용자 인증 정보 만들기"</strong> → <strong>"API 키"</strong> 선택 → 팝업에서 <strong>"만들기"</strong> 클릭</p>
                                    <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="inline-flex items-center gap-1 mt-1.5 px-3 py-1.5 bg-green-100 text-green-700 text-xs rounded-lg hover:bg-green-200 transition">
                                        <i class="fas fa-key"></i> 사용자 인증 정보 바로가기
                                    </a>
                                </div>
                            </div>

                            <!-- Step 5 -->
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold">5</div>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">키 복사 후 위에 붙여넣기</p>
                                    <p class="text-xs text-gray-500 mt-0.5">생성된 <code class="bg-gray-100 px-1 rounded">AIzaSy...</code>로 시작하는 키 옆의 <strong>"복사"</strong> 버튼 클릭 → 위 입력창에 붙여넣기 → <strong>"저장"</strong> 버튼 클릭</p>
                                    <p class="text-xs text-gray-400 mt-1">⏱️ 키 생성 후 사용까지 약 3-5분 소요됩니다</p>
                                    <div class="mt-1.5 p-2 bg-blue-50 border border-blue-100 rounded text-xs text-blue-700">
                                        <i class="fas fa-info-circle mr-1"></i>키를 등록하면 신청곡이 안정적으로 작동합니다. 한도 초과 시 서버 키로 자동 전환됩니다.
                                    </div>
                                </div>
                            </div>

                            <!-- YouTube 프리미어 추천 -->
                            <div class="mt-4 p-3 bg-purple-50 border border-purple-200 rounded-lg">
                                <p class="text-sm font-semibold text-purple-800 mb-1"><i class="fas fa-crown mr-1"></i>YouTube 프리미어 가입 추천</p>
                                <p class="text-xs text-purple-700">API 키를 등록한 구글 아이디로 YouTube 프리미어에 가입하면 방송 중 광고가 자동으로 제거됩니다. 더 깨끗한 방송 환경을 위해 가입을 추천합니다!</p>
                            </div>

                        </div>
                    </div>
                </div>
                </div>

                <!-- 탭 4: TTS 설정 -->
                <div id="panel-tts" class="tab-panel space-y-6">
                    <!-- Google TTS 설정 -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-1 flex items-center">
                        <i class="fas fa-microphone-alt mr-2 text-green-600"></i>
                        Google TTS 설정
                        <span class="ml-2 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">UNIVERSE</span>
                    </h3>
                    <p class="text-sm text-gray-500 mb-4">시청자 아이디별로 다양한 목소리를 자동 배정합니다</p>

                    <!-- Google TTS 활성화 토글 -->
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg mb-4">
                        <div>
                            <p class="font-medium text-gray-800">Google TTS 사용</p>
                            <p class="text-xs text-gray-500">활성화 시 Windows 내장 TTS 대신 Google TTS 사용</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="useGoogleTTS" class="sr-only peer" <%= (user.ttsSettings && user.ttsSettings.useGoogleTTS) ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-600"></div>
                        </label>
                    </div>

                    <!-- 기본 속도 -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">기본 속도</label>
                        <div class="flex items-center gap-3">
                            <input type="range" id="ttsDefaultSpeed" min="0.5" max="2.0" step="0.1"
                                value="<%= (user.ttsSettings && user.ttsSettings.defaultSpeed) ? user.ttsSettings.defaultSpeed : 1.4 %>"
                                class="flex-1" oninput="document.getElementById('ttsSpeedVal').textContent = parseFloat(this.value).toFixed(1) + 'x'">
                            <span id="ttsSpeedVal" class="text-sm font-medium w-10"><%= (user.ttsSettings && user.ttsSettings.defaultSpeed) ? user.ttsSettings.defaultSpeed.toFixed(1) : '1.4' %>x</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">💡 속도 1.4가 방송 진행시 가장 효과적입니다</p>
                    </div>

                    <!-- 전체 볼륨 -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">🔊 전체 목소리 크기</label>
                        <div class="flex items-center gap-3">
                            <input type="range" id="ttsDefaultVolume" min="0" max="100" step="5"
                                value="<%= (user.ttsSettings && user.ttsSettings.defaultVolume != null) ? user.ttsSettings.defaultVolume : 80 %>"
                                class="flex-1" oninput="document.getElementById('ttsVolumeVal').textContent = this.value + '%'">
                            <span id="ttsVolumeVal" class="text-sm font-medium w-12"><%= (user.ttsSettings && user.ttsSettings.defaultVolume != null) ? user.ttsSettings.defaultVolume : 80 %>%</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Desktop App TTS 전체 볼륨 (0% ~ 100%, 기본 80%)</p>
                    </div>

                    <button onclick="saveTTSSettings()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm mb-6">
                        <i class="fas fa-save mr-1"></i>TTS 기본 설정 저장
                    </button>

                    <hr class="mb-6">

                    <!-- VIP 아이디별 목소리 지정 -->
                    <h4 class="font-semibold text-gray-700 mb-3 flex items-center">
                        <i class="fas fa-star mr-2 text-yellow-500"></i>
                        VIP 아이디 목소리 지정 (Chirp 3 HD)
                    </h4>
                    <p class="text-xs text-gray-500 mb-4">지정된 아이디는 고품질 Chirp 3 HD 목소리로 읽힙니다. 나머지는 WaveNet 자동 배정.</p>

                    <!-- 추가 폼 -->
                    <div class="flex gap-2 mb-2">
                        <input type="text" id="vipUniqueId" placeholder="TikTok 아이디 (예: user123)" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500">
                        <input type="text" id="vipNickname" placeholder="닉네임 (예: 단골손님)" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500">
                    </div>
                    <div class="flex gap-2 mb-4">
                        <select id="vipChirpVoice" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500">
                            <option value="">목소리 선택</option>
                        </select>
                        <button onclick="previewVoice()" title="미리 듣기" class="px-3 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition text-sm">
                            <i class="fas fa-play"></i>
                        </button>
                        <input type="number" id="vipSpeed" value="1.4" min="0.5" max="2.0" step="0.1" placeholder="속도" class="w-20 px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        <button onclick="addVoiceSetting()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm">
                            <i class="fas fa-plus mr-1"></i>추가
                        </button>
                    </div>

                    <!-- VIP 목록 -->
                    <div id="voiceSettingsList" class="space-y-2">
                        <p class="text-sm text-gray-400 text-center py-4" id="voiceSettingsEmpty">설정된 VIP 아이디가 없습니다</p>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/i18n.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        function switchTab(name) {
            // 모든 탭 비활성화
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

            // 선택한 탭 활성화
            document.getElementById('tab-' + name).classList.add('active');
            document.getElementById('panel-' + name).classList.add('active');
        }

        async function saveProfileSettings() {
            const nickname = document.getElementById('user-nickname').value.trim();
            const persona = document.getElementById('user-persona').value.trim();

            if (!nickname) { alert('닉네임을 입력하세요.'); return; }

            try {
                const res = await fetch('/api/user/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nickname, streamerPersona: persona })
                });
                const data = await res.json();
                if (data.success) {
                    alert('프로필 설정이 저장되었습니다!');
                    location.reload();
                } else {
                    alert('오류: ' + (data.message || '프로필 설정 저장에 실패했습니다.'));
                }
            } catch(err) {
                alert('서버 오류가 발생했습니다.');
                console.error(err);
            }
        }

        function showTikTokEdit() {
            document.getElementById('tiktok-id-display').classList.add('hidden');
            document.getElementById('tiktok-edit-form').classList.remove('hidden');
        }

        function cancelTikTokEdit() {
            document.getElementById('tiktok-id-display').classList.remove('hidden');
            document.getElementById('tiktok-edit-form').classList.add('hidden');
        }

        function openTiktokProfile() {
            const tiktokId = '<%= user.tiktokId %>';
            if (!tiktokId) {
                alert('먼저 TikTok ID를 저장하세요.');
                return;
            }
            const url = `https://www.tiktok.com/@${tiktokId}`;
            window.open(url, '_blank', 'width=1200,height=800');
        }

        async function saveTikTokUserId() {
            const input = document.getElementById('tiktok-user-id-input');
            const msg = document.getElementById('tiktok-user-id-msg');

            if (!input || !msg) {
                alert('요소를 찾을 수 없습니다. TikTok 설정 탭으로 이동한 후 다시 시도하세요.');
                return;
            }

            const tiktokUserId = input.value.trim();
            if (!tiktokUserId) { alert('숫자 User ID를 입력하세요.'); return; }

            try {
                const res = await fetch('/api/save-tiktok-userid', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tiktokUserId })
                });
                const data = await res.json();
                if (data.success) {
                    msg.textContent = '✅ 저장되었습니다!';
                    msg.className = 'text-xs mt-2 text-green-600';
                    msg.classList.remove('hidden');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('저장 실패: ' + data.message);
                }
            } catch(e) {
                alert('서버 오류가 발생했습니다.');
            }
        }

        function saveTikTokId() {
            const input = document.getElementById('tiktok-id-input');
            if (!input) {
                alert('TikTok ID 입력창을 찾을 수 없습니다. 페이지를 새로고침하세요.');
                return;
            }
            const tiktokId = input.value.trim().replace(/^@+/, '');

            if (!tiktokId) {
                alert('TikTok ID를 입력하세요.');
                return;
            }

            fetch('/api/change-tiktok', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tiktokId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('TikTok ID가 저장되었습니다!');
                    location.reload();
                } else {
                    alert('오류: ' + (data.message || 'TikTok ID 저장에 실패했습니다.'));
                }
            })
            .catch(err => {
                alert('서버 오류가 발생했습니다.');
                console.error(err);
            });
        }

        const USER_ID = '<%= user._id %>';

        async function loadVoices() {
            const res = await fetch('/api/tts/voices');
            const data = await res.json();
            if (data.success) {
                const sel = document.getElementById('vipChirpVoice');
                data.voices.forEach(v => {
                    const opt = document.createElement('option');
                    const genderLabel = v.gender === 'F' ? '(여)' : '(남)';
                    opt.value = v.name;
                    opt.textContent = `${v.name} ${genderLabel}`;
                    sel.appendChild(opt);
                });
            }
        }

        async function loadVoiceSettings() {
            const res = await fetch(`/api/tts/voice-settings/${USER_ID}`);
            const data = await res.json();
            const list = document.getElementById('voiceSettingsList');
            const empty = document.getElementById('voiceSettingsEmpty');
            list.querySelectorAll('.voice-item').forEach(el => el.remove());
            if (data.settings && data.settings.length > 0) {
                empty.classList.add('hidden');
                data.settings.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'voice-item flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200';
                    item.innerHTML = `
                        <div class="flex items-center gap-3">
                            <i class="fas fa-user-circle text-indigo-400"></i>
                            <div>
                                <p class="font-medium text-sm text-gray-800">@${s.tiktokUniqueId}${s.nickname ? ` <span class="text-indigo-500 font-normal">(${s.nickname})</span>` : ''}</p>
                                <p class="text-xs text-gray-500">${s.chirpVoice} · ${s.speed}x 속도</p>
                            </div>
                        </div>`;
                    item.innerHTML += `<div class="flex gap-1">
                            <button onclick="previewVoice('${s.chirpVoice}', ${s.speed})" class="text-green-500 hover:text-green-700 text-sm px-2 py-1" title="미리 듣기">
                                <i class="fas fa-play"></i>
                            </button>
                            <button onclick="deleteVoiceSetting('${s.tiktokUniqueId}')" class="text-red-400 hover:text-red-600 text-sm px-2 py-1" title="삭제">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>`;
                    list.appendChild(item);
                });
            } else {
                empty.classList.remove('hidden');
            }
        }

        async function saveTTSSettings() {
            const useGoogleTTS = document.getElementById('useGoogleTTS').checked;
            const defaultSpeed = parseFloat(document.getElementById('ttsDefaultSpeed').value);
            const defaultVolume = parseInt(document.getElementById('ttsDefaultVolume').value);
            const res = await fetch('/api/tts/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: USER_ID, useGoogleTTS, defaultSpeed, defaultVolume })
            });
            const data = await res.json();
            alert(data.success ? 'TTS 설정이 저장되었습니다!' : '저장 실패: ' + data.message);
        }

        async function addVoiceSetting() {
            const tiktokUniqueId = document.getElementById('vipUniqueId').value.trim().replace('@', '');
            const nickname = document.getElementById('vipNickname').value.trim();
            const chirpVoice = document.getElementById('vipChirpVoice').value;
            const speed = parseFloat(document.getElementById('vipSpeed').value) || 1.0;
            if (!tiktokUniqueId || !chirpVoice) { alert('아이디와 목소리를 모두 입력하세요.'); return; }
            const res = await fetch('/api/tts/voice-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: USER_ID, tiktokUniqueId, nickname, chirpVoice, speed })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('vipUniqueId').value = '';
                document.getElementById('vipNickname').value = '';
                document.getElementById('vipChirpVoice').value = '';
                document.getElementById('vipSpeed').value = '1.0';
                await loadVoiceSettings();
            } else { alert('추가 실패: ' + data.message); }
        }

        async function deleteVoiceSetting(tiktokUniqueId) {
            if (!confirm(`@${tiktokUniqueId} 목소리 설정을 삭제할까요?`)) return;
            await fetch(`/api/tts/voice-settings/${USER_ID}/${tiktokUniqueId}`, { method: 'DELETE' });
            await loadVoiceSettings();
        }

        let previewAudio = null;
        async function previewVoice(voice, speed) {
            const v = voice || document.getElementById('vipChirpVoice').value;
            const s = speed || document.getElementById('vipSpeed').value || 1.0;
            if (!v) { alert('목소리를 먼저 선택하세요.'); return; }

            if (previewAudio) { previewAudio.pause(); previewAudio = null; }

            const url = `/api/tts/preview?voice=${encodeURIComponent(v)}&speed=${s}&text=${encodeURIComponent('안녕하세요! 저는 ' + v + ' 목소리입니다.')}`;
            previewAudio = new Audio(url);
            previewAudio.play().catch(e => alert('미리 듣기 실패: ' + e.message));
        }

        async function saveYoutubeApiKey() {
            const input = document.getElementById('youtube-api-key');
            if (!input) {
                alert('요소를 찾을 수 없습니다. YouTube 설정 탭으로 이동한 후 다시 시도하세요.');
                return;
            }
            const key = input.value.trim();
            const res = await fetch('/api/user/youtube-api-key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: USER_ID, youtubeApiKey: key })
            });
            const data = await res.json();
            if (data.success) {
                alert('YouTube API 키가 저장되었습니다!');
                location.reload();
            } else {
                alert('저장 실패: ' + data.message);
            }
        }

        function toggleYoutubeKeyVisibility() {
            const input = document.getElementById('youtube-api-key');
            const eye = document.getElementById('youtube-key-eye');
            if (!input || !eye) {
                alert('요소를 찾을 수 없습니다. YouTube 설정 탭으로 이동한 후 다시 시도하세요.');
                return;
            }
            if (input.type === 'password') {
                input.type = 'text';
                eye.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                eye.className = 'fas fa-eye';
            }
        }

        function toggleSessionIdVisibility() {
            const input = document.getElementById('tiktok-session-id');
            const eye = document.getElementById('session-id-eye');
            if (!input || !eye) {
                alert('요소를 찾을 수 없습니다. TikTok 설정 탭으로 이동한 후 다시 시도하세요.');
                return;
            }
            if (input.type === 'password') {
                input.type = 'text';
                eye.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                eye.className = 'fas fa-eye';
            }
        }

        async function saveSessionId() {
            const input = document.getElementById('tiktok-session-id');
            const msg = document.getElementById('session-id-msg');

            if (!input || !msg) {
                alert('요소를 찾을 수 없습니다. TikTok 설정 탭으로 이동한 후 다시 시도하세요.');
                return;
            }

            const sessionId = input.value.trim();
            try {
                const res = await fetch('/api/user/tiktok-session-id', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId })
                });
                const data = await res.json();
                msg.classList.remove('hidden', 'text-red-500', 'text-green-600');
                if (data.success) {
                    msg.className = 'text-xs mt-2 text-green-600';
                    msg.textContent = '✅ Session ID가 저장되었습니다. 다음 방송 시작부터 적용됩니다.';
                } else {
                    msg.className = 'text-xs mt-2 text-red-500';
                    msg.textContent = '❌ 저장 실패: ' + (data.message || '');
                }
            } catch(e) {
                msg.className = 'text-xs mt-2 text-red-500';
                msg.textContent = '❌ 오류: ' + e.message;
            }
        }

        loadVoices();
        loadVoiceSettings();

        function saveSettings() {
            const settings = {
                nickname: document.getElementById('user-nickname').value.trim(),
                streamerPersona: document.getElementById('user-persona').value.trim()
            };

            console.log('저장할 설정:', settings);

            fetch('/api/user/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(settings)
            })
            .then(res => {
                console.log('응답 상태:', res.status);
                return res.json();
            })
            .then(data => {
                console.log('응답 데이터:', data);
                if (data.success) {
                    alert('설정이 저장되었습니다!');
                    location.reload();
                } else {
                    alert('오류: ' + (data.message || '설정 저장에 실패했습니다.') + '\n\n상세: ' + (data.error || ''));
                    console.error('오류 상세:', data);
                }
            })
            .catch(err => {
                alert('서버 오류가 발생했습니다: ' + err.message);
                console.error('Fetch 오류:', err);
            });
        }
    </script>

    <!-- Footer -->
    <footer style="margin-left:16rem; background:#0a0a0a; color:white; padding:2.5rem 0 1.5rem; border-top:1px solid rgba(255,255,255,0.08);">
        <div style="max-width:56rem; margin:0 auto; padding:0 2rem;">
            <div style="display:grid; grid-template-columns:2fr 1fr 1fr 2fr; gap:2rem; margin-bottom:1.5rem;">
