{
  "name": "tikfind-desktop",
  "version": "1.3.18",
  "description": "TikFind Desktop Collector - TikTok Live 데이터 수집 앱 (Background Service)",
  "main": "main-background.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "publish:win": "electron-builder --win --publish always"
  },
  "keywords": [
    "tiktok",
    "live",
    "collector",
    "electron"
  ],
  "author": "TikFind",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7",
    "say": "^0.16.0",
    "socket.io-client": "^4.7.2",
    "tiktok-live-connector": "^2.1.1-beta1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.tikfind.desktop",
    "productName": "TikFind",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kim-jongsoung",
      "repo": "tikfind-desktop",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TikFind"
    }
  }
}
