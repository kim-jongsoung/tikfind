<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikFind Moderator Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@600;700;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 110px;
            min-height: 100px;
            background: transparent;
            overflow: visible;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
        }
        body.preview-mode {
            width: 100vw !important;
            min-height: 100vh !important;
            background: #0f172a !important;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding-top: 40px;
        }
        body.preview-mode #mod-list {
            width: 110px;
        }

        #mod-list {
            width: 110px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 4px 0;
        }

        /* 각 모더 카드 */
        .mod-card {
            width: 106px;
            margin: 0 auto;
            border-radius: 14px;
            border: 1.5px solid rgba(255,255,255,0.30);
            background: rgba(0, 0, 0, 0.20);
            overflow: hidden;
            animation: card-in 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards;
        }
        .mod-card.leaving {
            animation: card-out 0.35s ease forwards;
        }
        @keyframes card-in {
            from { opacity:0; transform: scale(0.82) translateY(-8px); }
            to   { opacity:1; transform: scale(1)    translateY(0); }
        }
        @keyframes card-out {
            from { opacity:1; transform: scale(1); }
            to   { opacity:0; transform: scale(0.82) translateY(-6px); }
        }

        /* 상단 뱃지 */
        .mod-badge {
            width: 100%;
            background: rgba(99,102,241,0.75);
            text-align: center;
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.08em;
            padding: 3px 0;
            border-radius: 0;
            transition: background 0.6s ease;
        }
        .mod-badge.inactive {
            background: rgba(220,38,38,0.85);
        }
        /* 재입장/활동 시 배지 반짝임 */
        .mod-badge.flash {
            animation: badge-flash 5s ease forwards;
        }
        @keyframes badge-flash {
            0%   { background: rgba(250,204,21,0.95); transform: scaleY(1.0); }
            10%  { background: rgba(250,204,21,0.95); transform: scaleY(1.25); }
            20%  { background: rgba(99,102,241,0.95); transform: scaleY(1.0); }
            40%  { background: rgba(250,204,21,0.95); transform: scaleY(1.15); }
            60%  { background: rgba(99,102,241,0.95); }
            80%  { background: rgba(250,204,21,0.85); }
            100% { background: rgba(99,102,241,0.75); transform: scaleY(1.0); }
        }

        /* 프로필 영역 */
        .mod-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 8px 6px 9px;
            gap: 5px;
        }

        .mod-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(99,102,241,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 900;
            color: #fff;
            overflow: hidden;
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.6), 0 0 8px rgba(99,102,241,0.4);
        }
        .mod-avatar img {
            width: 100%; height: 100%; object-fit: cover; display: block;
        }

        .mod-name {
            font-size: 14px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            text-shadow: 0 1px 6px rgba(0,0,0,0.9);
            word-break: break-all;
            line-height: 1.3;
            max-width: 100px;
        }

    </style>
</head>
<body>
<div id="mod-list"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const userId = '<%= userId %>';
    const socket = io();

    // 현재 입장한 모더 목록 { uniqueId: { displayName, profileImg, cardEl } }
    const activeMods = new Map();

    // 서버에서 모더 목록 로드
    let modConfig = []; // [{ tiktokUniqueId, displayName, profileImg }]

    async function loadMods() {
        try {
            const res  = await fetch('/api/moderator?userId=' + userId);
            const data = await res.json();
            if (data.success) modConfig = data.moderators;
        } catch(e) {}
    }

    loadMods();
    socket.emit('join-overlay', userId);

    // 소켓: 모더 설정 변경 실시간 반영
    socket.on('moderator-update', () => loadMods());

    // 비활성 타임아웃 (3분 = 180000ms)
    const INACTIVE_MS = 3 * 60 * 1000;

    // 활동 타이머 맵 { uid: timeoutId }
    const activityTimers = new Map();

    function resetActivityTimer(uid) {
        // 기존 타이머 클리어
        if (activityTimers.has(uid)) clearTimeout(activityTimers.get(uid));
        // 배지 활성(파란색)
        const entry = activeMods.get(uid);
        if (entry) {
            const badge = entry.cardEl.querySelector('.mod-badge');
            if (badge) badge.classList.remove('inactive');
        }
        // 3분 후 비활성(빨간색)
        const t = setTimeout(() => {
            const e = activeMods.get(uid);
            if (e) {
                const b = e.cardEl.querySelector('.mod-badge');
                if (b) b.classList.add('inactive');
            }
        }, INACTIVE_MS);
        activityTimers.set(uid, t);
    }

    // 소켓: 모더 입장 이벤트
    socket.on('overlay-moderator-join', (data) => {
        const uid = (data.uniqueId || '').trim().toLowerCase();
        if (!uid) return;
        if (activeMods.has(uid)) {
            // 재입장: 카드를 맨 위로 이동 + 배지 flash
            const entry = activeMods.get(uid);
            const list  = document.getElementById('mod-list');
            list.prepend(entry.cardEl);
            const badge = entry.cardEl.querySelector('.mod-badge');
            if (badge) {
                badge.classList.remove('flash', 'inactive');
                void badge.offsetWidth; // reflow
                badge.classList.add('flash');
            }
            resetActivityTimer(uid);
            return;
        }
        addModCard(uid, {
            displayName: data.displayName,
            profileImg:  data.profileImg || ''
        });
        resetActivityTimer(uid);
    });

    // 소켓: 모더 활동 이벤트 (채팅/선물/좋아요)
    socket.on('overlay-moderator-activity', (data) => {
        const uid = (data.uniqueId || '').trim().toLowerCase();
        if (!uid) return;
        if (!activeMods.has(uid)) {
            // 카드 없으면 자동 추가 (방송 중 입장한 모더 대응)
            addModCard(uid, {
                displayName: data.displayName,
                profileImg:  data.profileImg || ''
            });
        }
        resetActivityTimer(uid);
    });

    // 소켓: 라이브 종료 시 전체 클리어
    socket.on('live-ended', () => {
        activeMods.forEach((v, k) => removeModCard(k));
    });

    function addModCard(uid, mod) {
        const list = document.getElementById('mod-list');

        const card = document.createElement('div');
        card.className = 'mod-card';
        card.id = 'mod-' + uid;

        const name    = mod.displayName || uid;
        const rawImg  = mod.profileImg || '';
        // URL이면 img 태그, 아니면(이모지 등) 텍스트로 표시
        const isUrl   = rawImg.startsWith('http');
        const initial = name.charAt(0).toUpperCase();
        const avatarContent = isUrl
            ? `<img src="${escHtml(rawImg)}" onerror="this.parentNode.textContent='${escHtml(initial)}'">`
            : (rawImg ? escHtml(rawImg) : escHtml(initial));

        card.innerHTML = `
            <div class="mod-badge">with 모더</div>
            <div class="mod-body">
                <div class="mod-avatar" id="av-${uid}">${avatarContent}</div>
                <div class="mod-name">${escHtml(name)}</div>
            </div>
        `;

        list.appendChild(card);
        activeMods.set(uid, { mod, cardEl: card });
    }

    function removeModCard(uid) {
        const entry = activeMods.get(uid);
        if (!entry) return;
        const card = entry.cardEl;
        card.classList.add('leaving');
        card.addEventListener('animationend', () => {
            card.remove();
            activeMods.delete(uid);
        }, { once: true });
    }

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── 테스트 모드 ──
    const testParam = new URLSearchParams(location.search).get('test');
    if (testParam === '1' || testParam === 'true') {
        document.body.classList.add('preview-mode');

        // 상단 레이블
        const label = document.createElement('div');
        label.textContent = '🛡️ 모더 위젯 미리보기 모드';
        label.style.cssText = 'position:fixed;top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.6);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:12px;font-weight:700;padding:5px 16px;border-radius:50px;z-index:9999;pointer-events:none;white-space:nowrap;';
        document.body.appendChild(label);

        // 더미 모더 3명 표시
        const dummies = [
            { uniqueId:'mod_test1', displayName:'김민지', profileImg:'👑' },
            { uniqueId:'mod_test2', displayName:'이서연', profileImg:'💎' },
            { uniqueId:'mod_test3', displayName:'박하은',  profileImg:'🏆' },
        ];
        dummies.forEach((d, i) => {
            setTimeout(() => addModCard(d.uniqueId, d), i * 400);
        });

        // 재생 버튼
        const btn = document.createElement('div');
        btn.innerHTML = '🔄 다시 보기';
        btn.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(59,130,246,0.95);color:#fff;font-family:"Noto Sans KR",sans-serif;font-size:14px;font-weight:700;padding:12px 32px;border-radius:50px;cursor:pointer;z-index:9999;box-shadow:0 4px 24px rgba(0,0,0,0.4);white-space:nowrap;user-select:none;';
        document.body.appendChild(btn);
        btn.addEventListener('click', () => {
            // 기존 카드 제거 후 재표시
            activeMods.forEach((v, k) => removeModCard(k));
            setTimeout(() => {
                dummies.forEach((d, i) => {
                    setTimeout(() => addModCard(d.uniqueId, d), i * 400);
                });
            }, 400);
        });
    }
</script>
</body>
</html>
